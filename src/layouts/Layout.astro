---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../i18n/translations";
import { loadSiteSettings } from "../sanity/siteSettings";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	canonicalUrl?: string;
	ogImageUrl?: string;
	ogImageAlt?: string;
	noIndex?: boolean;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
	overlayHeader?: boolean;
	footerTone?: "dark" | "light";
	locale?: Locale;
}

const {
	locale = "lv",
	title,
	description,
	canonicalPath,
	canonicalUrl,
	ogImageUrl,
	ogImageAlt,
	noIndex,
	structuredData,
	overlayHeader = false,
	footerTone = "light"
} = Astro.props;
const siteSettings = await loadSiteSettings();

if (!siteSettings) {
	throw new Error("Site Settings content is missing in Sanity.");
}

const defaultSeo = siteSettings?.defaultSeo;
const siteTitle = siteSettings.siteTitle ?? "";
const sourceTitle = title ?? defaultSeo?.metaTitle ?? siteTitle;
const pageTitle = sourceTitle.replace(/Amberinvest/gi, siteTitle);
const metaDescription = description || defaultSeo?.metaDescription;
const ogImage = {
	url: ogImageUrl || defaultSeo?.ogImage?.url,
	alt: ogImageAlt || defaultSeo?.ogImage?.alt
};
const shouldNoIndex = noIndex ?? defaultSeo?.noIndex === true;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL ?? "https://amberhome.lv").replace(/\/+$/, "");
const pageCanonicalUrl = canonicalUrl ?? new URL(canonicalPath ?? Astro.url.pathname, `${siteUrl}/`).toString();
const organizationStructuredData = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: siteTitle || "AmberHome",
	url: siteUrl,
	logo: siteSettings.logo?.url,
	email: siteSettings.contactEmail,
	telephone: siteSettings.phone,
	address: siteSettings.address
		? {
				"@type": "PostalAddress",
				streetAddress: siteSettings.address
			}
		: undefined,
	sameAs: siteSettings.socialLinks.map((link) => link.url)
};
const pageStructuredData = Array.isArray(structuredData)
	? structuredData
	: structuredData
		? [structuredData]
		: [];
const structuredDataItems = [organizationStructuredData, ...pageStructuredData];
const serializeStructuredData = (data: Record<string, unknown>) =>
	JSON.stringify(data).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('js-motion');
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{metaDescription ? <meta name="description" content={metaDescription} /> : null}
		<link rel="canonical" href={pageCanonicalUrl} />
		{shouldNoIndex ? <meta name="robots" content="noindex,nofollow" /> : null}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageCanonicalUrl} />
		{metaDescription ? <meta property="og:description" content={metaDescription} /> : null}
		{ogImage?.url ? <meta property="og:image" content={ogImage.url} /> : null}
		{ogImage?.alt ? <meta property="og:image:alt" content={ogImage.alt} /> : null}
		<meta name="twitter:card" content={ogImage?.url ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={pageTitle} />
		{metaDescription ? <meta name="twitter:description" content={metaDescription} /> : null}
		{ogImage?.url ? <meta name="twitter:image" content={ogImage.url} /> : null}
		{structuredDataItems.map((item) => <script type="application/ld+json" set:html={serializeStructuredData(item)} />)}
	</head>
	<body>
		<Header overlay={overlayHeader} locale={locale} siteSettings={siteSettings} />
		<slot />
		<Footer siteSettings={siteSettings} tone={footerTone} />
		<script is:inline>
			const revealElements = Array.from(document.querySelectorAll('.fade-in'));

			revealElements.forEach((element) => {
				const delay = element.getAttribute('data-reveal-delay');
				if (delay) {
					element.style.setProperty('--fade-in-delay', `${delay}ms`);
				}
			});

			if (!revealElements.length || !document.documentElement.classList.contains('js-motion')) {
				revealElements.forEach((element) => element.classList.add('is-visible'));
			} else if (!('IntersectionObserver' in window)) {
				revealElements.forEach((element) => element.classList.add('is-visible'));
			} else {
				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						rootMargin: '0px 0px -10% 0px',
						threshold: 0.12
					}
				);

				revealElements.forEach((element) => revealObserver.observe(element));
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		width: 100%;
		min-height: 100%;
	}
</style>
