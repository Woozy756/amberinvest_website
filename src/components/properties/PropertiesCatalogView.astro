---
import PropertyCard from "./PropertyCard.astro";
import {
	getPropertyCategoryHrefForLocale,
	getPropertyCategoryLabel,
	type Property,
	type PropertyCategory
} from "../../sanity/properties";
import type { Locale } from "../../i18n/translations";

interface Props {
	title: string;
	lead: string;
	properties: Property[];
	categories: PropertyCategory[];
	activeCategory?: string | "all";
	locale?: Locale;
}

const { title, lead, properties, categories, activeCategory = "all", locale = "lv" } = Astro.props as Props;
const isEnglish = locale === "en";
const catalogHref = isEnglish ? "/en/apartments" : "/dzīvokļi";
const catalogTotalCount = categories.reduce((sum, category) => sum + category.propertyCount, 0);

const sortedProperties = [...properties].sort((a, b) => a.price - b.price);
const areas = properties.map((property) => property.area).filter((area) => area > 0);
const areaRange = areas.length > 0
	? `${Math.min(...areas).toLocaleString(isEnglish ? "en-GB" : "lv-LV", { maximumFractionDigits: 2 })}–${Math.max(...areas).toLocaleString(isEnglish ? "en-GB" : "lv-LV", { maximumFractionDigits: 2 })} m²`
	: null;
const categoryAccusative = ({
	"3-rooms": "trīsistabu dzīvokļus",
	"4-rooms": "četristabu dzīvokļus",
	"5-rooms": "piecistabu dzīvokļus"
} as Record<string, string>)[activeCategory] ?? "dzīvokļus";
---

<main class="properties-catalog">
	<section class="properties-catalog__hero">
		<div class="properties-catalog__container">
			<header class="properties-catalog__header">
				<h1 class="properties-catalog__title fade-in" data-reveal-delay="50">{title}</h1>
				<p class="properties-catalog__lead fade-in" data-reveal-delay="110">{lead}</p>
			</header>
		</div>
	</section>

	<section class="properties-catalog__listing">
		<div class="properties-catalog__container">
			<div class="properties-catalog__controls fade-in" data-reveal-delay="120">
				<nav class="properties-filters" aria-label={isEnglish ? "Apartment categories" : "Dzīvokļu kategorijas"}>
					<a href={catalogHref} aria-current={activeCategory === "all" ? "page" : undefined}>
						<span>{isEnglish ? "All apartments" : "Visi dzīvokļi"}</span>
						<strong>{catalogTotalCount}</strong>
					</a>
					{
						categories.map((category) => (
							<a
								href={getPropertyCategoryHrefForLocale(category, locale)}
								aria-current={activeCategory === category.slug ? "page" : undefined}
							>
								<span>{getPropertyCategoryLabel(category, locale, true)}</span>
								<strong>{category.propertyCount}</strong>
							</a>
						))
					}
				</nav>
			</div>

			{
				sortedProperties.length > 0 ? (
					<ul class="properties-grid" role="list">
						{
							sortedProperties.map((property, index) => (
								<li>
									<PropertyCard property={property} index={index} locale={locale} />
								</li>
							))
						}
					</ul>
				) : (
					<div class="properties-empty fade-in" data-reveal-delay="140">
						<p class="properties-empty__eyebrow">{isEnglish ? "Listings are being updated" : "Atlase tiek atjaunota"}</p>
						<h2>{isEnglish ? "There are currently no published apartments in this category." : "Šobrīd šajā kategorijā nav publicētu dzīvokļu."}</h2>
						<p>{isEnglish ? "Browse the full catalogue or contact us for the latest availability." : "Pārskatiet visu katalogu vai sazinieties ar mums, lai saņemtu jaunākos piedāvājumus."}</p>
						<a href={catalogHref}>{isEnglish ? "View full catalogue" : "Skatīt visu katalogu"}</a>
					</div>
				)
			}
		</div>
	</section>

	<section class="properties-catalog__context" aria-labelledby="catalog-context-title">
		<div class="properties-catalog__container">
			<h2 id="catalog-context-title">{isEnglish ? "Apartments at Talsu Street 3A" : "Dzīvokļi Talsu ielā 3A"}</h2>
			<p>
				{isEnglish
					? `Compare ${activeCategory === "all" ? "apartments" : title.toLowerCase()} in Ventspils${areaRange ? ` with floor areas of ${areaRange}` : ""}. Each listing includes an apartment plan and its position in the building.`
					: `Salīdzini ${categoryAccusative} Ventspilī${areaRange ? ` ar platību ${areaRange}` : ""}. Pie katra dzīvokļa vari apskatīt plānojumu un tā novietojumu ēkā.`}
			</p>
			<p>
				<a href={isEnglish ? "/en/about-the-building" : "/par-eku"}>{isEnglish ? "Learn about the building" : "Uzzini vairāk par ēku"}</a>
				<span aria-hidden="true"> · </span>
				<a href={isEnglish ? "/en/how-to-buy" : "/kā-iegādāties"}>{isEnglish ? "How to buy" : "Kā iegādāties dzīvokli"}</a>
			</p>
		</div>
	</section>
</main>

<style>
	.properties-catalog {
		padding-top: clamp(7rem, 9vw, 9rem);
		background:
			radial-gradient(circle at top left, rgba(199, 150, 67, 0.08), transparent 30%),
			linear-gradient(180deg, #f7f4ed 0%, var(--surface-light) 38%, #efe9dd 100%);
		color: var(--bg-primary);
	}

	.properties-catalog__container {
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding-inline: var(--page-gutter);
	}

	.properties-catalog__context {
		padding: clamp(2rem, 5vw, 4rem) 0;
	}

	.properties-catalog__context .properties-catalog__container {
		max-width: 55rem;
	}

	.properties-catalog__context h2 {
		margin: 0 0 0.85rem;
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.4vw, 2rem);
	}

	.properties-catalog__context p {
		margin: 0 0 0.9rem;
		line-height: 1.7;
	}

	.properties-catalog__context a {
		color: #865d23;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.properties-catalog__hero {
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}

	.properties-catalog__header {
		display: grid;
		gap: 0.85rem;
		max-width: 46rem;
	}

	.properties-empty__eyebrow {
		margin: 0;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.properties-empty__eyebrow {
		color: var(--accent-primary);
	}

	.properties-catalog__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.2vw, 3.2rem);
		line-height: 1.08;
		letter-spacing: -0.022em;
		max-width: 16ch;
		text-wrap: balance;
	}

	.properties-catalog__lead {
		margin: 0;
		max-width: 60ch;
		font-size: clamp(0.97rem, 1.2vw, 1.06rem);
		line-height: var(--copy-line-height);
		color: rgba(15, 17, 21, 0.64);
	}

	.properties-catalog__listing {
		padding-bottom: var(--section-space);
	}

	.properties-catalog__controls {
		margin-bottom: clamp(1.8rem, 3vw, 2.6rem);
		padding: 0.95rem 0 0.4rem;
	}

	.properties-filters {
		position: relative;
		display: inline-flex;
		flex-wrap: nowrap;
		gap: clamp(1rem, 1.8vw, 1.6rem);
		width: fit-content;
		max-width: 100%;
		margin: 0;
		padding-bottom: 0rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.properties-filters::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 3px;
		height: 1px;
		background: rgba(35, 38, 43, 0.24);
		z-index: 1;
	}

	.properties-filters::-webkit-scrollbar {
		display: none;
	}

	.properties-filters a {
		position: relative;
		z-index: 1;
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0 0.75rem;
		border: 0;
		background: transparent;
		color: rgba(15, 17, 21, 0.5);
		text-decoration: none;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition: color 0.3s var(--ease-premium);
	}

	.properties-filters a::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 2px;
		height: 3px;
		background: var(--accent-primary);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 0.38s var(--ease-premium);
		z-index: 2;
	}

	.properties-filters a strong {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.55rem;
		height: 1.55rem;
		border-radius: 999px;
		background: rgba(15, 17, 21, 0.08);
		border: 0;
		font-size: 0.72rem;
		font-weight: 700;
		color: rgba(15, 17, 21, 0.7);
		letter-spacing: 0;
	}

	.properties-filters a[aria-current="page"] {
		color: var(--bg-primary);
	}

	.properties-filters a[aria-current="page"]::after {
		transform: scaleX(1);
	}

	.properties-filters a[aria-current="page"] strong {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: var(--bg-primary);
	}

	.properties-filters a:hover,
	.properties-filters a:focus-visible {
		color: var(--bg-primary);
		outline: none;
	}

	.properties-filters a:hover strong,
	.properties-filters a:focus-visible strong {
		background: var(--accent-primary);
		color: var(--bg-primary);
	}

	.properties-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.2rem, 2vw, 1.7rem);
	}

	.properties-grid li {
		min-width: 0;
	}

	.properties-empty {
		display: grid;
		gap: 1rem;
		max-width: 42rem;
		padding: clamp(1.8rem, 4vw, 2.8rem);
		border: 1px solid rgba(35, 38, 43, 0.12);
		background: rgba(255, 255, 255, 0.66);
	}

	.properties-empty h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.7rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
	}

	.properties-empty p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.7;
		color: rgba(15, 17, 21, 0.62);
	}

	.properties-empty a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		min-height: 2.9rem;
		padding: 0.55rem 1.05rem;
		background: var(--accent-primary);
		color: var(--bg-primary);
		text-decoration: none;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		transition:
			background-color 180ms var(--ease-premium),
			transform 180ms var(--ease-premium);
	}

	.properties-empty a:hover,
	.properties-empty a:focus-visible {
		background: var(--accent-hover);
		transform: translateY(-2px);
		outline: none;
	}

	@media (max-width: 980px) {
		.properties-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.properties-catalog {
			padding-top: calc(5.5rem + 1.5rem);
		}

		.properties-catalog__hero {
			padding-bottom: 1.15rem;
		}

		.properties-catalog__header {
			gap: 0.65rem;
		}

		.properties-catalog__title {
			font-size: clamp(1.95rem, 8vw, 2.45rem);
			line-height: 1.08;
		}

		.properties-catalog__lead {
			font-size: 0.96rem;
			line-height: 1.62;
		}

		.properties-catalog__controls {
			margin-bottom: 1.25rem;
			padding-top: 0.45rem;
		}

		.properties-grid {
			grid-template-columns: 1fr;
		}

		.properties-filters {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.65rem 1rem;
			width: 100%;
			overflow: visible;
		}

		.properties-filters::after {
			display: none;
		}

		.properties-filters a {
			justify-content: space-between;
			min-width: 0;
			padding-bottom: 0.65rem;
			border-bottom: 1px solid rgba(35, 38, 43, 0.18);
			font-size: 0.7rem;
			letter-spacing: 0.09em;
		}

		.properties-utility__results {
			flex-wrap: wrap;
		}
	}
</style>
