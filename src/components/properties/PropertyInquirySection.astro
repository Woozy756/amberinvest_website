---
import ContactForm from "../home/ContactForm.jsx";
import { getLocalizedPropertyTitle, getPropertyHref, type Property } from "../../sanity/properties";
import { loadSiteSettings } from "../../sanity/siteSettings";
import { toPhoneHref } from "../../lib/formatting";
import type { Locale } from "../../i18n/translations";

interface Props {
	property: Property;
	locale?: Locale;
}

const { property, locale = "lv" } = Astro.props as Props;
const isEnglish = locale === "en";
const localizedTitle = getLocalizedPropertyTitle(property, locale);
const siteSettings = await loadSiteSettings();
const inquiryPhone = siteSettings?.phone?.trim();
const inquiryPhoneHref = toPhoneHref(inquiryPhone);
const inquiryEmail = siteSettings?.contactEmail?.trim();
const propertyHref = getPropertyHref(property, locale);
---

<section class="property-inquiry" id="property-inquiry" aria-labelledby="property-inquiry-title">
	<div class="property-inquiry__container">
		<div class="property-inquiry__layout">
			<div class="property-inquiry__content">
				<p class="property-inquiry__eyebrow fade-in">{isEnglish ? "Get in touch" : "Piesakieties"}</p>
				<h2 id="property-inquiry-title" class="property-inquiry__title fade-in" data-reveal-delay="60">
					{isEnglish ? "Leave your contact details" : "Atstāj savus kontaktus"}
				</h2>
				<p class="property-inquiry__lead fade-in" data-reveal-delay="120">
					{isEnglish ? "Leave your contact details and we will arrange a viewing of " : "Atstāj savu kontaktinformāciju, un mēs sazināsimies, lai vienotos par "}<strong>{localizedTitle}</strong>{isEnglish ? " at a convenient time." : " apskati Tev ērtā laikā."}
				</p>

				<ul class="property-inquiry__benefits" role="list">
					<li class="property-inquiry__benefit fade-in" data-reveal-delay="180">
						<img src="/check-mark.svg" alt="" loading="lazy" width="14" height="14" />
						<span>{isEnglish ? "Apartment viewing with our specialist" : "Dzīvokļu apskate ar mūsu speciālistu"}</span>
					</li>
					<li class="property-inquiry__benefit fade-in" data-reveal-delay="230">
						<img src="/check-mark.svg" alt="" loading="lazy" width="14" height="14" />
						<span>{isEnglish ? "We will respond within 24 hours" : "Atbildēsim uz Tavu pieteikumu 24 stundu laikā"}</span>
					</li>
					<li class="property-inquiry__benefit fade-in" data-reveal-delay="280">
						<img src="/check-mark.svg" alt="" loading="lazy" width="14" height="14" />
						<span>{isEnglish ? "We handle your personal data with care." : "Mēs rūpējamies par Tavu datu drošību."}</span>
					</li>
				</ul>

				{inquiryPhone || inquiryEmail ? (
					<div class="property-inquiry__contacts fade-in" data-reveal-delay="320">
						{inquiryPhone && inquiryPhoneHref ? <a href={inquiryPhoneHref}>{inquiryPhone}</a> : null}
						{inquiryEmail ? <a href={`mailto:${inquiryEmail}`}>{inquiryEmail}</a> : null}
					</div>
				) : null}
			</div>

			<div class="property-inquiry__form-wrap">
				<div class="property-inquiry__card contact-form-card">
					<ContactForm
						client:load
						locale={locale}
						title={isEnglish ? "Leave your contact details" : "Atstāj savus kontaktus"}
						intro=""
						defaultInformation={isEnglish ? "I would like to book a viewing." : "Apskate"}
						sourceProject={property.project?.title}
						sourceProperty={localizedTitle}
						sourcePropertyCode={property.propertyCode}
						sourceUrl={propertyHref}
						submitLabel={isEnglish ? "Book a viewing" : "Pieteikties apskatei"}
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	.property-inquiry {
		position: relative;
		overflow: clip;
		background:
			radial-gradient(circle at top left, rgba(199, 150, 67, 0.16), transparent 34%),
			linear-gradient(180deg, #0f1115 0%, #131821 100%);
		color: var(--surface-light);
		padding: var(--section-space) 0;
	}

	.property-inquiry::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(199, 150, 67, 0.08) 0%, transparent 20%),
			repeating-linear-gradient(
				90deg,
				rgba(138, 144, 152, 0.04) 0,
				rgba(138, 144, 152, 0.04) 1px,
				transparent 1px,
				transparent 120px
			);
		opacity: 0.42;
		pointer-events: none;
	}

	.property-inquiry__container {
		position: relative;
		z-index: 1;
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding-inline: var(--page-gutter);
	}

	.property-inquiry__layout {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 0.92fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}

	.property-inquiry__content {
		max-width: 34rem;
	}

	.property-inquiry__eyebrow {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-primary);
	}

	.property-inquiry__title {
		margin: 1rem 0 0;
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.025em;
		max-width: 13ch;
		text-wrap: balance;
	}

	.property-inquiry__lead {
		margin: 1.2rem 0 0;
		max-width: 43ch;
		font-size: clamp(1rem, 1.3vw, 1.08rem);
		line-height: var(--copy-line-height);
		color: rgba(245, 243, 238, 0.74);
	}

	.property-inquiry__lead strong {
		color: var(--surface-light);
		font-weight: 700;
	}

	.property-inquiry__benefits {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.9rem;
	}

	.property-inquiry__benefit {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgba(245, 243, 238, 0.92);
	}

	.property-inquiry__benefit img {
		flex: 0 0 auto;
		width: 0.95rem;
		height: 0.95rem;
		object-fit: contain;
	}

	.property-inquiry__contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.4rem;
		margin-top: 2rem;
		padding-top: 1.35rem;
		border-top: 1px solid rgba(245, 243, 238, 0.12);
	}

	.property-inquiry__contacts a {
		color: var(--surface-light);
		text-decoration: none;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.property-inquiry__contacts a:hover,
	.property-inquiry__contacts a:focus-visible {
		color: var(--accent-primary);
		outline: none;
	}

	@media (max-width: 840px) {
		.property-inquiry__layout {
			grid-template-columns: 1fr;
		}
	}
</style>
