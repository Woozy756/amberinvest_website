---
import {
	getLocalizedPropertyTitle,
	getPropertyHref,
	propertyStatusMeta,
	type Property
} from "../../sanity/properties";
import { formatCurrency } from "../../lib/formatting";
import type { Locale } from "../../i18n/translations";

interface Props {
	property: Property;
	ctaHref?: string;
	ctaLabel?: string;
	showPrice?: boolean;
	index?: number;
	locale?: Locale;
}

const { property, ctaHref, ctaLabel, showPrice = true, index = 0, locale = "lv" } = Astro.props as Props;
const isEnglish = locale === "en";
const localizedTitle = getLocalizedPropertyTitle(property, locale);
const localizedCtaLabel = ctaLabel || (isEnglish ? "View details" : "Skatīt detaļas");
const status = {
	...propertyStatusMeta[property.status],
	label: isEnglish
		? { available: "Available", reserved: "Reserved", sold: "Sold" }[property.status]
		: propertyStatusMeta[property.status].label
};
const priceLabel = formatCurrency(property.price, property.currency);
const propertyHref = getPropertyHref(property, locale);
const cardCtaHref = ctaHref || propertyHref;
const locationLabel = property.project?.city || (isEnglish ? "Apartment" : "Dzīvoklis");
const imageLoading = index < 2 ? "eager" : "lazy";
const imageFetchPriority = index < 2 ? "high" : "auto";
---

<article class="property-card fade-in" data-reveal-delay={String(80 + index * 45)}>
	<a class="property-card__media" href={propertyHref} aria-label={isEnglish ? `View details for ${localizedTitle}` : `Skatīt ${property.title} detaļas`}>
		<img
			src={property.image}
			alt={localizedTitle}
			loading={imageLoading}
			fetchpriority={imageFetchPriority}
			decoding="async"
			width="1400"
			height="1040"
		/>
		<span class="property-card__status" data-tone={status.tone}>{status.label}</span>
	</a>

	<div class="property-card__body">
		<p class="property-card__location" aria-label={isEnglish ? "Property location" : "Objekta atrašanās vieta"}>
			<svg class="property-card__location-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path
					d="M12 2.5c-3.86 0-7 3.14-7 7 0 4.8 5.69 11.1 6.33 11.8a.9.9 0 0 0 1.34 0C13.31 20.6 19 14.3 19 9.5c0-3.86-3.14-7-7-7Zm0 9.5a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
					fill="currentColor"
				/>
			</svg>
			<span>{locationLabel}</span>
		</p>
			<h2 class="property-card__title">
				<a href={propertyHref}>{localizedTitle}</a>
			</h2>
			<div class="property-card__spacer" aria-hidden="true"></div>

		<div class="property-card__meta">
			<dl class="property-card__details" aria-label={isEnglish ? `${localizedTitle} key details` : `${property.title} pamatinformācija`}>
				<div>
					<dt>{isEnglish ? "Rooms" : "Istabas"}</dt>
					<dd>{property.rooms}</dd>
				</div>
				<div>
					<dt>{isEnglish ? "Area" : "Platība"}</dt>
					<dd>{property.area.toFixed(1)} m²</dd>
				</div>
				<div>
					<dt>{isEnglish ? "Floor" : "Stāvs"}</dt>
					<dd>{isEnglish ? property.floor : `${property.floor}.`}</dd>
				</div>
			</dl>

			<div class="property-card__footer" data-has-price={showPrice ? "true" : "false"}>
				{showPrice ? <p class="property-card__price">{priceLabel}</p> : null}
				<a class="property-card__cta" href={cardCtaHref}>{localizedCtaLabel}</a>
			</div>
		</div>
	</div>
</article>

<style>
	.property-card {
		height: 100%;
		display: grid;
		grid-template-rows: auto 1fr;
		border: 1px solid rgba(35, 38, 43, 0.14);
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(14px);
		overflow: clip;
		transition:
			transform 0.45s var(--ease-premium),
			border-color 0.45s var(--ease-premium),
			box-shadow 0.45s var(--ease-premium);
	}

	.property-card:hover,
	.property-card:focus-within {
		transform: translateY(-4px);
		border-color: rgba(199, 150, 67, 0.34);
		box-shadow: 0 18px 40px rgba(15, 17, 21, 0.08);
	}

	.property-card__media {
		position: relative;
		display: block;
		aspect-ratio: 1.14;
		overflow: hidden;
		background: rgba(15, 17, 21, 0.08);
	}

	.property-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1.2s var(--ease-premium);
	}

	.property-card:hover .property-card__media img,
	.property-card:focus-within .property-card__media img {
		transform: scale(1.035);
	}

	.property-card__status {
		position: absolute;
		top: 1rem;
		left: 1rem;
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid transparent;
		background: rgba(245, 243, 238, 0.92);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.property-card__status[data-tone="available"] {
		border-color: rgba(80, 129, 96, 0.2);
		color: #3f6d4b;
	}

	.property-card__status[data-tone="reserved"] {
		border-color: rgba(199, 150, 67, 0.22);
		color: #966f29;
	}

	.property-card__status[data-tone="sold"] {
		border-color: rgba(118, 124, 134, 0.2);
		color: #5c6169;
	}

		.property-card__body {
			display: grid;
			grid-template-rows: auto auto minmax(0, 1fr) auto;
			flex: 1 1 auto;
			min-height: 0;
			gap: 1rem;
		padding: 1.3rem 1.3rem 1.4rem;
	}

	.property-card__spacer {
		min-height: 0;
	}

	.property-card__meta {
		display: grid;
		gap: 1rem;
	}

	.property-card__location {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-primary);
		line-height: 1.2;
		max-width: 100%;
		min-width: 0;
	}

	.property-card__location span {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.property-card__location-icon {
		width: 0.8rem;
		height: 0.8rem;
		min-width: 0.8rem;
		min-height: 0.8rem;
		max-width: 0.8rem;
		max-height: 0.8rem;
		color: var(--accent-primary);
		flex: 0 0 auto;
		display: block;
	}

	.property-card__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.55rem, 2vw, 1.85rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.property-card__title a {
		color: var(--bg-primary);
		text-decoration: none;
	}

	.property-card__title a:hover,
	.property-card__title a:focus-visible {
		color: var(--accent-primary);
		outline: none;
	}

		.property-card__details {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding-top: 1rem;
		border-top: 1px solid rgba(35, 38, 43, 0.1);
	}

	.property-card__details dt {
		margin: 0;
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(15, 17, 21, 0.45);
	}

	.property-card__details dd {
		margin: 0.35rem 0 0;
		font-size: 1rem;
		line-height: 1.4;
		color: var(--bg-primary);
	}

	.property-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(35, 38, 43, 0.1);
	}

	.property-card__price {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.6rem, 2.1vw, 2rem);
		line-height: 1;
		letter-spacing: -0.025em;
		color: var(--bg-primary);
	}

	.property-card__footer[data-has-price="false"] {
		justify-content: stretch;
	}

	.property-card__footer[data-has-price="false"] .property-card__cta {
		width: 100%;
	}

	.property-card__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.05rem;
		padding: 0.65rem 1.15rem;
		background: var(--accent-primary);
		color: var(--bg-primary);
		text-decoration: none;
		font-size: 0.7rem;
		font-weight: 900;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		transition:
			background-color 180ms var(--ease-premium),
			transform 180ms var(--ease-premium);
	}

	.property-card__cta:hover,
	.property-card__cta:focus-visible {
		background: var(--accent-hover);
		transform: translateY(-2px);
		outline: none;
	}

	@media (max-width: 720px) {
		.property-card__body {
			padding-inline: 1.1rem;
		}

		.property-card__location {
			font-size: 0.62rem;
			gap: 0.3rem;
		}

		.property-card__details {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.7rem 0.5rem;
		}

		.property-card__footer {
			flex-direction: column;
			align-items: stretch;
		}

		.property-card__cta {
			width: 100%;
		}
	}
</style>
