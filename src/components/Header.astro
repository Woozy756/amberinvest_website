---
import { getMessages } from "../i18n/translations";
import { localizeInternalHref } from "../lib/routes";
import {
	getPropertyCategories,
	getPropertyCategoryHref,
	getPropertyCategoryLabel
} from "../sanity/properties";
import type { SiteLink, SiteSettings } from "../sanity/siteSettings";

interface Props {
	overlay?: boolean;
	siteSettings?: SiteSettings | null;
}

const { overlay = false, siteSettings = null } = Astro.props;
const messages = getMessages("lv");
const propertyCategories = await getPropertyCategories();
const homeHref = "/";
const propertiesHref = "/dzīvokļi";
const contactHref = "/kontakti";
const aboutBuildingHref = "/par-eku";

const isPropertiesLink = (item: SiteLink) => {
	const href = item.href.trim().toLowerCase();
	return href === propertiesHref || href.startsWith(`${propertiesHref}?`);
};

const isFaqLink = (item: SiteLink) => item.href.trim().toLowerCase() === "/faq";
const isContactLink = (item: SiteLink) => item.href.trim().toLowerCase() === contactHref;
const normalizeNavHref = (href: string) => {
	const normalizedHref = href.trim().toLowerCase().replace(/\/+$/, "");
	return normalizedHref || "/";
};
const mainNavOrder = new Map([
	[homeHref, 0],
	["/kā-iegādāties", 1],
	["/par-mums", 2],
	[aboutBuildingHref, 3]
]);
const orderMainNavItems = (items: SiteLink[]) =>
	[...items].sort((a, b) => {
		const aOrder = mainNavOrder.get(normalizeNavHref(a.href)) ?? Number.MAX_SAFE_INTEGER;
		const bOrder = mainNavOrder.get(normalizeNavHref(b.href)) ?? Number.MAX_SAFE_INTEGER;
		return aOrder - bOrder;
	});

const configuredNavItems = (siteSettings?.headerNavigation ?? []).map((item) => ({
	...item,
	href: localizeInternalHref(item.href)
}));
const defaultNavItems: SiteLink[] = [
	{ label: messages.header.home, href: homeHref },
	{ label: messages.header.howToBuy, href: "/kā-iegādāties" },
	{ label: messages.header.aboutUs, href: "/par-mums" },
	{ label: messages.header.aboutBuilding, href: aboutBuildingHref }
];
const baseNavItems = configuredNavItems.length > 0 ? configuredNavItems : defaultNavItems;
const hasAboutBuildingLink = baseNavItems.some((item) => item.href.trim().toLowerCase() === aboutBuildingHref);
const navigationItems = hasAboutBuildingLink
	? baseNavItems
	: [
			...baseNavItems.slice(0, 1),
			{ label: messages.header.aboutBuilding, href: aboutBuildingHref },
			...baseNavItems.slice(1)
		];

const visibleNavItems = navigationItems.filter((item) => !isFaqLink(item) && !isContactLink(item));
const firstPropertiesItem = visibleNavItems.find(isPropertiesLink);
const propertiesLabel = firstPropertiesItem?.label || messages.header.properties;
const mainNavItems = orderMainNavItems(visibleNavItems.filter((item) => !isPropertiesLink(item)));
const leadingNavItems = mainNavItems.slice(0, 1);
const trailingNavItems = mainNavItems.slice(1);

const homeAriaLabel = siteSettings?.siteTitle ?? "Sākumlapa";
const logo = siteSettings?.logo;
const logoAlt = logo?.alt || siteSettings?.siteTitle || "";
const headerCtaLabel = "Sazinies ar mums";

const propertiesItems = [
	{ href: propertiesHref, label: messages.header.propertiesListing },
	...propertyCategories.map((category) => ({
		href: getPropertyCategoryHref(category),
		label: getPropertyCategoryLabel(category, "lv")
	}))
];
---

<header class="site-header" data-header data-overlay={overlay} data-scrolled="false" data-menu-open="false" data-properties-open="false">
	<div class="site-header__shell">
		<div class="site-header__inner">
			<a class:list={["brand", { "brand--with-image": Boolean(logo?.url) }]} href={homeHref} aria-label={homeAriaLabel}>
				<span class:list={["brand__mark", { "brand__mark--image": Boolean(logo?.url) }]} aria-hidden={logo?.url ? "false" : "true"}>
					{logo?.url ? (
						<img class="brand__mark-image" src={logo.url} alt={logoAlt} loading="eager" decoding="async" />
					) : (
						"AI"
					)}
				</span>
			</a>

			<nav class="nav nav--desktop" aria-label={messages.header.navAriaLabel}>
				<ul class="nav__list">
					{
						leadingNavItems.map((item) => (
							<li>
								<a class="nav__link" href={item.href}>{item.label}</a>
							</li>
						))
					}
					<li class="nav__item nav__item--has-dropdown">
						<button
							class="nav__link nav__toggle"
							type="button"
							aria-expanded="false"
							aria-controls="properties-menu-desktop"
						>
							{propertiesLabel}
							<span class="nav__caret" aria-hidden="true"></span>
						</button>
						<div class="dropdown" id="properties-menu-desktop">
							<ul class="dropdown__list">
								{
									propertiesItems.map((item) => (
										<li>
											<a class="dropdown__link" href={item.href}>{item.label}</a>
										</li>
									))
								}
							</ul>
						</div>
					</li>
					{
						trailingNavItems.map((item) => (
							<li>
								<a class="nav__link" href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="site-header__actions">
				<a class="header-cta" href={contactHref}>{headerCtaLabel}</a>
				<button
					class="menu-toggle"
					type="button"
					data-menu-button
					aria-expanded="false"
					aria-controls="mobile-menu"
				>
					<span class="sr-only">{messages.header.menuOpenLabel}</span>
					<span></span>
					<span></span>
					<span></span>
				</button>
			</div>
		</div>
	</div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
	<nav aria-label={messages.header.mobileNavAriaLabel}>
		<ul class="mobile-nav">
			{
				leadingNavItems.map((item) => (
					<li>
						<a class="mobile-nav__link" href={item.href}>{item.label}</a>
					</li>
				))
			}
			<li class="mobile-nav__item mobile-nav__item--expandable">
				<button
					class="mobile-nav__toggle"
					type="button"
					data-properties-button
					aria-expanded="false"
					aria-controls="mobile-properties-menu"
				>
					<span>{propertiesLabel}</span>
					<span class="nav__caret" aria-hidden="true"></span>
				</button>
				<ul class="mobile-subnav" id="mobile-properties-menu">
					{
						propertiesItems.map((item) => (
							<li>
								<a class="mobile-subnav__link" href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</li>
			{
				trailingNavItems.map((item) => (
					<li>
						<a class="mobile-nav__link" href={item.href}>{item.label}</a>
					</li>
				))
			}
			<li class="mobile-nav__item mobile-nav__item--cta">
				<a class="mobile-nav__link mobile-nav__link--cta" href={contactHref}>{headerCtaLabel}</a>
			</li>
		</ul>
	</nav>
</div>

<script>
	const header = document.querySelector("[data-header]");
	const menuButton = header?.querySelector("[data-menu-button]");
	const propertiesButton = document.querySelector("[data-properties-button]");
	const desktopMedia = window.matchMedia("(min-width: 960px)");

	const syncScrollState = () => {
		if (!header) return;
		header.dataset.scrolled = window.scrollY > 16 ? "true" : "false";
	};

	const closeMobileMenus = () => {
		if (!header || !menuButton || !propertiesButton) return;
		header.dataset.menuOpen = "false";
		header.dataset.propertiesOpen = "false";
		document.documentElement.classList.remove("mobile-menu-open");
		document.documentElement.classList.remove("mobile-properties-open");
		menuButton.setAttribute("aria-expanded", "false");
		propertiesButton.setAttribute("aria-expanded", "false");
	};

	menuButton?.addEventListener("click", () => {
		if (!header) return;
		const nextState = header.dataset.menuOpen !== "true";
		header.dataset.menuOpen = nextState ? "true" : "false";
		document.documentElement.classList.toggle("mobile-menu-open", nextState);
		menuButton.setAttribute("aria-expanded", String(nextState));

		if (nextState && propertiesButton) {
			header.dataset.propertiesOpen = "true";
			document.documentElement.classList.add("mobile-properties-open");
			propertiesButton.setAttribute("aria-expanded", "true");
		}

		if (!nextState && propertiesButton) {
			header.dataset.propertiesOpen = "false";
			document.documentElement.classList.remove("mobile-properties-open");
			propertiesButton.setAttribute("aria-expanded", "false");
		}
	});

	propertiesButton?.addEventListener("click", () => {
		if (!header) return;
		const nextState = header.dataset.propertiesOpen !== "true";
		header.dataset.propertiesOpen = nextState ? "true" : "false";
		document.documentElement.classList.toggle("mobile-properties-open", nextState);
		propertiesButton.setAttribute("aria-expanded", String(nextState));
	});

	desktopMedia.addEventListener("change", (event) => {
		if (event.matches) closeMobileMenus();
	});

	window.addEventListener("scroll", syncScrollState, { passive: true });
	window.addEventListener("astro:page-load", syncScrollState);

	syncScrollState();
	if (desktopMedia.matches) closeMobileMenus();
</script>

<style>
	.site-header {
		--header-height: 5.25rem;
		position: sticky;
		top: 0;
		z-index: 100;
		margin-bottom: calc(var(--header-height) * -1);
		border-bottom: 1px solid transparent;
		transition:
			background-color 240ms var(--ease-premium),
			border-color 240ms var(--ease-premium),
			backdrop-filter 240ms var(--ease-premium),
			box-shadow 240ms var(--ease-premium);
	}

	.site-header::before {
		content: "";
		position: absolute;
		inset: 0 0 -1.4rem;
		z-index: 1;
		pointer-events: none;
		opacity: 0;
		background: linear-gradient(180deg, rgba(8, 11, 16, 0.42) 0%, rgba(8, 11, 16, 0.24) 58%, rgba(8, 11, 16, 0) 100%);
		transition: opacity 240ms var(--ease-premium);
	}

	.site-header[data-overlay="true"][data-scrolled="false"]::before {
		opacity: 1;
	}

	.site-header[data-overlay="false"] {
		background-color: var(--nav-surface);
		border-color: rgba(138, 144, 152, 0.14);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.site-header[data-overlay="true"][data-scrolled="true"] {
		background-color: var(--nav-surface);
		border-color: rgba(138, 144, 152, 0.14);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 12px 36px rgba(4, 8, 14, 0.24);
	}

	.site-header[data-menu-open="true"],
	.site-header[data-overlay="true"][data-scrolled="true"][data-menu-open="true"],
	.site-header[data-overlay="false"][data-menu-open="true"] {
		position: fixed;
		inset: 0 0 auto;
		width: 100%;
		background: transparent;
		border-color: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		box-shadow: none;
	}

	.site-header__shell {
		width: min(100%, var(--page-max-width));
		margin-inline: auto;
		padding-inline: var(--page-gutter);
	}

	.site-header__inner {
		position: relative;
		z-index: 2;
		min-height: var(--header-height);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--surface-light);
		text-decoration: none;
	}

	.brand__mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border: 1px solid rgba(199, 150, 67, 0.42);
		background: rgba(199, 150, 67, 0.12);
		color: var(--accent-primary);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.brand__mark--image {
		width: clamp(6.5rem, 12vw, 9rem);
		height: clamp(2.4rem, 4vw, 3rem);
		min-width: 0;
		padding: 0;
		background: transparent;
		border: 0;
	}

	.brand__mark-image {
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	.site-header[data-overlay="true"][data-scrolled="false"] .brand__mark-image {
		filter: drop-shadow(0 1px 10px rgba(0, 0, 0, 0.42));
	}

	.nav {
		justify-self: center;
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav__item {
		position: relative;
	}

	.nav__link,
	.nav__toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0;
		border: 0;
		background: transparent;
		color: var(--surface-light);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition: color 220ms var(--ease-premium);
	}

	.site-header[data-overlay="true"][data-scrolled="false"] .nav__link,
	.site-header[data-overlay="true"][data-scrolled="false"] .nav__toggle,
	.site-header[data-overlay="true"][data-scrolled="false"] .brand {
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.52);
	}

	.nav__link::after,
	.nav__toggle::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -0.08rem;
		width: 100%;
		height: 2px;
		transform: scaleX(0);
		transform-origin: left center;
		background-color: var(--accent-primary);
		transition: transform 240ms var(--ease-premium);
	}

	.nav__link:hover,
	.nav__link:focus-visible,
	.nav__toggle:hover,
	.nav__toggle:focus-visible,
	.dropdown__link:hover,
	.dropdown__link:focus-visible,
	.mobile-nav__link:hover,
	.mobile-nav__link:focus-visible,
	.mobile-nav__toggle:hover,
	.mobile-nav__toggle:focus-visible,
	.mobile-subnav__link:hover,
	.mobile-subnav__link:focus-visible {
		color: var(--accent-primary);
		outline: none;
	}

	.nav__link:hover::after,
	.nav__link:focus-visible::after,
	.nav__toggle:hover::after,
	.nav__toggle:focus-visible::after,
	.nav__item--has-dropdown:hover > .nav__toggle::after,
	.nav__item--has-dropdown:focus-within > .nav__toggle::after {
		transform: scaleX(1);
	}

	.nav__caret {
		width: 0.45rem;
		height: 0.45rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: translateY(-0.08rem) rotate(45deg);
		transition: transform 220ms var(--ease-premium);
	}

	.nav__item--has-dropdown:hover .nav__caret,
	.nav__item--has-dropdown:focus-within .nav__caret,
	:global(html.mobile-properties-open) .mobile-nav__toggle .nav__caret {
		transform: translateY(0.04rem) rotate(225deg);
	}

	.dropdown {
		position: absolute;
		top: calc(100% + 1rem);
		left: 50%;
		min-width: 15rem;
		padding: 0.5rem;
		border: 1px solid rgba(138, 144, 152, 0.16);
		background: rgba(12, 19, 30, 0.94);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		opacity: 0;
		visibility: hidden;
		transform: translate3d(-50%, 0.5rem, 0);
		transition:
			opacity 220ms var(--ease-premium),
			transform 220ms var(--ease-premium),
			visibility 220ms var(--ease-premium);
	}

	.nav__item--has-dropdown:hover .dropdown,
	.nav__item--has-dropdown:focus-within .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translate3d(-50%, 0, 0);
	}

	.dropdown__list,
	.mobile-nav,
	.mobile-subnav {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dropdown__link {
		display: block;
		padding: 0.85rem 0.95rem;
		color: var(--surface-light);
		text-decoration: none;
		font-size: 0.92rem;
		line-height: 1.45;
		transition:
			color 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium);
	}

	.dropdown__link:hover,
	.dropdown__link:focus-visible {
		background-color: rgba(199, 150, 67, 0.08);
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.9rem;
		padding: 0.72rem 1.2rem;
		background-color: var(--accent-primary);
		color: var(--bg-primary);
		border: 1px solid transparent;
		text-decoration: none;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium);
	}

	.header-cta:hover,
	.header-cta:focus-visible {
		background-color: var(--accent-hover);
		transform: translateY(-2px);
		outline: none;
	}

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.28rem;
		width: 2.9rem;
		height: 2.9rem;
		padding: 0;
		border: 1px solid rgba(138, 144, 152, 0.22);
		background: rgba(245, 243, 238, 0.02);
		color: var(--surface-light);
		cursor: pointer;
		transition:
			border-color 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium);
	}

	.menu-toggle:hover,
	.menu-toggle:focus-visible {
		border-color: rgba(199, 150, 67, 0.42);
		background: rgba(199, 150, 67, 0.08);
		outline: none;
	}

	.menu-toggle span:not(.sr-only) {
		display: block;
		width: 1.1rem;
		height: 1px;
		background-color: currentColor;
		transition:
			transform 220ms var(--ease-premium),
			opacity 220ms var(--ease-premium);
	}

	.site-header[data-menu-open="true"] .menu-toggle span:nth-child(2) {
		transform: translateY(0.38rem) rotate(45deg);
	}

	.site-header[data-menu-open="true"] .menu-toggle span:nth-child(3) {
		opacity: 0;
	}

	.site-header[data-menu-open="true"] .menu-toggle span:nth-child(4) {
		transform: translateY(-0.38rem) rotate(-45deg);
	}

	.mobile-menu {
		--header-height: 5.25rem;
		display: none;
		position: fixed;
		inset: 0;
		z-index: 90;
		width: 100%;
		height: 100svh;
		flex-direction: column;
		padding:
			calc(var(--header-height) + clamp(1.25rem, 5vw, 2rem))
			clamp(1.25rem, 4vw, 3rem)
			max(1.5rem, env(safe-area-inset-bottom));
		background: var(--bg-primary);
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		opacity: 0;
		visibility: hidden;
		overflow-y: auto;
		pointer-events: none;
		transform: translateY(-0.75rem);
		transition:
			opacity 240ms var(--ease-premium),
			transform 240ms var(--ease-premium),
			visibility 240ms var(--ease-premium);
	}

	.mobile-menu::before {
		content: "";
		position: absolute;
		inset: 0;
		border-top: 1px solid var(--border-subtle);
		pointer-events: none;
	}

	.mobile-menu nav {
		position: relative;
		z-index: 1;
		width: min(100%, 40rem);
		margin-inline: auto;
	}

	.mobile-nav__link,
	.mobile-nav__toggle,
	.mobile-subnav__link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 1rem 0;
		border: 0;
		background: transparent;
		color: var(--surface-light);
		font: inherit;
		font-size: 0.94rem;
		text-decoration: none;
		cursor: pointer;
	}

	.mobile-nav__item,
	.mobile-nav > li {
		border-bottom: 1px solid rgba(138, 144, 152, 0.12);
	}

	.mobile-nav__item--cta {
		border-bottom: 0;
		padding-top: 0.8rem;
	}

	.mobile-nav__link--cta {
		justify-content: center;
		background: var(--accent-primary);
		color: var(--bg-primary);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.mobile-nav__link--cta:hover,
	.mobile-nav__link--cta:focus-visible {
		background: var(--accent-hover);
		color: var(--bg-primary);
	}

	.mobile-subnav {
		max-height: 0;
		overflow: hidden;
		transition: max-height 220ms var(--ease-premium);
	}

	.mobile-subnav > li {
		overflow: hidden;
	}

	:global(html.mobile-properties-open) .mobile-subnav {
		max-height: 48rem;
	}

	.mobile-subnav__link {
		padding: 0.8rem 0 0.8rem 1rem;
		color: var(--text-secondary);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 959px) {
		.site-header {
			--header-height: 5.5rem;
		}

		.mobile-menu {
			--header-height: 5.5rem;
		}

		.site-header__shell {
			padding-inline: 1.375rem;
		}

		.site-header__inner {
			grid-template-columns: auto auto;
			justify-content: space-between;
		}

		.nav--desktop,
		.site-header__actions .header-cta {
			display: none;
		}

		.menu-toggle,
		.mobile-menu {
			display: inline-flex;
		}

		.mobile-menu {
			display: flex;
		}

		:global(html.mobile-menu-open) .mobile-menu {
