---
interface Props {
	placement?: "home" | "product";
	class?: string;
}

const { placement = "home", class: className = "", ...attrs } = Astro.props as Props & Record<string, unknown>;

const benefits = [
	{
		lines: ["A+", "Energo efektivitāte"],
		icon: "/icons/benefits/energy-efficiency.png"
	},
	{
		lines: ["Regulējamas", "siltās grīdas"],
		icon: "/icons/benefits/heated-floors.png"
	},
	{
		lines: ["Rekuperācijas sistēma -", "nodrošina svaigu gaisu telpās"],
		icon: "/icons/benefits/ventilation.png"
	},
	{
		lines: ["Pabeigta iekšējā", "apdare"],
		icon: "/icons/benefits/finished-interior.png"
	},
	{
		lines: ["Pieejamas auto", "stāvvietas"],
		icon: "/icons/benefits/parking.png"
	}
];

const rootClass = ["benefits-strip", `benefits-strip--${placement}`, className].filter(Boolean).join(" ");
---

<div {...attrs} class={rootClass} data-benefits-scroll>
	<div class="benefits-strip__sticky" data-benefits-sticky>
		<ul class="benefits-strip__track" role="list" aria-label="Projekta priekšrocības" data-benefits-track>
			{
				benefits.map((benefit) => (
					<li class="benefits-strip__item">
						<img src={benefit.icon} alt="" width="64" height="64" loading="lazy" aria-hidden="true" />
						<span>
							{benefit.lines.map((line) => (
								<span class="benefits-strip__line">{line}</span>
							))}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</div>

<script is:inline>
	(() => {
		const benefitScrollers = document.querySelectorAll('[data-benefits-scroll]');
		const mobileBenefitsQuery = window.matchMedia('(max-width: 720px)');

		if (!benefitScrollers.length) return;

		let benefitsFrame = 0;

		const updateBenefitsScroll = () => {
			benefitsFrame = 0;

			benefitScrollers.forEach((benefitsScroller) => {
				const benefitsTrack = benefitsScroller.querySelector('[data-benefits-track]');

				if (!benefitsTrack) return;

				if (!mobileBenefitsQuery.matches) {
					benefitsScroller.style.removeProperty('--benefits-scroll-space');
					benefitsScroller.style.removeProperty('--benefits-sticky-height');
					benefitsTrack.style.removeProperty('--benefits-x');
					return;
				}

				const stickyPanel = benefitsScroller.querySelector('[data-benefits-sticky]');
				const stickyHeight = stickyPanel ? stickyPanel.getBoundingClientRect().height : 1;
				const stickyTop = Math.max(0, ((window.innerHeight || 1) - stickyHeight) / 2);
				const distance = Math.max(0, benefitsTrack.scrollWidth - window.innerWidth);
				const scrollSpace = Math.max(distance * 0.7, window.innerHeight * 0.42);
				const rect = benefitsScroller.getBoundingClientRect();
				const progress = Math.min(1, Math.max(0, (stickyTop - rect.top) / scrollSpace));

				benefitsScroller.style.setProperty('--benefits-scroll-space', `${Math.round(scrollSpace)}px`);
				benefitsScroller.style.setProperty('--benefits-sticky-height', `${Math.round(stickyHeight)}px`);
				benefitsTrack.style.setProperty('--benefits-x', `${Math.round(-distance * progress)}px`);
			});
		};

		const requestBenefitsScroll = () => {
			if (benefitsFrame) return;
			benefitsFrame = window.requestAnimationFrame(updateBenefitsScroll);
		};

		updateBenefitsScroll();
		window.addEventListener('scroll', requestBenefitsScroll, { passive: true });
		window.addEventListener('resize', requestBenefitsScroll);
		if (typeof mobileBenefitsQuery.addEventListener === 'function') {
			mobileBenefitsQuery.addEventListener('change', requestBenefitsScroll);
		} else {
			mobileBenefitsQuery.addListener(requestBenefitsScroll);
		}
	})();
</script>

<style>
	.benefits-strip {
		justify-self: center;
		box-sizing: border-box;
		width: min(100%, 1280px);
		margin: clamp(0.4rem, 1vw, 0.8rem) auto 0;
		border-top: 1px solid rgba(35, 38, 43, 0.12);
	}

	.benefits-strip--home {
		grid-column: 1 / -1;
	}

	.benefits-strip--product {
		width: min(calc(100% - clamp(1rem, 2vw, 1.5rem)), 1600px);
		margin-top: clamp(0.4rem, 1.2vw, 1rem);
		margin-bottom: clamp(1.2rem, 2.6vw, 2rem);
	}

	.benefits-strip__sticky {
		overflow: visible;
	}

	.benefits-strip__track {
		list-style: none;
		margin: 0;
		padding: clamp(1.2rem, 2.4vw, 1.55rem) clamp(1.5rem, 4vw, 3rem) 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		align-items: stretch;
		justify-content: center;
		gap: 0;
		overflow: visible;
		transform: translate3d(var(--benefits-x, 0px), 0, 0);
	}

	.benefits-strip__track::-webkit-scrollbar {
		display: none;
	}

	.benefits-strip__item {
		min-width: 0;
		min-height: clamp(12rem, 15.5vw, 15rem);
		display: grid;
		align-content: center;
		justify-items: center;
		gap: clamp(0.55rem, 1vw, 0.82rem);
		padding: clamp(0.75rem, 1.5vw, 1rem) clamp(0.55rem, 1.2vw, 1.05rem);
		border-left: 1px solid rgba(0, 119, 182, 0.15);
		text-align: center;
	}

	.benefits-strip__item:first-child {
		border-left: 0;
	}

	.benefits-strip__item img {
		width: clamp(5.6rem, 8.6vw, 9.25rem);
		height: clamp(5.6rem, 8.6vw, 9.25rem);
		object-fit: contain;
		opacity: 0.88;
	}

	.benefits-strip__item span {
		max-width: none;
		color: rgba(15, 17, 21, 0.86);
		font-size: clamp(0.98rem, 1.45vw, 1.42rem);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: 0;
	}

	.benefits-strip__line {
		display: block;
		text-wrap: balance;
	}

	@media (min-width: 981px) {
		.benefits-strip__item {
			height: clamp(12rem, 15vw, 15rem);
		}
	}

	@media (max-width: 980px) {
		.benefits-strip__track {
			grid-template-columns:
				minmax(11.5rem, 1fr)
				minmax(11.5rem, 1fr)
				minmax(20rem, 1.45fr)
				minmax(11.5rem, 1fr)
				minmax(11.5rem, 1fr);
			overflow-x: auto;
			overscroll-behavior-inline: contain;
			scrollbar-width: none;
		}
	}

	@media (max-width: 720px) {
		.benefits-strip {
			--benefits-scroll-space: 26rem;
			--benefits-sticky-height: 10.75rem;

			width: 100vw;
			height: calc(var(--benefits-scroll-space) + var(--benefits-sticky-height));
			margin-top: 0;
			margin-inline: calc(50% - 50vw);
			border-top: 0;
		}

		.benefits-strip__sticky {
			position: sticky;
			top: 50%;
			width: 100vw;
			overflow: hidden;
			background: transparent;
			transform: translateY(-50%);
		}

		.benefits-strip__track {
			width: max-content;
			min-width: max-content;
			grid-template-columns:
				minmax(14rem, 76vw)
				minmax(14rem, 76vw)
				minmax(18.5rem, 86vw)
				minmax(14rem, 76vw)
				minmax(14rem, 76vw);
			padding: 0.7rem max(1.25rem, 6vw) 0;
			overflow: visible;
			will-change: transform;
		}

		.benefits-strip__item {
			min-height: 10.2rem;
			border-left: 1px solid rgba(0, 119, 182, 0.15);
		}

		.benefits-strip__item img {
			width: clamp(4.6rem, 18vw, 5.6rem);
			height: clamp(4.6rem, 18vw, 5.6rem);
		}

		.benefits-strip__item span {
			font-size: clamp(0.92rem, 4.8vw, 1.18rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.benefits-strip {
			height: auto;
		}

		.benefits-strip__sticky {
			position: static;
			overflow-x: auto;
			transform: none;
		}

		.benefits-strip__track {
			transform: none;
		}
	}
</style>
