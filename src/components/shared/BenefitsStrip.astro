---
interface Props {
	placement?: "home" | "product";
	class?: string;
}

const { placement = "home", class: className = "", ...attrs } = Astro.props as Props & Record<string, unknown>;

const benefits = [
	{
		lines: ["A kategorijas", "energoefektivitāte"],
		icon: "/images/benefits/energy-efficiency.png",
		description: "≥45 kWh gadā uz m²."
	},
	{
		lines: ["Regulējamas", "siltās grīdas"],
		icon: "/images/benefits/heated-floors.png",
		description: "Katrā istabā."
	},
	{
		lines: ["Rekuperācijas sistēma -", "nodrošina svaigu gaisu telpās"],
		icon: "/images/benefits/ventilation.png",
		description: "Svaigāks gaiss ikdienā."
	},
	{
		lines: ["Pabeigta iekšējā", "apdare"],
		icon: "/images/benefits/finished-interior.png",
		description: "Labiekārtots sanitārais mezgls ar santehniku."
	},
	{
		lines: ["Pieejamas auto", "stāvvietas"],
		icon: "/images/benefits/parking.png",
		description: "Ērta ikdienas novietošana pie mājas."
	}
];

const rootClass = ["benefits-strip", `benefits-strip--${placement}`, className].filter(Boolean).join(" ");
---

<div {...attrs} class={rootClass} data-benefits-scroll>
	<div class="benefits-strip__sticky" data-benefits-sticky>
		<ul class="benefits-strip__track" role="list" aria-label="Projekta priekšrocības" data-benefits-track>
			{
				benefits.map((benefit) => (
					<li class="benefits-strip__item">
						<span class="benefits-strip__icon" aria-hidden="true">
							<img src={benefit.icon} alt="" width="64" height="64" loading="lazy" />
						</span>
						<span class="benefits-strip__title">
							{benefit.lines.map((line) => (
								<span class="benefits-strip__line">{line}</span>
							))}
						</span>
						<p>{benefit.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.benefits-strip {
		justify-self: center;
		box-sizing: border-box;
		width: min(100%, 1280px);
		margin: clamp(0.4rem, 1vw, 0.8rem) auto 0;
		border-top: 1px solid rgba(35, 38, 43, 0.12);
		overflow: visible;
	}

	.benefits-strip--home {
		grid-column: 1 / -1;
	}

	.benefits-strip--product {
		width: min(calc(100% - clamp(3rem, 8vw, 6rem)), 1184px);
		margin-top: clamp(0.4rem, 1vw, 0.8rem);
		margin-bottom: clamp(1.2rem, 2.6vw, 2rem);
	}

	.benefits-strip__sticky {
		overflow: visible;
	}

	.benefits-strip__track {
		list-style: none;
		margin: 0;
		padding: clamp(1.2rem, 2.4vw, 1.55rem) clamp(1.5rem, 4vw, 3rem) 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		align-items: stretch;
		justify-content: center;
		gap: 0;
		overflow: visible;
		transform: translate3d(var(--benefits-x, 0px), 0, 0);
	}

	.benefits-strip__track::-webkit-scrollbar {
		display: none;
	}

	.benefits-strip__item {
		position: relative;
		box-sizing: border-box;
		min-width: 0;
		min-height: clamp(16rem, 17vw, 17rem);
		display: grid;
		grid-template-rows:
			clamp(4.5rem, 6.2vw, 5.5rem)
			minmax(3.45rem, auto)
			minmax(3.25rem, auto);
		align-content: start;
		justify-items: center;
		gap: clamp(0.45rem, 0.8vw, 0.65rem);
		padding: clamp(1.05rem, 1.6vw, 1.25rem) clamp(0.8rem, 1.4vw, 1.05rem);
		border-left: 1px solid rgba(0, 119, 182, 0.15);
		background: transparent;
		text-align: center;
		transform: scale(1);
		transform-origin: center;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium),
			box-shadow 220ms var(--ease-premium);
	}

	.benefits-strip__item:first-child {
		border-left: 0;
	}

	.benefits-strip__item:hover {
		z-index: 2;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 18px 45px rgba(15, 17, 21, 0.11);
		transform: scale(1.08);
	}

	.benefits-strip__icon {
		display: grid;
		place-items: center;
		width: clamp(4.5rem, 6.2vw, 5.5rem);
		height: clamp(4.5rem, 6.2vw, 5.5rem);
	}

	.benefits-strip__icon img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0.88;
	}

	.benefits-strip__title {
		display: grid;
		align-content: center;
		justify-items: center;
		width: 100%;
		max-width: 13.5rem;
		color: rgba(15, 17, 21, 0.86);
		font-size: clamp(0.92rem, 1.1vw, 1.08rem);
		font-weight: 900;
		line-height: 1.08;
		letter-spacing: 0;
	}

	.benefits-strip__item p {
		max-width: 13.5rem;
		margin: 0;
		color: rgba(15, 17, 21, 0.58);
		font-size: clamp(0.76rem, 0.9vw, 0.9rem);
		font-weight: 700;
		line-height: 1.35;
		text-wrap: balance;
	}

	.benefits-strip__line {
		display: block;
		text-wrap: balance;
	}

	@media (min-width: 981px) {
		.benefits-strip__item {
			height: clamp(16rem, 17vw, 17rem);
		}
	}

	@media (max-width: 980px) {
		.benefits-strip__track {
			grid-template-columns: repeat(5, minmax(12rem, 1fr));
			overflow-x: auto;
			overscroll-behavior-inline: contain;
			scrollbar-width: none;
		}
	}

	@media (max-width: 720px) {
		.benefits-strip {
			width: min(calc(100% - 3rem), 34rem);
			height: auto;
			margin-top: 1.5rem;
			margin-bottom: 0;
			margin-inline: auto;
			border-top: 1px solid rgba(35, 38, 43, 0.12);
			border-bottom: 1px solid rgba(35, 38, 43, 0.12);
		}

		.benefits-strip__sticky {
			position: static;
			width: 100%;
			overflow: visible;
			background: transparent;
			transform: none;
		}

		.benefits-strip__track {
			width: 100%;
			min-width: 0;
			grid-template-columns: 1fr;
			gap: 0;
			padding: 0;
			background: transparent;
			overflow: visible;
			transform: none;
		}

		.benefits-strip__item {
			min-height: auto;
			grid-template-columns: 2.75rem minmax(0, 1fr);
			grid-template-rows: auto auto;
			align-items: center;
			justify-items: start;
			gap: 0.2rem 0.72rem;
			padding: 0.68rem 0.55rem;
			border-left: 0;
			background: var(--surface-light);
			text-align: left;
			transform: none;
		}

		.benefits-strip__item + .benefits-strip__item {
			border-top: 1px solid rgba(35, 38, 43, 0.1);
		}

		.benefits-strip__item:hover {
			transform: none;
		}

		.benefits-strip__icon {
			grid-row: 1 / span 2;
			width: 2.55rem;
			height: 2.55rem;
		}

		.benefits-strip__title {
			justify-items: start;
			max-width: 100%;
			font-size: clamp(0.82rem, 3.3vw, 0.92rem);
			line-height: 1.14;
		}

		.benefits-strip__item p {
			max-width: 100%;
			font-size: clamp(0.7rem, 2.85vw, 0.8rem);
			line-height: 1.34;
			text-align: left;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.benefits-strip {
			height: auto;
		}

		.benefits-strip__sticky {
			position: static;
			overflow-x: auto;
			transform: none;
		}

		.benefits-strip__track {
			transform: none;
		}
	}
</style>
