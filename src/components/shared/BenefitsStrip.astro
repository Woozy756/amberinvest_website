---
interface Props {
	placement?: "home" | "product";
	class?: string;
}

const { placement = "home", class: className = "", ...attrs } = Astro.props as Props & Record<string, unknown>;

const benefits = [
	{
		lines: ["A kategorijas", "energoefektivitāte"],
		icon: "/images/benefits/energy-efficiency.png",
		description: "≥45 kWh gadā uz m²."
	},
	{
		lines: ["Regulējamas", "siltās grīdas"],
		icon: "/images/benefits/heated-floors.png",
		description: "Katrā istabā."
	},
	{
		lines: ["Rekuperācijas sistēma -", "nodrošina svaigu gaisu telpās"],
		icon: "/images/benefits/ventilation.png",
		description: "Svaigāks gaiss ikdienā."
	},
	{
		lines: ["Pabeigta iekšējā", "apdare"],
		icon: "/images/benefits/finished-interior.png",
		description: "Labiekārtots sanitārais mezgls ar santehniku."
	},
	{
		lines: ["Pieejamas auto", "stāvvietas"],
		icon: "/images/benefits/parking.png",
		description: "Ērta ikdienas novietošana pie mājas."
	}
];

const rootClass = ["benefits-strip", `benefits-strip--${placement}`, className].filter(Boolean).join(" ");
---

<div {...attrs} class={rootClass} data-benefits-scroll>
	<div class="benefits-strip__sticky" data-benefits-sticky>
		<ul class="benefits-strip__track" role="list" aria-label="Projekta priekšrocības" data-benefits-track>
			{
				benefits.map((benefit) => (
					<li class="benefits-strip__item">
						<span class="benefits-strip__icon" aria-hidden="true">
							<img src={benefit.icon} alt="" width="64" height="64" loading="lazy" />
						</span>
						<span class="benefits-strip__title">
							{benefit.lines.map((line) => (
								<span class="benefits-strip__line">{line}</span>
							))}
						</span>
						<p>{benefit.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</div>

<script is:inline>
	(() => {
		const benefitScrollers = document.querySelectorAll('[data-benefits-scroll]');
		const mobileBenefitsQuery = window.matchMedia('(max-width: 720px)');

		if (!benefitScrollers.length) return;

		let benefitsFrame = 0;

		const updateBenefitsScroll = () => {
			benefitsFrame = 0;

			benefitScrollers.forEach((benefitsScroller) => {
				const benefitsTrack = benefitsScroller.querySelector('[data-benefits-track]');

				if (!benefitsTrack) return;

				if (!mobileBenefitsQuery.matches) {
					benefitsScroller.style.removeProperty('--benefits-scroll-space');
					benefitsScroller.style.removeProperty('--benefits-sticky-height');
					benefitsTrack.style.removeProperty('--benefits-x');
					return;
				}

				const stickyPanel = benefitsScroller.querySelector('[data-benefits-sticky]');
				const stickyHeight = stickyPanel ? stickyPanel.getBoundingClientRect().height : 1;
				const stickyTop = Math.max(0, ((window.innerHeight || 1) - stickyHeight) / 2);
				const distance = Math.max(0, benefitsTrack.scrollWidth - window.innerWidth);
				const scrollSpace = Math.max(distance * 0.7, window.innerHeight * 0.42);
				const rect = benefitsScroller.getBoundingClientRect();
				const progress = Math.min(1, Math.max(0, (stickyTop - rect.top) / scrollSpace));

				benefitsScroller.style.setProperty('--benefits-scroll-space', `${Math.round(scrollSpace)}px`);
				benefitsScroller.style.setProperty('--benefits-sticky-height', `${Math.round(stickyHeight)}px`);
				benefitsTrack.style.setProperty('--benefits-x', `${Math.round(-distance * progress)}px`);
			});
		};

		const requestBenefitsScroll = () => {
			if (benefitsFrame) return;
			benefitsFrame = window.requestAnimationFrame(updateBenefitsScroll);
		};

		updateBenefitsScroll();
		window.addEventListener('scroll', requestBenefitsScroll, { passive: true });
		window.addEventListener('resize', requestBenefitsScroll);
		if (typeof mobileBenefitsQuery.addEventListener === 'function') {
			mobileBenefitsQuery.addEventListener('change', requestBenefitsScroll);
		} else {
			mobileBenefitsQuery.addListener(requestBenefitsScroll);
		}
	})();
</script>

<style>
	.benefits-strip {
		justify-self: center;
		box-sizing: border-box;
		width: min(100%, 1280px);
		margin: clamp(0.4rem, 1vw, 0.8rem) auto 0;
		border-top: 1px solid rgba(35, 38, 43, 0.12);
		overflow: visible;
	}

	.benefits-strip--home {
		grid-column: 1 / -1;
	}

	.benefits-strip--product {
		width: min(calc(100% - clamp(3rem, 8vw, 6rem)), 1184px);
		margin-top: clamp(0.4rem, 1vw, 0.8rem);
		margin-bottom: clamp(1.2rem, 2.6vw, 2rem);
	}

	.benefits-strip__sticky {
		overflow: visible;
	}

	.benefits-strip__track {
		list-style: none;
		margin: 0;
		padding: clamp(1.2rem, 2.4vw, 1.55rem) clamp(1.5rem, 4vw, 3rem) 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		align-items: stretch;
		justify-content: center;
		gap: 0;
		overflow: visible;
		transform: translate3d(var(--benefits-x, 0px), 0, 0);
	}

	.benefits-strip__track::-webkit-scrollbar {
		display: none;
	}

	.benefits-strip__item {
		position: relative;
		box-sizing: border-box;
		min-width: 0;
		min-height: clamp(16rem, 17vw, 17rem);
		display: grid;
		grid-template-rows:
			clamp(4.5rem, 6.2vw, 5.5rem)
			minmax(3.45rem, auto)
			minmax(3.25rem, auto);
		align-content: start;
		justify-items: center;
		gap: clamp(0.45rem, 0.8vw, 0.65rem);
		padding: clamp(1.05rem, 1.6vw, 1.25rem) clamp(0.8rem, 1.4vw, 1.05rem);
		border-left: 1px solid rgba(0, 119, 182, 0.15);
		background: transparent;
		text-align: center;
		transform: scale(1);
		transform-origin: center;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium),
			box-shadow 220ms var(--ease-premium);
	}

	.benefits-strip__item:first-child {
		border-left: 0;
	}

	.benefits-strip__item:hover {
		z-index: 2;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 18px 45px rgba(15, 17, 21, 0.11);
		transform: scale(1.08);
	}

	.benefits-strip__icon {
		display: grid;
		place-items: center;
		width: clamp(4.5rem, 6.2vw, 5.5rem);
		height: clamp(4.5rem, 6.2vw, 5.5rem);
	}

	.benefits-strip__icon img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0.88;
	}

	.benefits-strip__title {
		display: grid;
		align-content: center;
		justify-items: center;
		width: 100%;
		max-width: 13.5rem;
		color: rgba(15, 17, 21, 0.86);
		font-size: clamp(0.92rem, 1.1vw, 1.08rem);
		font-weight: 900;
		line-height: 1.08;
		letter-spacing: 0;
	}

	.benefits-strip__item p {
		max-width: 13.5rem;
		margin: 0;
		color: rgba(15, 17, 21, 0.58);
		font-size: clamp(0.76rem, 0.9vw, 0.9rem);
		font-weight: 700;
		line-height: 1.35;
		text-wrap: balance;
	}

	.benefits-strip__line {
		display: block;
		text-wrap: balance;
	}

	@media (min-width: 981px) {
		.benefits-strip__item {
			height: clamp(16rem, 17vw, 17rem);
		}
	}

	@media (max-width: 980px) {
		.benefits-strip__track {
			grid-template-columns: repeat(5, minmax(12rem, 1fr));
			overflow-x: auto;
			overscroll-behavior-inline: contain;
			scrollbar-width: none;
		}
	}

	@media (max-width: 720px) {
		.benefits-strip {
			--benefits-scroll-space: 26rem;
			--benefits-sticky-height: 10.75rem;

			width: 100%;
			height: calc(var(--benefits-scroll-space) + var(--benefits-sticky-height));
			margin-top: clamp(3.5rem, 16vw, 5.75rem);
			margin-inline: 0;
			border-top: 0;
		}

		.benefits-strip__sticky {
			position: sticky;
			top: 50%;
			width: 100%;
			overflow: hidden;
			background: transparent;
			transform: translateY(-50%);
		}

		.benefits-strip__track {
			width: max-content;
			min-width: max-content;
			grid-template-columns: repeat(5, minmax(14.5rem, 76vw));
			padding: 0.7rem max(1.25rem, 6vw) 0;
			overflow: visible;
			will-change: transform;
		}

		.benefits-strip__item {
			min-height: 11rem;
			grid-template-rows:
				clamp(4.5rem, 18vw, 5.4rem)
				minmax(3.45rem, auto)
				minmax(2.4rem, auto);
			border-left: 1px solid rgba(0, 119, 182, 0.15);
		}

		.benefits-strip__item:hover {
			transform: scale(1.04);
		}

		.benefits-strip__icon {
			width: clamp(4.5rem, 18vw, 5.4rem);
			height: clamp(4.5rem, 18vw, 5.4rem);
		}

		.benefits-strip__title {
			font-size: clamp(0.86rem, 4.3vw, 1.08rem);
		}

		.benefits-strip__item p {
			max-width: 13rem;
			font-size: clamp(0.74rem, 3.4vw, 0.86rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.benefits-strip {
			height: auto;
		}

		.benefits-strip__sticky {
			position: static;
			overflow-x: auto;
			transform: none;
		}

		.benefits-strip__track {
			transform: none;
		}
	}
</style>
