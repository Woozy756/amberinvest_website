---
import type { HomepageHeroContent } from "../../sanity/homepage";
import type { Locale } from "../../i18n/translations";

interface Props {
	content?: HomepageHeroContent | null;
	locale?: Locale;
}

const { content, locale = "lv" } = Astro.props;
const isEnglish = locale === "en";
const heroFallbackImage = "/images/hero-night.png";
const mobileHeroImage = "/images/hero-mobile.png";
const heroImage = content?.heroBackgroundImage?.asset?.url ?? heroFallbackImage;
const availabilityMetrics = isEnglish
	? [
			{ label: "Available apartments", value: "15" },
			{ label: "Number of rooms", value: "3, 4, 5" },
			{ label: "Apartment area", value: "53–90 m²" },
			{ label: "Project", value: "2026" }
		]
	: content?.metrics?.map((metric) =>
		metric.label.toLowerCase().includes("istabu")
			? { ...metric, value: "3, 4, 5" }
			: metric
	) ?? [];
const primaryCtaLabel = isEnglish ? "VIEW APARTMENTS" : "APSKATIES DZĪVOKĻUS";
const primaryCtaHref = isEnglish ? "/en/apartments" : "/dzīvokļi";
const contactCtaLabel = isEnglish ? "Contact us" : "Sazinies ar mums";
const contactCtaHref = isEnglish ? "/en/contact" : "/kontakti";
const heroProjectKicker = isEnglish ? "New apartment development" : "Jaunais daudzīvokļu projekts";
const heroProjectLocation = isEnglish ? '"AmberHome" Talsu Street 3A' : '"AmberHome" Talsu iela 3A';
const heroTitlePrefix = isEnglish ? "Discover and" : "Iepazīsties un";
const heroTitleMain = isEnglish ? "Find your new home" : "Atrodi savas jaunās mājas";
const mobileHeroLead = isEnglish
	? "Explore apartments at Talsu Street 3A and find the home that suits you."
	: "Apskati dzīvokļus Talsu ielā 3A un atrodi sev piemērotāko mājokli.";
const heroLead =
	isEnglish
		? "Explore the available apartments at Talsu Street 3A and find a home that suits your everyday needs and budget."
		: "Apskati pieejamos dzīvokļus Talsu ielā 3A un atrodi mājokli, kas atbilst Tavām ikdienas vajadzībām un budžetam.";
---

{
	content ? (
		<div class="hero-pin">
			<section
				class="hero"
				aria-labelledby="hero-title"
				style={`--hero-background-image: url("${heroImage}"); --hero-mobile-image: url("${mobileHeroImage}"); --hero-fallback-image: url("${heroFallbackImage}")`}
			>
				<div class="hero__image" aria-hidden="true"></div>
				<div class="hero__container">
					<div class="hero__body">
						<div class="hero__content fade-in">
							<h1 id="hero-title">
								<span class="hero__project-kicker">{heroProjectKicker}</span>
								<strong class="hero__project-heading hero__project-heading--desktop">{heroProjectLocation}</strong>
								<strong class="hero__project-heading hero__project-heading--mobile">
									<span>“AmberHome”</span>
									<span>{isEnglish ? "Talsu Street 3A" : "Talsu ielā 3A"}</span>
								</strong>
								<span class="hero__intro-line hero__intro-line--desktop">{heroTitlePrefix}</span>
								<strong class="hero__intro-main hero__intro-main--desktop">{heroTitleMain}</strong>
								<span class="hero__mobile-supporting">{isEnglish ? "Discover and find your new home" : "Iepazīsties un atrodi savas jaunās mājas"}</span>
							</h1>
							<p class="hero__lead">
								<span class="hero__lead-desktop">{heroLead}</span>
								<span class="hero__lead-mobile">{mobileHeroLead}</span>
							</p>
							<div class="hero__actions">
								<a class="button button--primary" href={primaryCtaHref}>
									{primaryCtaLabel}
								</a>
								<a class="button button--secondary" href={contactCtaHref}>
									<span class="button__label-desktop">{contactCtaLabel}</span>
									<span class="button__label-mobile">{isEnglish ? "Contact" : "Sazināties"}</span>
								</a>
							</div>
						</div>
					</div>

					<div class="availability" aria-labelledby="availability-title">
						<h2 id="availability-title" class="sr-only">{isEnglish ? "Available apartments" : content.availabilityTitle}</h2>
						<div class="availability__container fade-in" data-reveal-delay="160">
							<dl class="availability__grid">
								{
									availabilityMetrics.map((metric, index) => (
										<div class="availability__item fade-in" data-reveal-delay={String(220 + index * 70)}>
											<dt>{metric.label}</dt>
											<dd data-stat-value={metric.value}>{metric.value}</dd>
										</div>
									))
								}
							</dl>
							<div class="availability__actions">
								<a class="button button--primary" href={primaryCtaHref}>
									{primaryCtaLabel}
								</a>
								<a class="button button--secondary" href={contactCtaHref}>
									{contactCtaLabel}
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	) : null
}

<style>
	.hero-pin {
		position: relative;
	}

	.hero {
		--hero-header-clearance: clamp(5.75rem, 10svh, 7.5rem);
		--hero-content-bottom-space: clamp(1.5rem, 4svh, 2.75rem);
		--hero-content-nudge: 0rem;

		position: relative;
		min-height: 100svh;
		display: flex;
		overflow: hidden;
		background-color: var(--bg-primary);
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: transparent;
	}

	.hero__image {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		pointer-events: none;
		transition: transform 1.2s var(--ease-premium);
		will-change: transform;
	}

	.hero__image {
		z-index: 0;
		background-image: var(--hero-background-image), var(--hero-fallback-image);
		filter: brightness(1.28) saturate(1.04);
		opacity: 1;
	}

	.hero::after {
		content: "";
		position: absolute;
		pointer-events: none;
		z-index: 2;
	}

	.hero::after {
		inset: 0;
		background:
			radial-gradient(
				ellipse at 50% 38%,
				rgba(0, 0, 0, 0.2) 0%,
				rgba(0, 0, 0, 0.13) 34%,
				rgba(0, 0, 0, 0.03) 62%,
				rgba(0, 0, 0, 0) 76%
			),
			linear-gradient(
				to bottom,
				rgba(15, 17, 21, 0) 42%,
				rgba(15, 17, 21, 0.18) 68%,
				rgba(15, 17, 21, 0.36) 86%,
				rgba(15, 17, 21, 0.52) 100%
			);
	}

	.hero__container {
		position: relative;
		z-index: 3;
		width: min(100%, var(--page-max-width));
		min-height: 100svh;
		margin-inline: auto;
		padding: 0 var(--page-gutter) clamp(1.25rem, 3vw, 2rem);
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
	}

	.hero__body {
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--hero-header-clearance) 0 var(--hero-content-bottom-space);
		text-align: center;
	}

	.hero__content {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		max-width: min(100%, 56rem);
		transform: translateY(var(--hero-content-nudge));
	}

	.hero__content::before {
		content: "";
		position: absolute;
		z-index: -1;
		inset: clamp(-1.25rem, -2.4vw, -0.85rem) clamp(-1.5rem, -3.4vw, -1rem);
		background: radial-gradient(ellipse at center, rgba(8, 11, 16, 0.44) 0%, rgba(8, 11, 16, 0.3) 44%, rgba(8, 11, 16, 0) 72%);
		filter: blur(2px);
		pointer-events: none;
	}

	h1 .hero__project-heading--mobile,
	h1 .hero__mobile-supporting,
	.hero__lead .hero__lead-mobile,
	.button .button__label-mobile {
		display: none;
	}

	h1 {
		margin: 0;
		font-family: var(--font-body);
		font-size: clamp(2.05rem, 3.9vw, 3.85rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: 0;
		max-width: 100%;
		color: var(--surface-light);
		text-shadow:
			0 2px 10px rgba(0, 0, 0, 0.92),
			0 10px 34px rgba(0, 0, 0, 0.72);
	}

		h1 span,
		h1 strong {
			display: block;
			white-space: nowrap;
		}

		h1 strong {
			font-weight: 900;
		}

		h1 .hero__project-kicker,
		h1 .hero__intro-line,
		h1 .hero__intro-main {
			font-size: clamp(1.25rem, 2.45vw, 2.45rem);
			line-height: 1.08;
		}

		h1 .hero__project-kicker {
			font-weight: 400;
		}

		h1 .hero__project-heading {
			margin: clamp(0.12rem, 0.35vw, 0.28rem) 0 clamp(0.55rem, 1.2vw, 0.9rem);
			font-size: inherit;
			line-height: 1.02;
			white-space: normal;
		}

	h1::after {
		content: "";
		display: block;
		width: clamp(4.5rem, 12vw, 8rem);
		height: 2px;
		margin: clamp(0.9rem, 1.6vw, 1.2rem) auto 0;
		background: linear-gradient(
			90deg,
			rgba(199, 150, 67, 0),
			var(--accent-primary) 24%,
			var(--accent-primary) 76%,
			rgba(199, 150, 67, 0)
		);
		box-shadow: 0 2px 12px rgba(4, 8, 14, 0.5);
	}

	.hero__lead {
		margin: clamp(0.85rem, 1.4vw, 1.05rem) 0 0;
		max-width: 42rem;
		font-size: clamp(0.98rem, 1.15vw, 1.12rem);
		line-height: 1.58;
		color: rgba(245, 243, 238, 0.94);
		text-shadow:
			0 1px 8px rgba(0, 0, 0, 0.95),
			0 6px 24px rgba(0, 0, 0, 0.72);
	}

	.hero__lead strong {
		font-weight: 900;
		color: #fff;
	}

	.hero__actions {
		margin-top: 1.65rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.35rem;
		padding: 0.9rem 1.55rem;
		border: 1px solid transparent;
		font-size: 0.82rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium),
			border-color 220ms var(--ease-premium),
			color 220ms var(--ease-premium);
	}

	.button--primary {
		background-color: var(--accent-primary);
		color: var(--bg-primary);
		border-color: transparent;
	}

	.button--primary:hover {
		background-color: var(--accent-hover);
		transform: translateY(-2px);
	}

	.button--secondary {
		border-color: rgba(245, 243, 238, 0.7);
		color: var(--surface-light);
		background-color: transparent;
	}

	.button--secondary:hover {
		border-color: var(--accent-primary);
		color: var(--surface-light);
		background-color: rgba(15, 17, 21, 0.16);
		transform: translateY(-2px);
	}

	.hero:hover .hero__image {
		transform: scale(1.03);
	}

	.availability {
		background-color: transparent;
	}

	.availability__container {
		display: block;
	}

	.availability__actions {
		display: none;
	}

	.availability__grid {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
	}

	.availability__item {
		position: relative;
		margin: 0;
		padding: 1.65rem 1.6rem 1.7rem;
		border-left: 1px solid rgba(138, 144, 152, 0.28);
		text-align: center;
	}

	.availability__item::before {
		content: "";
		position: absolute;
		left: 1.6rem;
		right: 1.6rem;
		top: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			rgba(199, 150, 67, 0) 0%,
			rgba(199, 150, 67, 0.3) 20%,
			rgba(138, 144, 152, 0.34) 50%,
			rgba(199, 150, 67, 0.2) 80%,
			rgba(199, 150, 67, 0) 100%
		);
		opacity: 0.72;
		pointer-events: none;
	}

	.availability__item:first-child {
		border-left: 0;
	}

	.availability__item dt {
		margin: 0;
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.availability__item dd {
		margin: 0.55rem 0 0;
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 1.7vw, 1.5rem);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--accent-primary);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1024px) {
		.availability__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-aspect-ratio: 16 / 9) and (max-height: 820px) {
		.hero {
			--hero-header-clearance: clamp(4.75rem, 11svh, 6.25rem);
			--hero-content-bottom-space: clamp(1rem, 3svh, 1.75rem);
			--hero-content-nudge: 0.5rem;
		}

		h1 {
			font-size: clamp(1.95rem, 3.5vw, 3.35rem);
		}

		h1 .hero__project-kicker,
		h1 .hero__intro-line,
		h1 .hero__intro-main {
			font-size: clamp(1.12rem, 2.15vw, 2.05rem);
		}

		.hero__lead {
			max-width: 42rem;
			font-size: clamp(0.94rem, 1.08vw, 1.02rem);
		}

		.hero__actions {
			margin-top: 1.65rem;
		}
	}

	@media (max-aspect-ratio: 4 / 5) {
		.hero {
			--hero-header-clearance: clamp(5.25rem, 10svh, 7rem);
			--hero-content-bottom-space: clamp(1.4rem, 4svh, 2.4rem);
		}
	}

	@media (max-width: 860px) {
		.hero {
			--hero-header-clearance: clamp(4.75rem, 10svh, 5.75rem);
			--hero-content-bottom-space: clamp(1.1rem, 3svh, 1.75rem);
			--hero-content-nudge: clamp(-6.25rem, -9svh, -4.25rem);

			position: relative;
			min-height: 100svh;
			display: flex;
		}

		.hero__image {
			background-image: var(--hero-mobile-image), var(--hero-fallback-image);
			background-attachment: scroll;
			background-position: center center;
		}

		.hero__container {
			display: grid;
			grid-template-rows: 1fr;
			min-height: 100svh;
			padding-bottom: 0;
		}

		.hero__content {
			width: 100%;
			max-width: min(100%, 34rem);
			justify-items: center;
			padding-inline: 0.35rem;
			text-align: center;
		}

		.hero__content::before {
			display: none;
		}

		.hero::before {
			background: linear-gradient(
				to bottom,
				rgba(20, 35, 70, 0.35) 0%,
				rgba(20, 35, 70, 0.22) 38%,
				rgba(20, 35, 70, 0.05) 65%,
				rgba(20, 35, 70, 0) 100%
			);
		}

		.hero::after {
			background: none;
		}

		.hero__body {
			min-height: 100svh;
			align-items: center;
			justify-content: center;
			padding: var(--hero-header-clearance) 0 var(--hero-content-bottom-space);
			text-align: center;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(var(--hero-content-nudge));
		}

		h1 {
			width: 100%;
			font-size: clamp(2.05rem, 7.8vw, 2.75rem);
			max-width: 100%;
			color: #fff;
			-webkit-text-stroke: 0.45px rgba(15, 17, 21, 0.82);
			paint-order: stroke fill;
			text-shadow: none;
			text-align: center;
		}

		h1 span,
		h1 strong {
			white-space: normal;
			margin-inline: auto;
			text-wrap: balance;
		}

		h1 .hero__project-kicker {
			max-width: 24ch;
			font-size: clamp(1.05rem, 4vw, 1.35rem);
			line-height: 1.25;
			white-space: nowrap;
		}

		h1 .hero__project-heading--desktop,
		h1 .hero__intro-line--desktop,
		h1 .hero__intro-main--desktop,
		.hero__lead .hero__lead-desktop,
		.button .button__label-desktop {
			display: none;
		}

		h1 .hero__project-heading--mobile {
			display: grid;
			justify-items: center;
			gap: 0.08em;
		}

		h1 .hero__project-heading--mobile span {
			display: block;
		}

		h1 .hero__project-heading {
			max-width: 13ch;
			margin-left: auto;
			margin-right: auto;
		}

		h1 .hero__mobile-supporting {
			display: block;
			max-width: 21ch;
			margin-top: 0.72rem;
			font-size: clamp(1.18rem, 4.65vw, 1.58rem);
			font-weight: 700;
			line-height: 1.2;
		}

		.hero__lead .hero__lead-mobile,
		.button .button__label-mobile {
			display: inline;
		}

		.hero__lead {
			margin-top: clamp(0.9rem, 3svh, 1.15rem);
			max-width: 32ch;
			font-size: clamp(1rem, 3.7vw, 1.08rem);
			font-weight: 700;
			line-height: 1.55;
			color: #fff;
			-webkit-text-stroke: 0.2px rgba(15, 17, 21, 0.78);
			paint-order: stroke fill;
			text-shadow: none;
			text-align: center;
			text-wrap: balance;
		}

		h1::after {
			margin-left: auto;
			margin-right: auto;
			box-shadow: none;
		}

		.hero__actions {
			margin-top: clamp(1.15rem, 3.2svh, 1.45rem);
			width: 100%;
			max-width: 23rem;
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			justify-content: stretch;
			gap: 0.75rem;
		}

		.button {
			width: 100%;
			min-height: 3.25rem;
			padding: 0.78rem 0.55rem;
			font-size: clamp(0.61rem, 2.55vw, 0.68rem);
			line-height: 1.25;
			letter-spacing: 0.065em;
			text-align: center;
		}

		.button--secondary {
			border-color: rgba(15, 17, 21, 0.72);
			color: var(--bg-primary);
			background: rgba(245, 243, 238, 0.22);
		}

		.availability {
			display: none;
		}
	}

	@media (max-width: 420px) {
		.hero__content {
			max-width: min(100%, 21.5rem);
		}

		.hero__lead {
			max-width: 32ch;
		}
	}

	@media (max-width: 340px) {
		h1 span,
		h1 strong {
			white-space: normal;
		}

		h1 .hero__project-kicker {
			font-size: 0.92rem;
			white-space: nowrap;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}

		.hero__image {
			transition: none;
		}

		.availability__item {
			opacity: 1;
			transform: none;
			animation: none;
		}

		.button:hover,
		.hero:hover .hero__image {
			transform: none;
		}
	}
</style>
