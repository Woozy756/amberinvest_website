---
import type { HomepageHeroContent } from "../../sanity/homepage";

interface Props {
	content?: HomepageHeroContent | null;
}

const { content } = Astro.props;
const heroImage = content?.heroBackgroundImage?.asset?.url ?? "";
const availabilityMetrics = content?.metrics ?? [];
const primaryCtaLabel = "Skatīt dzīvokļus";
const primaryCtaHref = "/properties";
---

{
	content ? (
		<section class="hero" aria-labelledby="hero-title" style={`--hero-background-image: url("${heroImage}")`}>
			<div class="hero__container">
				<div class="hero__body">
					<div class="hero__content fade-in">
						<h1 id="hero-title">{content.heroTitle}</h1>
						<p class="hero__lead">{content.heroLead}</p>
						<div class="hero__actions">
							<a class="button button--primary" href={primaryCtaHref}>
								{primaryCtaLabel}
							</a>
						</div>
					</div>
				</div>

				<div class="availability" aria-labelledby="availability-title">
					<h2 id="availability-title" class="sr-only">{content.availabilityTitle}</h2>
					<div class="availability__container fade-in" data-reveal-delay="160">
						<dl class="availability__grid">
							{
								availabilityMetrics.map((metric, index) => (
									<div class="availability__item fade-in" data-reveal-delay={String(220 + index * 70)}>
										<dt>{metric.label}</dt>
										<dd>{metric.value}</dd>
									</div>
								))
							}
						</dl>
					</div>
				</div>
			</div>
		</section>
	) : null
}

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		overflow: hidden;
		background-color: var(--bg-primary);
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: var(--hero-background-image);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		opacity: 0.7;
		transition: transform 1.2s var(--ease-premium);
		will-change: transform;
	}

	.hero::after,
	.hero__container::before {
		content: "";
		position: absolute;
		pointer-events: none;
		z-index: 1;
	}

	.hero::after {
		inset: auto 0 0;
		height: clamp(13rem, 32svh, 23rem);
		background:
			linear-gradient(
				to bottom,
				rgba(15, 17, 21, 0) 0%,
				rgba(15, 17, 21, 0.34) 32%,
				rgba(15, 17, 21, 0.9) 62%,
				rgba(15, 17, 21, 1) 100%
			),
			linear-gradient(
				90deg,
				rgba(15, 17, 21, 0.62) 0%,
				rgba(15, 17, 21, 0.34) 35%,
				rgba(15, 17, 21, 0.08) 62%,
				rgba(15, 17, 21, 0.14) 100%
			);
	}

	.hero__container::before {
		top: 0;
		left: 50%;
		width: 100vw;
		height: clamp(5.5rem, 12svh, 8rem);
		transform: translateX(-50%);
		background: linear-gradient(
			to bottom,
			rgba(15, 17, 21, 0.68) 0%,
			rgba(15, 17, 21, 0.42) 34%,
			rgba(15, 17, 21, 0.08) 72%,
			rgba(15, 17, 21, 0) 100%
		);
	}

	.hero__container {
		position: relative;
		z-index: 2;
		width: min(100%, 1280px);
		min-height: 100svh;
		margin-inline: auto;
		padding: 0 clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2rem);
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
	}

	.hero__body {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: clamp(8rem, 12vw, 10rem) 0 clamp(3rem, 5vw, 4rem);
		text-align: center;
	}

	.hero__content {
		position: relative;
		display: grid;
		justify-items: center;
		max-width: min(100%, 42rem);
	}

	h1 {
		margin: 0;
		font-family: "Playfair Display", Georgia, serif;
		font-size: clamp(2.45rem, 5.2vw, 5.35rem);
		line-height: 0.98;
		letter-spacing: -0.012em;
		max-width: 18ch;
		color: var(--surface-light);
	}

	h1::after {
		content: "";
		display: block;
		width: clamp(4.5rem, 12vw, 8rem);
		height: 2px;
		margin: clamp(0.9rem, 1.6vw, 1.2rem) auto 0;
		background: linear-gradient(
			90deg,
			rgba(199, 150, 67, 0),
			var(--accent-primary) 24%,
			var(--accent-primary) 76%,
			rgba(199, 150, 67, 0)
		);
		box-shadow: 0 2px 12px rgba(4, 8, 14, 0.5);
	}

	.hero__lead {
		margin: clamp(0.95rem, 1.7vw, 1.25rem) 0 0;
		max-width: 38rem;
		font-size: clamp(1.02rem, 1.35vw, 1.18rem);
		line-height: 1.68;
		color: rgba(245, 243, 238, 0.94);
	}

	.hero__actions {
		margin-top: 2.15rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.9rem;
		padding: 0.72rem 1.2rem;
		border: 1px solid transparent;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		text-decoration: none;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium);
	}

	.button--primary {
		background-color: var(--accent-primary);
		color: var(--bg-primary);
		border-color: transparent;
	}

	.button--primary:hover {
		background-color: var(--accent-hover);
		transform: translateY(-2px);
	}

	.button--secondary {
		border-color: rgba(245, 243, 238, 0.46);
		color: var(--surface-light);
		background-color: rgba(15, 17, 21, 0.24);
	}

	.button--secondary:hover {
		border-color: var(--accent-primary);
		color: var(--text-secondary);
		transform: translateY(-2px);
	}

	.hero:hover::before {
		transform: scale(1.03);
	}

	.availability {
		background-color: transparent;
	}

	.availability__container {
		display: block;
	}

	.availability__grid {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
	}

	.availability__item {
		position: relative;
		margin: 0;
		padding: 1.65rem 1.6rem 1.7rem;
		border-left: 1px solid rgba(138, 144, 152, 0.28);
		text-align: center;
	}

	.availability__item::before {
		content: "";
		position: absolute;
		left: 1.6rem;
		right: 1.6rem;
		top: 0;
		height: 1px;
		background: linear-gradient(
			90deg,
			rgba(199, 150, 67, 0) 0%,
			rgba(199, 150, 67, 0.3) 20%,
			rgba(138, 144, 152, 0.34) 50%,
			rgba(199, 150, 67, 0.2) 80%,
			rgba(199, 150, 67, 0) 100%
		);
		opacity: 0.72;
		pointer-events: none;
	}

	.availability__item:first-child {
		border-left: 0;
	}

	.availability__item dt {
		margin: 0;
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.availability__item dd {
		margin: 0.55rem 0 0;
		font-family: "Playfair Display", Georgia, serif;
		font-size: clamp(1.15rem, 1.7vw, 1.5rem);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--accent-primary);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1024px) {
		.availability__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 860px) {
		.hero {
			min-height: 100svh;
		}

		.hero__container {
			min-height: 100svh;
			padding-bottom: 0;
		}

		.hero__content {
			max-width: min(100%, 34rem);
		}

		.hero__body {
			align-items: flex-start;
			justify-content: center;
			padding: clamp(7rem, 22vw, 8.5rem) 0 2.25rem;
		}

		h1 {
			font-size: clamp(2.45rem, 12vw, 4rem);
			max-width: 13ch;
		}

		.hero__lead {
			max-width: 31ch;
			font-size: 1rem;
		}

		.hero__actions {
			width: 100%;
			max-width: 22rem;
		}

		.button {
		}

		.availability__container {
			display: block;
		}

		.availability__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.availability__item:nth-child(odd) {
			border-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}

		.hero::before {
			transition: none;
		}

		.button:hover,
		.hero:hover::before {
			transform: none;
		}
	}
</style>
