---
import ContactForm from "./ContactForm.jsx";
import type { HomepageContactContent } from "../../sanity/homepage";
import type { Locale } from "../../i18n/translations";

interface Props {
	content?: HomepageContactContent | null;
	locale?: Locale;
}

const { content, locale = "lv" } = Astro.props;
const isEnglish = locale === "en";

const fallbackEyebrow = isEnglish ? "Get in touch" : "Piesakieties";
const fallbackTitle = isEnglish ? "Leave your contact details" : "Atstāj savus kontaktus";
const fallbackLead =
	isEnglish
		? "Leave your contact details and we will get in touch to arrange a viewing at a convenient time."
		: "Atstāj savu kontaktinformāciju, un mēs sazināsimies, lai vienotos par apskati Tev ērtā laikā.";
const fallbackBenefits = isEnglish ? [
	"Apartment viewing with our specialist",
	"We will respond within 24 hours",
	"We handle your personal data with care"
] : [
	"Dzīvokļu apskate ar mūsu speciālistu",
	"Atbildēsim uz Tavu pieteikumu 24 stundu laikā",
	"Mēs rūpējamies par Tavu datu drošību."
];
void content;
const eyebrow = fallbackEyebrow;
const title = fallbackTitle;
const lead = fallbackLead;
const benefits = fallbackBenefits;
---

<section class="contact-section" aria-labelledby="contact-section-title">
	<div class="contact-section__container">
		<div class="contact-section__layout">
			<div class="contact-section__content">
				<p class="contact-section__eyebrow fade-in">{eyebrow}</p>
				<h2 id="contact-section-title" class="contact-section__title fade-in" data-reveal-delay="70">
					{title}
				</h2>
				<p class="contact-section__lead fade-in" data-reveal-delay="130">
					{lead}
				</p>

				{benefits.length > 0 && (
					<ul class="contact-section__benefits" role="list">
						{benefits.map((benefit, index) => (
							<li class="contact-section__benefit fade-in" data-reveal-delay={String(190 + index * 60)}>
								<span class="contact-section__check" aria-hidden="true">
									<img src="/check-mark.svg" alt="" loading="lazy" width="14" height="14" />
								</span>
								<span>{benefit}</span>
							</li>
						))}
					</ul>
				)}
			</div>

			<div class="contact-section__form-wrap">
				<div class="contact-section__card contact-form-card">
					<ContactForm
						client:load
						locale={locale}
						title={isEnglish ? "Leave your contact details" : "Atstāj savus kontaktus"}
						intro=""
						submitLabel={isEnglish ? "Book a viewing" : "Pieteikties apskatei"}
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	.contact-section {
		position: relative;
		overflow: clip;
		scroll-margin-top: 5.5rem;
		background:
			radial-gradient(circle at top left, rgba(199, 150, 67, 0.14), transparent 34%),
			linear-gradient(180deg, #0f1115 0%, #131821 100%);
		color: var(--surface-light);
		padding: var(--section-space) 0;
	}

	.contact-section::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(199, 150, 67, 0.1) 0%, transparent 18%),
			repeating-linear-gradient(
				90deg,
				rgba(138, 144, 152, 0.04) 0,
				rgba(138, 144, 152, 0.04) 1px,
				transparent 1px,
				transparent 120px
			);
		opacity: 0.35;
		pointer-events: none;
	}

	.contact-section__container {
		position: relative;
		z-index: 1;
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding: 0 var(--page-gutter);
	}

	.contact-section__layout {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 0.9fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
	}

	.contact-section__content {
		max-width: 34rem;
	}

	.contact-section__eyebrow {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-primary);
	}

	.contact-section__title {
		margin: 1rem 0 0;
		font-family: var(--font-heading);
		font-size: clamp(2.15rem, 4.2vw, 4rem);
		line-height: 1.06;
		letter-spacing: -0.02em;
		max-width: 13ch;
		text-wrap: balance;
	}

	.contact-section__lead {
		margin: 1.25rem 0 0;
		max-width: 43ch;
		font-size: clamp(1rem, 1.3vw, 1.1rem);
		line-height: var(--copy-line-height);
		color: rgba(245, 243, 238, 0.72);
	}

	.contact-section__benefits {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.95rem;
	}

	.contact-section__benefit {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		font-size: 0.96rem;
		line-height: 1.55;
		color: rgba(245, 243, 238, 0.92);
	}

	.contact-section__check {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 0.95rem;
		height: 0.95rem;
	}

	.contact-section__check img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.contact-section__form-wrap {
		min-width: 0;
	}

	@media (max-width: 900px) {
		.contact-section__layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.contact-section {
			padding: var(--section-space) 0;
		}

		.contact-section__layout {
			gap: 2.35rem;
		}

		.contact-section__title {
			margin-top: 0.75rem;
			max-width: 12ch;
			font-size: clamp(2rem, 9.4vw, 2.55rem);
			line-height: 1.04;
		}

		.contact-section__lead {
			margin-top: 1rem;
			max-width: 35ch;
			font-size: 0.95rem;
			line-height: 1.65;
		}

		.contact-section__benefits {
			margin-top: 1.55rem;
			gap: 0.82rem;
		}

		.contact-section__benefit {
			align-items: flex-start;
			gap: 0.75rem;
			font-size: 0.9rem;
			line-height: 1.5;
		}

		.contact-section__card {
			padding: 1.15rem;
		}
	}
</style>
