---
import type { Locale } from "../../i18n/translations";

interface Props {
	locale?: Locale;
}

const { locale = "lv" } = Astro.props;
const isEnglish = locale === "en";
const locationBullets = isEnglish ? [
	"Kindergartens, schools, shops and everyday services nearby",
	"Convenient access to central Ventspils, the sea and key city destinations",
	"A well-kept and peaceful setting for families and professionals"
] : [
	"Tuvumā bērnudārzi, skolas, veikali un dažādi ikdienā nepieciešamie pakalpojumi",
	"Ērta nokļūšana līdz Ventspils centram, jūrai un pilsētas ikdienas galamērķiem",
	"Sakārtota, mierīga vide jaunām ģimenēm un speciālistiem"
];

const googleMapsQuery = "Talsu iela 3A, Ventspils, Latvia";
const googleMapsEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(googleMapsQuery)}&output=embed`;
---

<section id="project-location" class="project-location" aria-labelledby="project-location-title">
	<div class="project-location__container project-location__grid">
		<div class="project-location__copy fade-in">
			<p class="project-location__eyebrow">{isEnglish ? "Talsu Street 3A, Ventspils" : "Talsu iela 3A, Ventspils"}</p>
			<h2 id="project-location-title">{isEnglish ? "An ideal location" : "Ideāla atrašanās vieta"}</h2>
			<p>
				{isEnglish
					? "Talsu Street 3A is located in a convenient part of Ventspils, with easy access to city services, schools, shops and leisure opportunities."
					: "Talsu iela 3A atrodas Ventspilī, ērtā un ikdienai praktiskā vietā ar piekļuvi pilsētas pakalpojumiem, izglītības iestādēm, veikaliem un atpūtas iespējām."}
			</p>
			<ul class="project-location__list" role="list">
				{locationBullets.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</div>

		<div class="project-location__map fade-in" data-reveal-delay="140">
			<iframe
				title={isEnglish ? "Talsu Street 3A, Ventspils on Google Maps" : "Talsu iela 3A, Ventspils Google Maps"}
				src={googleMapsEmbedUrl}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
		</div>
	</div>
</section>

<style>
	.project-location {
		scroll-margin-top: 6rem;
		padding: var(--section-space-compact) 0;
		background: #f6f5f1;
		color: var(--bg-primary);
	}

	.project-location__container {
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding: 0 var(--page-gutter);
	}

	.project-location__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.project-location__copy {
		display: grid;
		gap: 1.25rem;
	}

	.project-location__eyebrow {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-primary);
	}

	.project-location__copy h2 {
		margin: 1rem 0 0.25rem;
		font-family: var(--font-heading);
		font-size: clamp(2.35rem, 5vw, 4.85rem);
		line-height: 1.02;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.project-location__copy p {
		margin: 0;
		font-size: clamp(1rem, 1.35vw, 1.12rem);
		line-height: var(--copy-line-height);
		color: rgba(15, 17, 21, 0.67);
	}

	.project-location__list {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.project-location__list li {
		position: relative;
		padding-left: 1.35rem;
		font-weight: 900;
		line-height: 1.55;
		color: rgba(15, 17, 21, 0.78);
	}

	.project-location__list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--accent-primary);
		transform: translateY(-50%);
	}

	.project-location__map {
		min-width: 0;
		background: #0f1115;
		border: 1px solid rgba(15, 17, 21, 0.14);
		box-shadow: 0 24px 80px rgba(15, 17, 21, 0.14);
	}

	.project-location__map iframe {
		width: 100%;
		height: clamp(24rem, 42vw, 36rem);
		display: block;
		border: 0;
		filter: grayscale(1) saturate(0) contrast(1.06);
	}

	@media (max-width: 980px) {
		.project-location__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.project-location {
			padding: var(--section-space-compact) 0;
		}

		.project-location__grid {
			gap: 2.25rem;
		}

		.project-location__copy {
			gap: 1rem;
		}

		.project-location__copy h2 {
			margin: 0.45rem 0 0.1rem;
			max-width: 12ch;
			font-size: clamp(2.1rem, 10vw, 2.75rem);
			line-height: 1.04;
		}

		.project-location__copy p {
			max-width: 36ch;
			font-size: 0.96rem;
			line-height: 1.66;
		}

		.project-location__list {
			margin-top: 0.2rem;
			gap: 0.88rem;
		}

		.project-location__list li {
			padding-left: 1.15rem;
			font-size: 0.92rem;
			line-height: 1.48;
		}

		.project-location__map iframe {
			height: auto;
			aspect-ratio: 4 / 5;
		}
	}
</style>
