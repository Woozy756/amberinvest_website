---
import PropertyCard from "../properties/PropertyCard.astro";
import BenefitsStrip from "../shared/BenefitsStrip.astro";
import type { Property } from "../../sanity/properties";
import type { Locale } from "../../i18n/translations";

interface Props {
	content?: unknown;
	featuredProperties?: Property[];
	locale?: Locale;
}

const { featuredProperties = [], locale = "lv" } = Astro.props as Props;
const isEnglish = locale === "en";

const overviewImage = "/images/interior-kitchen-dining.jpeg";
const ctaBackgroundImage =
	"https://cdn.sanity.io/images/kshtq64w/production/76c3705983f5afede7215f479d0f3fa46abcea0b-1290x1288.jpg?auto=format&fit=crop&w=1800&q=85";

const ctaItems = isEnglish ? [
	{
		title: "We prepare suitable options",
		body: "Before the viewing, we can prepare several apartments suited to your needs and budget."
	},
	{
		title: "We support your financing",
		body: "We provide the documents required by banks and other credit institutions."
	},
	{
		title: "We reserve your apartment",
		body: "Once you have chosen the right apartment, we arrange a reservation while you complete the next steps."
	}
] : [
	{
		title: "Sagatavojam variantus",
		body: "Pirms apskates varam sagatavot vairākus Jūsu vajadzībām un budžetam piemērotus dzīvokļus."
	},
	{
		title: "Palīdzam iegūt finansējumu",
		body: "Nodrošinām nepieciešamos dokumentus finansējuma saņemšanai kredītiestādēs."
	},
	{
		title: "Rezervējam dzīvokli",
		body: "Kad esat atradis piemērotāko dzīvokli, veicam rezervāciju nākamo soļu sakārtošanai."
	}
];
const overviewFacts = isEnglish ? [
	"Each apartment has individual electricity, heating and water meters.",
	"The building is insulated for energy-efficient everyday living.",
	"The land beneath the building is privately owned; the apartment includes a proportional undivided share of the land."
] : [
	"Katram dzīvoklim ir savi elektrības, apkures un ūdens skaitītāji.",
	"Ēka ir siltināta, lai mājoklis būtu energoefektīvs ikdienā.",
	"Zeme zem mājas ir privāts īpašums; iegādājoties dzīvokli, īpašumā ietilpst arī domājamā daļa no zemes."
];
---

<section class="project-overview" aria-labelledby="project-overview-title">
	<div class="project-overview__container project-overview__grid">
		<div class="project-overview__heading-block fade-in">
			<p class="project-overview__eyebrow">{isEnglish ? "New apartment development in Ventspils" : "Jauns daudzdzīvokļu projekts Ventspilī"}</p>
			<h2 id="project-overview-title">
				<span>“AmberHome”</span>
				<span>{isEnglish ? "Talsu Street 3A" : "Talsu iela 3A"}</span>
			</h2>

			<div class="project-overview__copy" data-reveal-delay="120">
				<p class="project-overview__lead">
					<span class="project-overview__lead-primary">
						{isEnglish ? "An excellent location at " : "Lieliska lokācija "}<a class="project-overview__address-link" href="#project-location">{isEnglish ? "Talsu Street 3A, Ventspils" : "Talsu ielā 3A, Ventspilī"}</a>{isEnglish ? "," : ","}
					</span>
					<span class="project-overview__lead-secondary">{isEnglish ? "with everyday essentials within easy reach." : "kur ikdienai nepieciešamais ir ērti sasniedzams."}</span>
				</p>
				<figure class="project-overview__image project-overview__image--mobile fade-in" data-reveal-delay="140">
					<img
						src={overviewImage}
						alt={isEnglish ? "Bright open-plan living room and kitchen" : "Dzīvojamā telpa ar virtuvi gaišā apdarē"}
						width="1290"
						height="1284"
						loading="lazy"
					/>
				</figure>
				<p>
					{isEnglish
						? "Three, four and five-room apartments from 53 to 90 m², with carefully considered layouts and fully finished interiors ready to enjoy."
						: "3, 4 un 5 istabu dzīvokļi ar pārdomātu plānojumu no 53 līdz 90 m² un pilnībā pabeigtu apdari, lai jaunās mājas varētu sākt baudīt bez liekām rūpēm."}
				</p>
				<ul class="project-overview__facts" role="list">
					{overviewFacts.map((fact) => (
						<li>{fact}</li>
					))}
				</ul>
				<div class="project-overview__actions">
					<a class="project-overview__button" href={isEnglish ? "/en/contact" : "/kontakti"}>{isEnglish ? "Contact us" : "Sazinies ar mums"}</a>
					<a class="project-overview__button project-overview__button--secondary" href={isEnglish ? "/en/about-the-building" : "/par-eku"}>{isEnglish ? "About the building" : "Par Ēku"}</a>
				</div>
			</div>
		</div>

		<figure class="project-overview__image project-overview__image--desktop fade-in" data-reveal-delay="140">
			<img
				src={overviewImage}
				alt={isEnglish ? "Bright open-plan living room and kitchen" : "Dzīvojamā telpa ar virtuvi gaišā apdarē"}
				width="1290"
				height="1284"
				loading="lazy"
			/>
		</figure>

		<BenefitsStrip placement="home" locale={locale} class="project-benefits--desktop fade-in" data-reveal-delay="180" />
	</div>
</section>

{
	featuredProperties.length > 0 ? (
		<section class="project-apartments" aria-labelledby="project-apartments-title">
			<div class="project-apartments__container">
				<header class="project-apartments__header fade-in">
					<h2 id="project-apartments-title">{isEnglish ? "Available apartments" : "Pieejamie dzīvokļi"}</h2>
				</header>

				<ul class="project-apartments__grid" role="list">
					{featuredProperties.map((property, index) => (
						<li>
							<PropertyCard
								property={property}
								index={index}
								showPrice={false}
								locale={locale}
								ctaHref={isEnglish ? "/en/apartments" : "/dzīvokļi"}
								ctaLabel={isEnglish ? "View apartments" : "Apskaties dzīvokļus"}
							/>
						</li>
					))}
				</ul>
			</div>
		</section>
	) : null
}

<div class="project-benefits-mobile">
	<BenefitsStrip placement="home" locale={locale} class="project-benefits--mobile fade-in" data-reveal-delay="180" />
</div>

<section class="project-cta" aria-labelledby="project-cta-title" data-project-cta>
	<div class="project-cta__background" style={`--cta-background-image: url("${ctaBackgroundImage}")`} aria-hidden="true"></div>
	<div class="project-cta__container">
		<div class="project-cta__content fade-in">
			<h2 id="project-cta-title">{isEnglish ? "Take the next step" : "Piesakies jau tagad"}</h2>
			<div class="project-cta__row">
				<ul class="project-cta__items" role="list">
					{ctaItems.map((item, index) => (
						<li class="project-cta__item">
							<span class="project-cta__number">0{index + 1}</span>
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</li>
					))}
				</ul>
				<a class="project-cta__button" href={isEnglish ? "/en/contact" : "/kontakti"}>
					{isEnglish ? "Contact us" : "Sazinies ar mums"}
				</a>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	const projectCta = document.querySelector('[data-project-cta]');

	if (projectCta) {
		let ctaFrame = 0;

		const updateProjectCta = () => {
			ctaFrame = 0;
			const rect = projectCta.getBoundingClientRect();
			const viewportHeight = window.innerHeight || 1;
			const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
			const offset = Math.round((progress - 0.5) * 240);

			projectCta.style.setProperty('--cta-bg-y', `${offset}px`);
		};

		const requestProjectCta = () => {
			if (ctaFrame) return;
			ctaFrame = window.requestAnimationFrame(updateProjectCta);
		};

		updateProjectCta();
		window.addEventListener('scroll', requestProjectCta, { passive: true });
		window.addEventListener('resize', requestProjectCta);
	}
</script>

<style>
	.project-overview {
		scroll-margin-top: 5.25rem;
		background: var(--surface-light);
		color: var(--bg-primary);
		padding: var(--section-space) 0 var(--section-space-compact);
	}

	.project-overview__container {
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding: 0 var(--page-gutter);
	}

	.project-overview__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.project-overview__heading-block {
		min-width: 0;
		display: grid;
		gap: clamp(1.15rem, 2.4vw, 1.85rem);
	}

	.project-overview__eyebrow {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent-primary);
	}

	.project-overview__heading-block h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2.45rem, 5vw, 4.85rem);
		line-height: 1.02;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.project-overview__heading-block h2 span {
		display: block;
	}

	.project-overview__image {
		position: relative;
		overflow: hidden;
		margin: 0;
		aspect-ratio: 1 / 1;
		align-self: center;
		background: #e8e3da;
		box-shadow: 0 24px 80px rgba(15, 17, 21, 0.14);
	}

	.project-overview__image--mobile,
	.project-benefits-mobile {
		display: none;
	}

	.project-overview__image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
	}

	.project-overview__copy {
		min-width: 0;
		display: grid;
		gap: clamp(1rem, 2vw, 1.25rem);
		max-width: 38rem;
		padding-top: 0.2rem;
		font-size: clamp(1rem, 1.22vw, 1.12rem);
		line-height: var(--copy-line-height);
		color: rgba(15, 17, 21, 0.68);
	}

	.project-overview__copy p {
		margin: 0;
	}

	.project-overview__facts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.68rem;
	}

	.project-overview__facts li {
		position: relative;
		padding-left: 1.18rem;
		font-size: clamp(0.94rem, 1.02vw, 1rem);
		font-weight: 700;
		line-height: 1.48;
		color: rgba(15, 17, 21, 0.76);
	}

	.project-overview__facts li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.75em;
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--accent-primary);
		transform: translateY(-50%);
	}

	.project-overview__lead {
		font-size: clamp(1.28rem, 1.82vw, 1.75rem);
		font-weight: 700;
		line-height: 1.32;
		color: var(--bg-primary);
		text-wrap: balance;
	}

	.project-overview__lead-primary {
		display: inline;
		white-space: normal;
	}

	.project-overview__lead-secondary {
		display: inline;
	}

	.project-overview__address-link {
		color: #0077b6;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.12em;
		white-space: nowrap;
		transition:
			color 220ms var(--ease-premium);
	}

	.project-overview__address-link:hover,
	.project-overview__address-link:focus-visible {
		color: var(--accent-primary);
	}

	.project-overview__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.72rem;
		align-items: center;
	}

	.project-overview__button {
		min-width: clamp(10.6rem, 15vw, 13.9rem);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.8rem;
		padding: 1rem 1.7rem;
		border-radius: 999px;
		border: 1px solid var(--accent-primary);
		background: var(--accent-primary);
		color: var(--bg-primary);
		font-size: 0.88rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium),
			border-color 220ms var(--ease-premium);
	}

	.project-overview__button:hover,
	.project-overview__button:focus-visible {
		transform: translateY(-2px);
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.project-overview__button--secondary {
		background: transparent;
		color: var(--bg-primary);
		border-color: rgba(15, 17, 21, 0.78);
	}

	.project-overview__button--secondary:hover,
	.project-overview__button--secondary:focus-visible {
		background: rgba(15, 17, 21, 0.06);
		border-color: var(--bg-primary);
	}

	.project-apartments {
		background:
			linear-gradient(180deg, var(--surface-light) 0%, #f0eadf 100%);
		color: var(--bg-primary);
		padding: clamp(2.3rem, 4.4vw, 3.6rem) 0 clamp(3.4rem, 6vw, 5rem);
	}

	.project-apartments__container {
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding: 0 var(--page-gutter);
	}

	.project-apartments__header {
		margin-bottom: clamp(1.35rem, 2.6vw, 2rem);
		padding-top: clamp(1.35rem, 2.4vw, 1.8rem);
		border-top: 1px solid rgba(35, 38, 43, 0.12);
	}

	.project-apartments__header h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2.05rem, 3.8vw, 3.7rem);
		line-height: 1.04;
		letter-spacing: 0;
	}

	.project-apartments__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.95rem, 1.7vw, 1.35rem);
	}

	.project-apartments__grid li {
		min-width: 0;
	}

	.project-apartments :global(.property-card) {
		border-color: rgba(35, 38, 43, 0.12);
		border-radius: 0.35rem;
		background: rgba(255, 255, 255, 0.88);
		box-shadow: 0 18px 46px rgba(15, 17, 21, 0.07);
		overflow: hidden;
	}

	.project-apartments :global(.property-card:hover),
	.project-apartments :global(.property-card:focus-within) {
		box-shadow: 0 22px 54px rgba(15, 17, 21, 0.11);
	}

	.project-apartments :global(.property-card__media) {
		aspect-ratio: 1.24;
	}

	.project-apartments :global(.property-card__status) {
		top: 0.85rem;
		left: 0.85rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
	}

	.project-apartments :global(.property-card__body) {
		gap: 0.8rem;
		padding: 1.08rem 1.08rem 1.18rem;
	}

	.project-apartments :global(.property-card__location) {
		font-size: 0.62rem;
	}

	.project-apartments :global(.property-card__title) {
		font-size: clamp(1.28rem, 1.55vw, 1.55rem);
		line-height: 1.08;
		letter-spacing: 0;
	}

	.project-apartments :global(.property-card__details) {
		gap: 0.6rem;
		padding-top: 0.85rem;
	}

	.project-apartments :global(.property-card__details dt) {
		font-size: 0.58rem;
	}

	.project-apartments :global(.property-card__details dd) {
		margin-top: 0.25rem;
		font-size: 0.96rem;
	}

	.project-apartments :global(.property-card__footer) {
		gap: 0.75rem;
		padding-top: 0.85rem;
	}

	.project-apartments :global(.property-card__price) {
		font-size: clamp(1.38rem, 1.75vw, 1.7rem);
	}

	.project-apartments :global(.property-card__cta) {
		min-height: 2.85rem;
		padding: 0.65rem 1rem;
		border-radius: 999px;
		white-space: nowrap;
	}

		.project-cta {
		--cta-bg-y: 0px;

		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: clamp(30rem, 58vw, 43rem);
		display: grid;
		align-items: center;
		color: var(--surface-light);
	}

	.project-cta__background {
		position: absolute;
		inset: -12%;
		z-index: -2;
		background:
			linear-gradient(90deg, rgba(15, 17, 21, 0.76) 0%, rgba(15, 17, 21, 0.42) 56%, rgba(15, 17, 21, 0.68) 100%),
			var(--cta-background-image) center / cover no-repeat;
		transform: translate3d(0, var(--cta-bg-y), 0) scale(1.13);
		will-change: transform;
	}

	.project-cta::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, rgba(15, 17, 21, 0.12), rgba(15, 17, 21, 0.44));
		pointer-events: none;
	}

	.project-cta__container {
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding: var(--section-space) var(--page-gutter);
	}

	.project-cta__content {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.project-cta h2 {
		margin: 0;
		max-width: 18ch;
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 5vw, 4.75rem);
		line-height: 1.02;
		letter-spacing: 0;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.48);
	}

	.project-cta__row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: clamp(1.75rem, 4vw, 3rem);
		align-items: center;
	}

	.project-cta__items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		background: transparent;
	}

	.project-cta__item {
		min-height: 10rem;
		padding: clamp(1.2rem, 2vw, 1.6rem);
		display: grid;
		align-content: start;
		background: transparent;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
	}

	.project-cta__number {
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		color: #b9edf6;
	}

	.project-cta__item h3 {
		margin: 1.25rem 0 0;
		font-size: clamp(1.45rem, 2.35vw, 2rem);
		line-height: 1.05;
	}

	.project-cta__item p {
		margin: 0.65rem 0 0;
		max-width: 18rem;
		font-size: clamp(1rem, 1.4vw, 1.18rem);
		line-height: 1.35;
	}

	.project-cta__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: center;
		justify-self: center;
		gap: 0.75rem;
		min-height: 3.7rem;
		padding: 1rem 1.65rem;
		border-radius: 999px;
		background: var(--surface-light);
		color: var(--bg-primary);
		font-weight: 900;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: 0 18px 60px rgba(0, 0, 0, 0.26);
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium);
	}

	.project-cta__button:hover,
	.project-cta__button:focus-visible {
		transform: translateY(-2px);
		background: var(--accent-primary);
	}

		@media (max-width: 980px) {
			.project-overview__grid {
				grid-template-columns: 1fr;
			}

		.project-overview__copy {
			padding-top: 0;
		}

			.project-overview__image {
				max-width: 42rem;
			}

		.project-apartments__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

			.project-cta__row,
			.project-cta__items {
				grid-template-columns: 1fr;
		}

		.project-cta__button {
			width: fit-content;
		}
	}

		@media (max-width: 720px) {
		.project-overview {
			scroll-margin-top: 4.8rem;
			padding: var(--section-space-compact) 0 0;
		}

		.project-overview__grid {
			display: flex;
			flex-direction: column;
			gap: clamp(1.4rem, 4vw, 1.75rem);
		}

		.project-overview__heading-block {
			gap: 0.9rem;
		}

		.project-overview__eyebrow {
			max-width: 32rem;
			font-size: 0.72rem;
			line-height: 1.45;
			letter-spacing: 0.14em;
		}

		.project-overview__image {
			aspect-ratio: 1.18;
			width: 100%;
			max-width: 100%;
			justify-self: stretch;
		}

		.project-overview__image--desktop,
		:global(.project-benefits--desktop) {
			display: none;
		}

		.project-overview__image--mobile {
			display: block;
			margin-block: 0.35rem 0.15rem;
		}

		.project-benefits-mobile {
			display: block;
			padding: 0 0 var(--section-space-compact);
			background: linear-gradient(180deg, #f0eadf 0%, var(--surface-light) 100%);
		}

		.project-benefits-mobile :global(.project-benefits--mobile) {
			margin-top: 0;
		}

		.project-apartments {
			padding: 0 0 var(--section-space-compact);
		}

		.project-apartments__header {
			margin-bottom: 1.2rem;
			padding-top: 1.5rem;
			text-align: left;
		}

		.project-apartments__grid {
			grid-template-columns: 1fr;
			gap: 1.05rem;
		}

