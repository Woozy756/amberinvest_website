---
import PropertyCard from "../properties/PropertyCard.astro";
import BenefitsStrip from "../shared/BenefitsStrip.astro";
import type { Property } from "../../sanity/properties";

interface Props {
	content?: unknown;
	featuredProperties?: Property[];
	locale?: string;
}

const { featuredProperties = [] } = Astro.props as Props;

const overviewImage = "/images/interior-kitchen-dining.jpeg";
const ctaBackgroundImage =
	"https://cdn.sanity.io/images/kshtq64w/production/76c3705983f5afede7215f479d0f3fa46abcea0b-1290x1288.jpg?auto=format&fit=crop&w=1800&q=85";

const ctaItems = [
	{
		title: "Mēs sazināsimies ar Jums",
		body: "Atstājiet kontaktinformāciju, un mūsu speciālists ar Jums sazināsies."
	},
	{
		title: "Sarunāt dzīvokļu apskati",
		body: "Vienosimies par kopīgas apskates laiku, kas jums ir ērts."
	},
	{
		title: "Un izvēlētos piemērotāko dzīvokli",
		body: "Palīdzēsim salīdzināt plānojumus, cenas un atrast piemērotāko dzīvokli."
	}
];
---

<section class="project-overview" aria-labelledby="project-overview-title">
	<div class="project-overview__container project-overview__grid">
		<div class="project-overview__heading-block fade-in">
			<p class="project-overview__eyebrow">Jauns daudzdzīvokļu projekts Ventspilī</p>
			<h2 id="project-overview-title">
				<span>Tavas jaunās mājas</span>
				<span>Ventspilī</span>
			</h2>

			<div class="project-overview__copy" data-reveal-delay="120">
				<p class="project-overview__lead">
					<span class="project-overview__lead-primary">
						Lieliska lokācija <a class="project-overview__address-link" href="#project-location">Talsu ielā 3A, Ventspilī</a>,
					</span>
					<span class="project-overview__lead-secondary">kur ikdienai nepieciešamais ir ērti sasniedzams.</span>
				</p>
				<p>
					2-5 istabu dzīvokļi ar pārdomātu plānojumu no 53 līdz 90 m² un pilnībā pabeigtu apdari, lai jaunās mājas varētu sākt baudīt bez liekām rūpēm.
				</p>
				<a class="project-overview__button" href="/contact">Sazinies ar mums</a>
			</div>
		</div>

		<figure class="project-overview__image fade-in" data-reveal-delay="140">
			<img
				src={overviewImage}
				alt="Dzīvojamā telpa ar virtuvi gaišā apdarē"
				width="1290"
				height="1284"
				loading="lazy"
			/>
		</figure>

		<BenefitsStrip placement="home" class="fade-in" data-reveal-delay="180" />
	</div>
</section>

{
	featuredProperties.length > 0 ? (
		<section class="project-apartments" aria-labelledby="project-apartments-title">
			<div class="project-apartments__container">
				<header class="project-apartments__header fade-in">
					<h2 id="project-apartments-title">Pieejamie dzīvokļi</h2>
				</header>

				<ul class="project-apartments__grid" role="list">
					{featuredProperties.map((property, index) => (
						<li>
							<PropertyCard
								property={property}
								index={index}
								showPrice={false}
								ctaHref="/properties"
								ctaLabel="Apskaties dzīvokļus"
							/>
						</li>
					))}
				</ul>
			</div>
		</section>
	) : null
}

<section class="project-cta" aria-labelledby="project-cta-title" data-project-cta>
	<div class="project-cta__background" style={`--cta-background-image: url("${ctaBackgroundImage}")`} aria-hidden="true"></div>
	<div class="project-cta__container">
		<div class="project-cta__content fade-in">
			<h2 id="project-cta-title">Piesakies jau tagad</h2>
			<div class="project-cta__row">
				<ul class="project-cta__items" role="list">
					{ctaItems.map((item, index) => (
						<li class="project-cta__item">
							<span class="project-cta__number">0{index + 1}</span>
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</li>
					))}
				</ul>
				<a class="project-cta__button" href="/contact">
					Sazinies ar mums
				</a>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	const projectCta = document.querySelector('[data-project-cta]');

	if (projectCta) {
		let ctaFrame = 0;

		const updateProjectCta = () => {
			ctaFrame = 0;
			const rect = projectCta.getBoundingClientRect();
			const viewportHeight = window.innerHeight || 1;
			const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
			const offset = Math.round((progress - 0.5) * 240);

			projectCta.style.setProperty('--cta-bg-y', `${offset}px`);
		};

		const requestProjectCta = () => {
			if (ctaFrame) return;
			ctaFrame = window.requestAnimationFrame(updateProjectCta);
		};

		updateProjectCta();
		window.addEventListener('scroll', requestProjectCta, { passive: true });
		window.addEventListener('resize', requestProjectCta);
	}
</script>

<style>
	.project-overview {
		scroll-margin-top: 5.25rem;
		background: var(--surface-light);
		color: var(--bg-primary);
		padding: clamp(4.75rem, 7vw, 6.25rem) 0 clamp(3.2rem, 5vw, 4.4rem);
	}

	.project-overview__container {
		width: min(100%, 1280px);
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 4vw, 3rem);
	}

	.project-overview__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.project-overview__heading-block {
		min-width: 0;
		display: grid;
		gap: clamp(1.35rem, 2.8vw, 2rem);
	}

	.project-overview__eyebrow {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-primary);
	}

	.project-overview__heading-block h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2.45rem, 5vw, 4.85rem);
		line-height: 1.02;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.project-overview__heading-block h2 span {
		display: block;
	}

	.project-overview__image {
		position: relative;
		overflow: hidden;
		margin: 0;
		aspect-ratio: 1 / 1;
		align-self: center;
		background: #e8e3da;
		box-shadow: 0 24px 80px rgba(15, 17, 21, 0.14);
	}

	.project-overview__image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
	}

	.project-overview__copy {
		min-width: 0;
		display: grid;
		gap: 1.25rem;
		max-width: 40rem;
		padding-top: 0.45rem;
		font-size: clamp(1.02rem, 1.35vw, 1.18rem);
		line-height: 1.78;
		color: rgba(15, 17, 21, 0.68);
	}

	.project-overview__copy p {
		margin: 0;
	}

	.project-overview__lead {
		font-size: clamp(1.35rem, 2.1vw, 2rem);
		font-weight: 700;
		line-height: 1.3;
		color: var(--bg-primary);
	}

	.project-overview__lead-primary {
		display: inline-block;
		white-space: nowrap;
	}

	.project-overview__lead-secondary {
		display: inline;
	}

	.project-overview__address-link {
		color: #0077b6;
		text-decoration: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.12em;
		transition:
			color 220ms var(--ease-premium);
	}

	.project-overview__address-link:hover,
	.project-overview__address-link:focus-visible {
		color: var(--accent-primary);
	}

	.project-overview__button {
		width: fit-content;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.85rem;
		padding: 1rem 1.85rem;
		border-radius: 999px;
		border: 1px solid var(--accent-primary);
		background: var(--accent-primary);
		color: var(--bg-primary);
		font-size: 0.88rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium),
			border-color 220ms var(--ease-premium);
	}

	.project-overview__button:hover,
	.project-overview__button:focus-visible {
		transform: translateY(-2px);
		background: var(--accent-hover);
		border-color: var(--accent-hover);
	}

	.project-apartments {
		background:
			linear-gradient(180deg, var(--surface-light) 0%, #f0eadf 100%);
		color: var(--bg-primary);
		padding: clamp(2.3rem, 4.4vw, 3.6rem) 0 clamp(3.4rem, 6vw, 5rem);
	}

	.project-apartments__container {
		width: min(100%, 1280px);
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 4vw, 3rem);
	}

	.project-apartments__header {
		margin-bottom: clamp(1.35rem, 2.6vw, 2rem);
		padding-top: clamp(1.35rem, 2.4vw, 1.8rem);
		border-top: 1px solid rgba(35, 38, 43, 0.12);
	}

	.project-apartments__header h2 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2.05rem, 3.8vw, 3.7rem);
		line-height: 1.04;
		letter-spacing: 0;
	}

	.project-apartments__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.95rem, 1.7vw, 1.35rem);
	}

	.project-apartments__grid li {
		min-width: 0;
	}

	.project-apartments :global(.property-card) {
		border-color: rgba(35, 38, 43, 0.12);
		border-radius: 0.35rem;
		background: rgba(255, 255, 255, 0.88);
		box-shadow: 0 18px 46px rgba(15, 17, 21, 0.07);
		overflow: hidden;
	}

	.project-apartments :global(.property-card:hover),
	.project-apartments :global(.property-card:focus-within) {
		box-shadow: 0 22px 54px rgba(15, 17, 21, 0.11);
	}

	.project-apartments :global(.property-card__media) {
		aspect-ratio: 1.24;
	}

	.project-apartments :global(.property-card__status) {
		top: 0.85rem;
		left: 0.85rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
	}

	.project-apartments :global(.property-card__body) {
		gap: 0.8rem;
		padding: 1.08rem 1.08rem 1.18rem;
	}

	.project-apartments :global(.property-card__location) {
		font-size: 0.62rem;
	}

	.project-apartments :global(.property-card__title) {
		font-size: clamp(1.28rem, 1.55vw, 1.55rem);
		line-height: 1.08;
		letter-spacing: 0;
	}

	.project-apartments :global(.property-card__details) {
		gap: 0.6rem;
		padding-top: 0.85rem;
	}

	.project-apartments :global(.property-card__details dt) {
		font-size: 0.58rem;
	}

	.project-apartments :global(.property-card__details dd) {
		margin-top: 0.25rem;
		font-size: 0.96rem;
	}

	.project-apartments :global(.property-card__footer) {
		gap: 0.75rem;
		padding-top: 0.85rem;
	}

	.project-apartments :global(.property-card__price) {
		font-size: clamp(1.38rem, 1.75vw, 1.7rem);
	}

	.project-apartments :global(.property-card__cta) {
		min-height: 2.85rem;
		padding: 0.65rem 1rem;
		border-radius: 999px;
		white-space: nowrap;
	}

		.project-cta {
		--cta-bg-y: 0px;

		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: clamp(30rem, 58vw, 43rem);
		display: grid;
		align-items: center;
		color: var(--surface-light);
	}

	.project-cta__background {
		position: absolute;
		inset: -12%;
		z-index: -2;
		background:
			linear-gradient(90deg, rgba(15, 17, 21, 0.76) 0%, rgba(15, 17, 21, 0.42) 56%, rgba(15, 17, 21, 0.68) 100%),
			var(--cta-background-image) center / cover no-repeat;
		transform: translate3d(0, var(--cta-bg-y), 0) scale(1.13);
		will-change: transform;
	}

	.project-cta::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, rgba(15, 17, 21, 0.12), rgba(15, 17, 21, 0.44));
		pointer-events: none;
	}

	.project-cta__container {
		width: min(100%, 1280px);
		margin: 0 auto;
		padding: clamp(4rem, 7vw, 6rem) clamp(1.5rem, 4vw, 3rem);
	}

	.project-cta__content {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.project-cta h2 {
		margin: 0;
		max-width: 18ch;
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 5vw, 4.75rem);
		line-height: 1.02;
		letter-spacing: 0;
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.48);
	}

	.project-cta__row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: clamp(1.75rem, 4vw, 3rem);
		align-items: center;
	}

	.project-cta__items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		background: transparent;
	}

	.project-cta__item {
		min-height: 10rem;
		padding: clamp(1.2rem, 2vw, 1.6rem);
		display: grid;
		align-content: start;
		background: transparent;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
	}

	.project-cta__number {
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		color: #b9edf6;
	}

	.project-cta__item h3 {
		margin: 1.25rem 0 0;
		font-size: clamp(1.45rem, 2.35vw, 2rem);
		line-height: 1.05;
	}

	.project-cta__item p {
		margin: 0.65rem 0 0;
		max-width: 18rem;
		font-size: clamp(1rem, 1.4vw, 1.18rem);
		line-height: 1.35;
	}

	.project-cta__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: center;
		justify-self: center;
		gap: 0.75rem;
		min-height: 3.7rem;
		padding: 1rem 1.65rem;
		border-radius: 999px;
		background: var(--surface-light);
		color: var(--bg-primary);
		font-weight: 900;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: 0 18px 60px rgba(0, 0, 0, 0.26);
		transition:
			transform 220ms var(--ease-premium),
			background-color 220ms var(--ease-premium);
	}

	.project-cta__button:hover,
	.project-cta__button:focus-visible {
		transform: translateY(-2px);
		background: var(--accent-primary);
	}

		@media (max-width: 980px) {
			.project-overview__grid {
				grid-template-columns: 1fr;
			}

		.project-overview__copy {
			padding-top: 0;
		}

			.project-overview__image {
				max-width: 42rem;
			}

		.project-apartments__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

			.project-cta__row,
			.project-cta__items {
				grid-template-columns: 1fr;
		}

		.project-cta__button {
			width: fit-content;
		}
	}

		@media (max-width: 720px) {
		.project-overview {
			scroll-margin-top: 4.8rem;
			padding: 4.5rem 0 3rem;
		}

		.project-overview__grid {
			display: flex;
			flex-direction: column;
			gap: clamp(1.35rem, 4.5vw, 1.8rem);
		}

		.project-overview__heading-block {
			gap: clamp(1rem, 3vw, 1.25rem);
		}

		.project-overview__image {
			aspect-ratio: 1.12;
			width: 100%;
			max-width: 100%;
			justify-self: stretch;
		}

		.project-apartments {
			padding: 2.65rem 0 3.75rem;
		}

		.project-apartments__header {
			text-align: center;
		}

		.project-apartments__grid {
			grid-template-columns: 1fr;
		}

		.project-overview__heading-block h2 {
			font-size: clamp(2.15rem, 11vw, 3.1rem);
			overflow-wrap: anywhere;
		}

		.project-overview__lead {
			font-size: clamp(0.95rem, 4.45vw, 1.35rem);
			line-height: 1.5;
			overflow-wrap: anywhere;
		}

		.project-overview__lead-primary {
			white-space: normal;
		}

		.project-overview__lead-secondary {
			display: inline;
		}

		.project-cta {
			min-height: auto;
		}

		.project-cta__container {
			padding-block: 4.75rem;
		}

		.project-cta__item {
			min-height: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-cta__background,
		.project-overview__button,
		.project-overview__address-link,
		.project-cta__button {
			transform: none;
			transition: none;
		}
	}
</style>
