---
import ContactForm from "../components/home/ContactForm.jsx";
import { getMessages } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import { loadHowToBuyPage } from "../sanity/howToBuy";

const locale = "lv";
const messages = getMessages(locale);
const sanityContent = await loadHowToBuyPage();
if (!sanityContent) {
	throw new Error("How To Buy Page content is missing in Sanity.");
}
const content = {
	...sanityContent,
	title: "Kā iegādāties dzīvokli",
	heroEyebrow: "Kā iegādāties",
	heroTitle: "Kā iegādāties dzīvokli mūsu projektā",
	heroLead:
		"No dzīvokļa izvēles līdz atslēgām mēs palīdzam Jums saprast katru soli vienkārši un bez liekas steigas.",
	heroLeadParagraphs: [
		"No dzīvokļa izvēles līdz atslēgām mēs palīdzam Jums saprast katru soli vienkārši un bez liekas steigas.",
		"Ja rodas jautājumi par apskati, rezervāciju, finansējumu vai dokumentiem, mūsu komanda izstāstīs, kas jādara tālāk un kā sagatavoties."
	],
	stepsTitle: "No pirmās apskates līdz Jūsu dzīvokļa atslēgām.",
	stepsLead: "",
	stepsLeadParagraphs: [],
	steps: [
		{
			title: "Izvēlieties dzīvokli",
			body: "Apskatām pieejamos dzīvokļus pēc istabu skaita, platības, stāva un budžeta. Palīdzam salīdzināt plānojumus, lai Jums būtu vieglāk saprast, kurš variants ikdienā būs ērtākais.",
			bodyParagraphs: [
				"Apskatām pieejamos dzīvokļus pēc istabu skaita, platības, stāva un budžeta. Palīdzam salīdzināt plānojumus, lai Jums būtu vieglāk saprast, kurš variants ikdienā būs ērtākais."
			],
			supportingNote: "Pirms apskates varam sagatavot vairākus piemērotus variantus."
		},
		{
			title: "Vienojamies par apskati",
			body: "Norunājam Jums ērtu apskates laiku Talsu ielā 3A un uz vietas parādām dzīvokli, apdari, plānojumu un ēkas priekšrocības.",
			bodyParagraphs: [
				"Norunājam Jums ērtu apskates laiku Talsu ielā 3A un uz vietas parādām dzīvokli, apdari, plānojumu un ēkas priekšrocības."
			],
			supportingNote: "Apskates laikā varat uzdot visus jautājumus par māju, izmaksām un pieejamību."
		},
		{
			title: "Rezervējam izvēlēto dzīvokli",
			body: "Kad esat atradis piemērotāko dzīvokli, izskaidrojam rezervācijas kārtību, termiņus un nākamos dokumentus. Dzīvoklis tiek fiksēts, lai Jūs mierīgi varētu sakārtot nākamos soļus.",
			bodyParagraphs: [
				"Kad esat atradis piemērotāko dzīvokli, izskaidrojam rezervācijas kārtību, termiņus un nākamos dokumentus. Dzīvoklis tiek fiksēts, lai Jūs mierīgi varētu sakārtot nākamos soļus."
			],
			supportingNote: "Visus rezervācijas nosacījumus izrunājam pirms jebkādu saistību uzņemšanās."
		},
		{
			title: "Sakārtojam finansējumu un dokumentus",
			body: "Ja nepieciešams bankas finansējums, palīdzam sagatavot informāciju par izvēlēto dzīvokli. Ja pirkums notiek bez aizdevuma, vienojamies par skaidru norēķinu un dokumentu secību.",
			bodyParagraphs: [
				"Ja nepieciešams bankas finansējums, palīdzam sagatavot informāciju par izvēlēto dzīvokli. Ja pirkums notiek bez aizdevuma, vienojamies par skaidru norēķinu un dokumentu secību."
			],
			supportingNote: "Mērķis ir, lai Jums vienmēr ir skaidrs, kas vajadzīgs un līdz kuram datumam."
		},
		{
			title: "Parakstām līgumu un nododam dzīvokli",
			body: "Kad nosacījumi ir saskaņoti, tiek sagatavoti darījuma dokumenti, veikti norēķini un noorganizēta dzīvokļa nodošana. Pēc tam varat sākt iekārtot savas jaunās mājas.",
			bodyParagraphs: [
				"Kad nosacījumi ir saskaņoti, tiek sagatavoti darījuma dokumenti, veikti norēķini un noorganizēta dzīvokļa nodošana. Pēc tam varat sākt iekārtot savas jaunās mājas."
			],
			supportingNote: "Nodošanas brīdī izstāstām arī praktiskos jautājumus par mājokļa lietošanu."
		}
	],
	financingEyebrow: "Finansējums",
	financingTitle: "Palīdzēsim saprast Jums piemērotāko finansējuma ceļu",
	financingLead:
		"Ja nepieciešams bankas finansējums, palīdzam sagatavot informāciju par izvēlēto dzīvokli. Ja pirkums notiek bez aizdevuma, vienojamies par skaidru norēķinu un dokumentu secību.",
	financingLeadParagraphs: [
		"Ja nepieciešams bankas finansējums, palīdzam sagatavot informāciju par izvēlēto dzīvokli. Ja pirkums notiek bez aizdevuma, vienojamies par skaidru norēķinu un dokumentu secību."
	],
	financingHighlights: [
		{ label: "Objekta dati", value: "Sagatavojam informāciju par izvēlēto dzīvokli." },
		{ label: "Termiņi", value: "Saskaņojam rezervāciju ar bankas izvērtēšanas procesu." },
		{ label: "Norēķinu secība", value: "Izskaidrojam iemaksas un gala norēķina kārtību." },
		{ label: "Konsultācija", value: "Atbildēsim uz jautājumiem pirms lēmuma pieņemšanas." }
	],
	documentsEyebrow: "Īpašuma Pārrakstīšana",
	documentsTitle: "Pārrakstam dzīvokli Jūsu īpašumā",
	documentsLead:
		"Kad izvēlētais dzīvoklis, norēķinu kārtība un termiņi ir saskaņoti, sagatavojam nepieciešamos dokumentus un palīdzam noorganizēt īpašuma tiesību pāreju.",
	documentsLeadParagraphs: [
		"Kad izvēlētais dzīvoklis, norēķinu kārtība un termiņi ir saskaņoti, sagatavojam nepieciešamos dokumentus un palīdzam noorganizēt īpašuma tiesību pāreju."
	],
	documentItems: [
		{ label: "Darījuma dokumenti", value: "Sagatavojam dokumentus atbilstoši saskaņotajai pirkuma un norēķinu kārtībai." },
		{ label: "Īpašuma tiesību pāreja", value: "Pārrakstam dzīvokli Jūsu īpašumā un palīdzam saprast katru parakstīšanas soli." },
		{ label: "Norēķinu secība", value: "Vienojamies, kad un kā tiek veikti maksājumi, lai process būtu skaidrs abām pusēm." },
		{ label: "Dzīvokļa nodošana", value: "Pēc dokumentu sakārtošanas noorganizējam dzīvokļa nodošanu un praktisko jautājumu izrunāšanu." }
	],
	faqEyebrow: "Biežākie jautājumi",
	faqTitle: "Kas visbiežāk interesē pircējus",
	faqLead:
		"Ja atbildi neatrodat šeit, sazinieties ar mums. Mēs izstāstīsim tieši par Jūsu izvēlēto dzīvokli.",
	faqLeadParagraphs: [
		"Ja atbildi neatrodat šeit, sazinieties ar mums. Mēs izstāstīsim tieši par Jūsu izvēlēto dzīvokli."
	],
	faqItems: [
		{
			question: "Cik ilgi var rezervēt dzīvokli?",
			answer: "Rezervācijas termiņu saskaņojam individuāli, ņemot vērā izvēlēto dzīvokli un finansējuma procesu.",
			answerParagraphs: [
				"Rezervācijas termiņu saskaņojam individuāli, ņemot vērā izvēlēto dzīvokli un finansējuma procesu."
			]
		},
		{
			question: "Vai palīdzat ar bankas procesu?",
			answer: "Jā, sagatavojam bankai nepieciešamo informāciju par dzīvokli un palīdzam saprast, kādi dokumenti parasti ir vajadzīgi.",
			answerParagraphs: [
				"Jā, sagatavojam bankai nepieciešamo informāciju par dzīvokli un palīdzam saprast, kādi dokumenti parasti ir vajadzīgi."
			]
		},
		{
			question: "Kas ir iekļauts dzīvokļa cenā?",
			answer: "Dzīvokļi ir ar pilnībā pabeigtu apdari. Konkrētā dzīvokļa specifikāciju izstāstām apskates vai konsultācijas laikā.",
			answerParagraphs: [
				"Dzīvokļi ir ar pilnībā pabeigtu apdari. Konkrētā dzīvokļa specifikāciju izstāstām apskates vai konsultācijas laikā."
			]
		}
	],
	contactEyebrow: "Piesakieties",
	contactTitle: "Atstāj savus kontaktus",
	contactLead:
		"Atstāj savu kontaktinformāciju, un mēs sazināsimies, lai vienotos par apskati Tev ērtā laikā.",
	contactLeadParagraphs: [
		"Atstāj savu kontaktinformāciju, un mēs sazināsimies, lai vienotos par apskati Tev ērtā laikā."
	],
	contactBenefits: [
		"Dzīvokļu apskate ar mūsu speciālistu",
		"Atbildēsim uz Tavu pieteikumu 24 stundu laikā",
		"Mēs rūpējamies par Tavu datu drošību."
	],
	contactFormTitle: "Atstāj savus kontaktus",
	contactFormIntro: "",
	contactDefaultInformation: "Vēlos pieteikties dzīvokļa apskatei.",
	contactSubmitLabel: "Pieteikties apskatei"
};
const sectionNav = [
	{ href: "#process", label: "Soli pa solim" },
	{ href: "#financing", label: "Finansējums" },
	{ href: "#documents", label: "Īpašuma Pārrakstīšana" },
	{ href: "#faq", label: "Biežākie jautājumi" },
	{ href: "#consultation", label: "Konsultācija" },
];
const faqStructuredData =
	content.faqItems.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: content.faqItems.map((item) => ({
					"@type": "Question",
					name: item.question,
					acceptedAnswer: {
						"@type": "Answer",
						text: item.answer,
					},
				})),
			}
		: null;
---

<Layout
	title={content.seo?.metaTitle || content.title || messages.pages.howToBuy}
	description={content.seo?.metaDescription || content.heroLead || content.faqLead}
	canonicalPath="/how-to-buy"
	ogImageUrl={content.seo?.ogImage?.src || content.heroImage?.src}
	ogImageAlt={content.seo?.ogImage?.alt || content.heroImage?.alt || content.heroTitle}
	noIndex={content.seo?.noIndex}
	structuredData={faqStructuredData ? faqStructuredData : undefined}
	locale={locale}
	overlayHeader
>
	<main class="how-to-buy-page">
		<section
			class="how-to-buy-hero"
			style={`--how-to-buy-hero-image: ${content.heroImage ? `url("${content.heroImage.src}")` : 'none'};`}
		>
			<div class="how-to-buy-shell how-to-buy-hero__layout">
				<div class="how-to-buy-hero__content">
					<p class="how-to-buy-eyebrow fade-in text-xs font-bold uppercase tracking-widest">
						{content.heroEyebrow}
					</p>
					<h1
						class="how-to-buy-hero__title fade-in text-5xl font-semibold leading-none tracking-tight sm:text-6xl xl:text-7xl"
						data-reveal-delay="50"
					>
						{content.heroTitle}
					</h1>

				</div>

				<nav class="how-to-buy-hero__nav fade-in" data-reveal-delay="140" aria-label="Kā iet uz sadaļām">
					<p class="how-to-buy-hero__nav-label text-xs font-bold uppercase tracking-widest">Sadaļas</p>
					<ul class="how-to-buy-hero__nav-list" role="list">
						{sectionNav.map((item, index) => (
							<li>
								<a href={item.href} class="text-sm leading-relaxed">
									<span class="how-to-buy-hero__nav-index text-xs font-bold uppercase tracking-widest">
										{String(index + 1).padStart(2, "0")}
									</span>
									<span>{item.label}</span>
									<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
										<path
											d="M1.75 8h9.5"
											fill="none"
											stroke="currentColor"
											stroke-width="1.25"
											stroke-linecap="square"
										></path>
										<path
											d="M7.75 3.75 12 8l-4.25 4.25"
											fill="none"
											stroke="currentColor"
											stroke-width="1.25"
											stroke-linecap="square"
											stroke-linejoin="miter"
										></path>
									</svg>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</section>

		<section class="how-to-buy-process" id="process">
			<div class="how-to-buy-shell how-to-buy-process__layout">
				<div class="how-to-buy-process__intro">
						<div class="how-to-buy-process__intro-inner fade-in">
						<h2 class="how-to-buy-section-title text-4xl font-semibold leading-none tracking-tight sm:text-5xl lg:text-6xl">
							{content.stepsTitle}
						</h2>
						{content.stepsLeadParagraphs.length > 0 ? (
							<div class="how-to-buy-copy text-base leading-relaxed">
								{content.stepsLeadParagraphs.map((paragraph) => <p>{paragraph}</p>)}
							</div>
						) : null}
					</div>
				</div>

				<div class="how-to-buy-process__list">
					{content.steps.map((step, index) => (
						<article
							class:list={["how-to-buy-step fade-in", { "how-to-buy-step--with-image": Boolean(step.image) }]}
							data-reveal-delay={80 + index * 70}
						>
							<div class="how-to-buy-step__meta">
								<p class="how-to-buy-step__number text-xs font-bold uppercase tracking-widest">
									{String(index + 1).padStart(2, "0")}
								</p>
								<div class="how-to-buy-step__content">
									<h3 class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{step.title}</h3>
									<div class="how-to-buy-copy text-base leading-relaxed">
										{step.bodyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
									</div>
									{step.supportingNote ? (
										<p class="how-to-buy-step__note text-sm leading-relaxed">{step.supportingNote}</p>
									) : null}
								</div>
							</div>

							{step.image ? (
								<figure class="how-to-buy-step__media">
									<img
										src={step.image.src}
										alt={step.image.alt}
										loading="lazy"
										decoding="async"
									/>
									{step.image.label ? (
										<figcaption class="text-xs font-bold uppercase tracking-widest">{step.image.label}</figcaption>
									) : null}
								</figure>
							) : null}
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="how-to-buy-split how-to-buy-split--light" id="financing">
			<div class="how-to-buy-shell how-to-buy-split__layout">
				<div class="how-to-buy-split__media fade-in">
					{content.financingImage ? (
						<figure class="how-to-buy-split__frame gold-frame">
							<img
								src={content.financingImage.src}
								alt={content.financingImage.alt}
								loading="lazy"
								decoding="async"
							/>
						</figure>
					) : null}
				</div>

					<div class="how-to-buy-split__content fade-in" data-reveal-delay="80">
					<p class="how-to-buy-eyebrow text-xs font-bold uppercase tracking-widest">{content.financingEyebrow}</p>
					<h2 class="how-to-buy-section-title mb-6 text-4xl font-semibold leading-none tracking-tight sm:mb-8 sm:text-5xl lg:text-6xl">
						{content.financingTitle}
					</h2>
					<div class="how-to-buy-copy mt-6 text-base leading-relaxed sm:mt-8">
						{content.financingLeadParagraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>

					<div class="how-to-buy-specs how-to-buy-specs--light">
						{content.financingHighlights.map((item) => (
							<div class="how-to-buy-specs__row">
								<p class="text-sm leading-relaxed">{item.label}</p>
								<p class="text-base leading-relaxed">{item.value}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="how-to-buy-split how-to-buy-split--light" id="documents">
			<div class="how-to-buy-shell how-to-buy-split__layout how-to-buy-split__layout--reverse">
				<div class="how-to-buy-split__content fade-in">
					<p class="how-to-buy-eyebrow text-xs font-bold uppercase tracking-widest">{content.documentsEyebrow}</p>
					<h2 class="how-to-buy-section-title mb-6 text-4xl font-semibold leading-none tracking-tight sm:mb-8 sm:text-5xl lg:text-6xl">
						{content.documentsTitle}
					</h2>
					<div class="how-to-buy-copy mt-6 text-base leading-relaxed sm:mt-8">
						{content.documentsLeadParagraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>

					<div class="how-to-buy-specs how-to-buy-specs--light">
						{content.documentItems.map((item) => (
							<div class="how-to-buy-specs__row">
								<p class="text-sm leading-relaxed">{item.label}</p>
								<p class="text-base leading-relaxed">{item.value}</p>
							</div>
						))}
					</div>
				</div>

				<div class="how-to-buy-split__media fade-in" data-reveal-delay="80">
					{content.documentsImage ? (
						<figure class="how-to-buy-split__frame how-to-buy-split__frame--light gold-frame gold-frame--light">
							<img
								src={content.documentsImage.src}
								alt={content.documentsImage.alt}
								loading="lazy"
								decoding="async"
							/>
						</figure>
					) : null}
				</div>
			</div>
		</section>

		<section class="how-to-buy-faq" id="faq">
			<div class="how-to-buy-shell">
				<div class="how-to-buy-faq__intro">
					<div class="fade-in">
						<p class="how-to-buy-eyebrow text-xs font-bold uppercase tracking-widest">{content.faqEyebrow}</p>
						<h2 class="how-to-buy-section-title text-4xl font-semibold leading-none tracking-tight sm:text-5xl lg:text-6xl">
							{content.faqTitle}
						</h2>
					</div>

					<div class="how-to-buy-copy fade-in text-base leading-relaxed" data-reveal-delay="70">
						{content.faqLeadParagraphs.map((paragraph) => <p>{paragraph}</p>)}
					</div>
				</div>

				<div class="how-to-buy-faq__list">
					{content.faqItems.map((item, index) => (
						<details class="how-to-buy-faq__item fade-in" data-reveal-delay={110 + index * 55}>
							<summary class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
									<span>{item.question}</span>
									<span class="how-to-buy-faq__icon" aria-hidden="true"></span>
								</summary>
							<div class="how-to-buy-faq__answer how-to-buy-copy text-base leading-relaxed">
								{item.answerParagraphs.map((paragraph) => <p>{paragraph}</p>)}
							</div>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="contact-section" aria-labelledby="contact-section-title" id="consultation">
			<div class="contact-section__container">
				<div class="contact-section__layout">
					<div class="contact-section__content">
						<p class="contact-section__eyebrow fade-in">{content.contactEyebrow}</p>
						<h2 id="contact-section-title" class="contact-section__title fade-in" data-reveal-delay="70">
							{content.contactTitle}
						</h2>
						<div class="contact-section__lead fade-in" data-reveal-delay="130">
							{content.contactLeadParagraphs.map((paragraph) => <p>{paragraph}</p>)}
						</div>

						{content.contactBenefits.length > 0 ? (
							<ul class="contact-section__benefits" role="list">
								{content.contactBenefits.map((benefit, index) => (
									<li class="contact-section__benefit fade-in" data-reveal-delay={String(190 + index * 60)}>
										<span class="contact-section__check" aria-hidden="true">
											<img src="/check-mark.svg" alt="" loading="lazy" width="14" height="14" />
										</span>
										<span>{benefit}</span>
									</li>
								))}
							</ul>
						) : null}
					</div>

					<div class="contact-section__form-wrap fade-in" data-reveal-delay="180">
						<div class="contact-section__card contact-form-card">
							<ContactForm
								client:idle
								title={content.contactFormTitle}
								intro={content.contactFormIntro}
								defaultInformation={content.contactDefaultInformation}
								submitLabel={content.contactSubmitLabel}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style is:global>
	.how-to-buy-page {
		background: var(--bg-primary);
		color: var(--surface-light);
	}

	.how-to-buy-shell {
		width: min(100%, 1280px);
		margin: 0 auto;
		padding-inline: clamp(1.5rem, 4vw, 3rem);
	}

	.how-to-buy-eyebrow {
		margin: 0;
		color: var(--accent-primary);
	}

	.how-to-buy-section-title,
	.how-to-buy-hero__title {
		font-family: var(--font-heading);
		text-wrap: balance;
	}

	.how-to-buy-hero__title {
		margin: 0.9rem 0 0;
	}

	.how-to-buy-section-title {
		margin: 0;
	}

	.how-to-buy-section-title {
