---
import PropertiesCatalogView from "../../components/properties/PropertiesCatalogView.astro";
import { getAllProperties, getPropertyCategories } from "../../sanity/properties";
import Layout from "../../layouts/Layout.astro";
import type { Locale } from "../../i18n/translations";

const locale = (Astro.props.locale ?? "lv") as Locale;
const isEnglish = locale === "en";
const [properties, categories] = await Promise.all([getAllProperties(), getPropertyCategories()]);
const catalogLead = isEnglish
	? "Explore apartments at Talsu Street 3A in Ventspils. Compare layouts, floor areas, prices and availability to find a home that suits you."
	: "Apskati dzīvokļus Ventspilī, Talsu ielā 3A. Salīdzini plānojumus, platības, cenas un pieejamību AmberHome projektā.";
---

<Layout
	title={isEnglish ? "Apartments in Ventspils | AmberHome" : "Dzīvokļi Ventspilī | AmberHome Talsu ielā 3A"}
	description={catalogLead}
	canonicalPath={isEnglish ? "/en/apartments" : "/dzīvokļi"}
	footerTone="dark"
	locale={locale}
>
	<PropertiesCatalogView
		title={isEnglish ? "Apartments in Ventspils" : "Dzīvokļi Ventspilī"}
		lead={catalogLead}
		properties={properties}
		categories={categories}
		activeCategory="all"
		locale={locale}
	/>
</Layout>
