---
import PropertiesCatalogView from "../../../components/properties/PropertiesCatalogView.astro";
import {
	getPropertyCategoryHref,
	getPropertyCategoryHrefForLocale,
	getPropertyCategoryLabel,
	getPropertyCategoryRouteSlug,
	getPropertiesByCategory,
	getPropertyCategories,
	type PropertyCategory
} from "../../../sanity/properties";
import Layout from "../../../layouts/Layout.astro";
import type { Locale } from "../../../i18n/translations";

export async function getStaticPaths() {
	const categories = await getPropertyCategories();

	return categories.map((category) => ({
		params: { category: getPropertyCategoryRouteSlug(category) },
		props: { category }
	}));
}

interface Props {
	category: PropertyCategory;
	locale?: Locale;
}

const { category, locale = "lv" } = Astro.props as Props;
const isEnglish = locale === "en";
const categoryLabel = getPropertyCategoryLabel(category, locale);
const categoryDescription = isEnglish
	? `Browse the available ${categoryLabel.toLowerCase()} at AmberHome, Talsu Street 3A in Ventspils.`
	: category.description;

const [properties, categories] = await Promise.all([
	getPropertiesByCategory(category.slug),
	getPropertyCategories()
]);
const categoryTitle = isEnglish ? categoryLabel : `${categoryLabel} Ventspilī`;
const categoryAccusative = ({
	"3-rooms": "trīsistabu dzīvokļus",
	"4-rooms": "četristabu dzīvokļus",
	"5-rooms": "piecistabu dzīvokļus"
} as Record<string, string>)[category.slug] ?? "dzīvokļus";
const categoryLocationSentence = `Apskati ${categoryAccusative} AmberHome projektā Ventspilī, Talsu ielā 3A. Salīdzini plānojumus, platības, cenas un pieejamību.`;
const locationLead = isEnglish
	? categoryDescription
	: `${category.description ? `${category.description} ` : ""}${categoryLocationSentence}`;
const categoryMetaDescription = isEnglish
	? categoryDescription
	: categoryLocationSentence;
---

<Layout
	title={isEnglish ? `${categoryLabel} in Ventspils | AmberHome` : category.seo?.metaTitle || `${categoryTitle} | AmberHome`}
	description={isEnglish ? categoryDescription : category.seo?.metaDescription || categoryMetaDescription}
	canonicalPath={getPropertyCategoryHrefForLocale(category, locale)}
	ogImageUrl={category.seo?.ogImage?.src}
	ogImageAlt={isEnglish ? `${categoryLabel} at AmberHome` : category.seo?.ogImage?.alt}
	noIndex={category.seo?.noIndex}
	footerTone="dark"
	locale={locale}
>
	<PropertiesCatalogView
		title={categoryTitle}
		lead={locationLead}
		properties={properties}
		categories={categories}
		activeCategory={category.slug}
		locale={locale}
	/>
</Layout>
