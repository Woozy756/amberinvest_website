---
import { getAllProperties, getPropertyHref } from "../../../../sanity/properties";

export async function getStaticPaths() {
	const properties = await getAllProperties();

	return properties.map((property) => ({
		params: {
			category: property.category.slug,
			slug: property.slug
		},
		props: { destination: getPropertyHref(property) }
	}));
}

const { destination } = Astro.props as { destination: string };

return Astro.redirect(encodeURI(destination), 301);
---
