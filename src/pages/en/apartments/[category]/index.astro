---
import { getPropertyCategories, getPropertyCategoryHref } from "../../../../sanity/properties";

export async function getStaticPaths() {
	const categories = await getPropertyCategories();

	return categories.map((category) => ({
		params: { category: category.slug },
		props: { destination: getPropertyCategoryHref(category) }
	}));
}

const { destination } = Astro.props as { destination: string };

return Astro.redirect(encodeURI(destination), 301);
---
