---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/home/ContactForm.jsx";
import { loadContactPage } from "../sanity/contactPage";
import type { Locale } from "../i18n/translations";

const locale = (Astro.props.locale ?? "lv") as Locale;
const isEnglish = locale === "en";
const content = await loadContactPage();

if (!content) {
	throw new Error("Contact Page content is missing in Sanity.");
}

const title = isEnglish ? "Contact" : content.title || "Kontakti";
const contactLead =
	isEnglish
		? "Contact us for information about apartments, prices and available viewing times."
		: content.contactLead || "Sazinieties ar mums, lai saņemtu informāciju par dzīvokļiem, cenām un apskates laikiem.";
const contactHighlights =
	isEnglish
		? [
				"Direct communication with the project team",
				"Information about prices, layouts and availability",
				"Support through to completion of the purchase"
			]
		: content.contactHighlights.length > 0
		? content.contactHighlights
		: [
				"Tieša saziņa ar projekta komandu",
				"Informācija par cenām, plāniem un pieejamību",
				"Atbalsts līdz darījuma noslēgšanai"
			];
const formEyebrow = isEnglish ? "Enquiry" : content.formEyebrow || "Pieteikums";
const formTitle = isEnglish ? "Complete the form and we will contact you." : content.formTitle || "Aizpildiet formu, un mēs sazināsimies ar jums.";
const formLead =
	isEnglish
		? "Leave your contact details to book a viewing or ask about a specific apartment."
		: content.formLead ||
			"Atstājiet savu kontaktinformāciju, lai pieteiktu apskati vai saņemtu atbildi par konkrētu dzīvokli.";
const formCardTitle = isEnglish ? "Send an enquiry" : content.formCardTitle || "Nosūtīt pieprasījumu";
const formCardIntro = isEnglish
	? "Tell us which apartment interests you or when you would like to arrange a viewing."
	: content.formCardIntro || "";
const defaultInformation =
	isEnglish
		? "I would like more information about the available properties."
		: "Vēlos saņemt vairāk informācijas par pieejamajiem īpašumiem.";
const submitLabel = isEnglish ? "Send enquiry" : content.submitLabel || "Nosūtīt pieprasījumu";
---

<Layout
	title={isEnglish ? "AmberHome | Contact" : content.seo?.metaTitle || title}
	description={isEnglish ? contactLead : content.seo?.metaDescription || contactLead}
	canonicalPath={isEnglish ? "/en/contact" : "/kontakti"}
	ogImageUrl={content.seo?.ogImage?.src}
	ogImageAlt={isEnglish ? "Contact AmberHome" : content.seo?.ogImage?.alt}
	noIndex={content.seo?.noIndex}
	footerTone="light"
	locale={locale}
>
	<main class="contact-page">
		<section class="contact-page__form-section" id="contact-form" aria-labelledby="contact-form-title">
			<div class="contact-page__shell contact-page__form-layout">
				<div class="contact-page__form-copy">
					<p class="contact-page__eyebrow fade-in">{formEyebrow}</p>
					<h2 id="contact-form-title" class="fade-in" data-reveal-delay="70">{formTitle}</h2>
					<p class="contact-page__form-lead fade-in" data-reveal-delay="120">{formLead}</p>

					<ul class="contact-page__highlights" role="list">
						{contactHighlights.map((highlight, index) => (
							<li class="fade-in" data-reveal-delay={String(170 + index * 55)}>
								<span aria-hidden="true"></span>
								{highlight}
							</li>
						))}
					</ul>
				</div>

				<div class="contact-page__form-wrap">
					<div class="contact-form-card">
						<ContactForm
							client:load
							locale={locale}
							title={formCardTitle}
							intro={formCardIntro}
							defaultInformation={defaultInformation}
							submitLabel={submitLabel}
						/>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.contact-page {
		padding-top: 5.25rem;
		background: #f7f4ee;
		color: var(--bg-primary);
	}

	.contact-page__shell {
		width: min(100%, 1280px);
		margin-inline: auto;
		padding-inline: clamp(1.5rem, 4vw, 3rem);
	}

	.contact-page__form-copy {
		min-width: 0;
	}

	.contact-page__eyebrow {
		margin: 0;
		color: var(--accent-primary);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.contact-page__form-copy h2 {
		margin: 0;
		font-family: var(--font-heading);
		letter-spacing: 0;
		text-wrap: balance;
	}

	.contact-page__form-lead {
		margin: 0;
		color: rgba(15, 17, 21, 0.66);
		font-size: clamp(1rem, 1.35vw, 1.1rem);
		line-height: 1.75;
	}

	.contact-page__form-section {
		position: relative;
		overflow: clip;
		padding: clamp(4.5rem, 8vw, 7rem) 0;
		background:
			linear-gradient(90deg, rgba(199, 150, 67, 0.09) 0%, transparent 20%),
			repeating-linear-gradient(
				90deg,
				rgba(138, 144, 152, 0.035) 0,
				rgba(138, 144, 152, 0.035) 1px,
				transparent 1px,
				transparent 120px
			),
			#111821;
		color: var(--surface-light);
	}

	.contact-page__form-layout {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(24rem, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.contact-page__form-copy {
		max-width: 35rem;
	}

	.contact-page__form-copy h2 {
		margin-top: 1rem;
		font-size: clamp(2.2rem, 4.5vw, 4.25rem);
		line-height: 1.04;
	}

	.contact-page__form-lead {
		margin-top: 1.25rem;
		color: rgba(245, 243, 238, 0.7);
	}

	.contact-page__highlights {
		list-style: none;
		display: grid;
		gap: 0.9rem;
		margin: 2rem 0 0;
		padding: 0;
	}

	.contact-page__highlights li {
		display: grid;
		grid-template-columns: 0.7rem minmax(0, 1fr);
		gap: 0.85rem;
		align-items: start;
		color: rgba(245, 243, 238, 0.9);
		line-height: 1.55;
	}

	.contact-page__highlights span {
		width: 0.55rem;
		height: 0.55rem;
		margin-top: 0.48rem;
		border: 2px solid var(--accent-primary);
		transform: rotate(45deg);
	}

	.contact-page__form-wrap {
		min-width: 0;
	}

	@media (max-width: 900px) {
		.contact-page__form-layout {
			grid-template-columns: 1fr;
		}

		.contact-page__form-copy {
			max-width: 43rem;
		}
	}

	@media (max-width: 959px) {
		.contact-page {
			padding-top: 5.5rem;
		}
	}

	@media (max-width: 640px) {
		.contact-page__shell {
			padding-inline: 1.25rem;
		}

		.contact-page__form-section {
			padding: 3.75rem 0;
		}

		.contact-page__form-layout {
			gap: 2.4rem;
		}

		.contact-page__form-copy h2 {
			font-size: clamp(2rem, 10vw, 2.6rem);
		}
	}
</style>
