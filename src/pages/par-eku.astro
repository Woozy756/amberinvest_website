---
import ContactForm from "../components/home/ContactForm.jsx";
import { getMessages, type Locale } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import { loadHomepage } from "../sanity/homepage";

const locale = (Astro.props.locale ?? "lv") as Locale;
const isEnglish = locale === "en";
const messages = getMessages(locale);

const pageTitle = messages.pages.aboutBuilding;
const pageDescription =
	isEnglish
		? "Construction, utilities, safety and comfort features at AmberHome, Talsu Street 3A."
		: "AmberHome Talsu ielā 3A ēkas konstrukciju, inženiertīklu, drošības un komforta risinājumu apraksts.";
const homepage = await loadHomepage();
const homeHeroImage = homepage?.hero.heroBackgroundImage?.asset?.url ?? "/images/hero-night.png";
const homeMobileHeroImage = "/images/hero-mobile.png";

const sectionNav = isEnglish ? [
	{ href: "#overview", label: "Overview" },
	{ href: "#construction", label: "Construction" },
	{ href: "#systems", label: "Utilities" },
	{ href: "#comfort", label: "Comfort" },
	{ href: "#consultation", label: "Consultation" },
] : [
	{ href: "#overview", label: "Pārskats" },
	{ href: "#construction", label: "Konstrukcijas" },
	{ href: "#systems", label: "Inženiertīkli" },
	{ href: "#comfort", label: "Komforts" },
	{ href: "#consultation", label: "Konsultācija" },
];

const overviewSpecs = isEnglish ? [
	{ label: "Apartment layouts", value: "3, 4 and 5 rooms" },
	{ label: "External wall thickness", value: "550 mm total thickness" },
	{ label: "Attic insulation", value: "300 mm stone wool" },
	{ label: "Windows", value: "Triple-glazed PVC windows with a U-value of 1.1" },
] : [
	{ label: "Istabu plānojumi", value: "3, 4 un 5 istabas" },
	{ label: "Ārsienu biezums", value: "550 mm kopējais biezums" },
	{ label: "Bēniņu siltinājums", value: "300 mm akmens vate" },
	{ label: "Logi", value: "PVC logi ar trīskāršo stiklojumu un U vērtību 1,1" },
];

const constructionItems = isEnglish ? [
	{
		title: "Foundations and ground-floor slab",
		body: "Reinforced concrete block foundations insulated with XPS. The ground-floor slab includes 200 mm XPS insulation, underfloor heating and screed concrete.",
		note: "A stable and insulated base structure for everyday comfort."
	},
	{
		title: "External walls",
		body: "An outer layer of calcium silicate brickwork with hollow clay bricks internally. The total wall thickness is 550 mm, complemented by 100 mm Paroc stone wool and Ceresit decorative render.",
		note: "The wall build-up helps retain heat and reduce outside noise."
	},
	{
		title: "Intermediate floors",
		body: "Precast concrete panels, EPS insulation with integrated underfloor heating and dry screed concrete.",
		note: "The floor structure supports practical acoustic and thermal comfort between levels."
	},
	{
		title: "Attic and roof",
		body: "Precast concrete panels with 300 mm stone-wool insulation. The roof is finished in PE-coated galvanized sheet metal.",
		note: "Attic insulation and a durable roof covering help reduce heat loss."
	},
	{
		title: "Walls between apartments",
		body: "Masonry construction with double plasterboard lining and mineral-wool infill to improve sound insulation between apartments.",
		note: "Designed for quieter and more private living."
	},
	{
		title: "Internal partitions",
		body: "Double plasterboard structures with mineral-wool infill, or masonry walls with plasterboard lining.",
		note: "Partitions are designed to provide good sound insulation and everyday comfort."
	},
	{
		title: "Windows",
		body: "High-quality triple-glazed PVC windows with a low U-value of 1.1 provide thermal and acoustic insulation together with generous daylight.",
		note: "More daylight and better thermal performance in one solution."
	},
	{
		title: "Entrance doors",
		body: "Aluminium entrance doors with remote opening for convenient and secure access.",
		note: "Easy everyday access for residents and visitors."
	},
] : [
	{
		title: "Pamati un pirmā stāva grīda",
		body: "Dzelzsbetona bloku pamati siltināti ar XPS. Pirmā stāva grīdā iestrādāts 200 mm XPS siltinājums, zemgrīdas apkures sistēma un estrih betons.",
		note: "Stabila un siltināta pamatkonstrukcija ikdienas komfortam."
	},
	{
		title: "Ārsienas",
		body: "Silikāta ķieģeļu ārējais mūris un dobie māla ķieģeļi iekšējos slāņos. Kopējais biezums ir 550 mm, papildināts ar 100 mm Paroc akmens vati un Ceresit dekoratīvo apmetumu.",
		note: "Sienu risinājumi palīdz uzturēt siltumu un samazināt āra trokšņu ietekmi."
	},
	{
		title: "Starpstāvu pārsegums",
		body: "Saliekamie betona paneļi, EPS putu polistirols ar iestrādātu zemgrīdas apkures sistēmu un estrih sausais betons.",
		note: "Pārsegumi veidoti ar praktisku skaņas un siltuma komfortu starp stāviem."
	},
	{
		title: "Bēniņi un jumts",
		body: "Saliekamā betona paneļu pārsegums ar 300 mm akmens vates siltinājumu. Jumta segums veidots no cinkota skārda ar PE pārklājumu.",
		note: "Bēniņu siltinājums un izturīgs jumta segums palīdz samazināt siltuma zudumus."
	},
	{
		title: "Dzīvokļu nodalošās sienas",
		body: "Mūra konstrukcija ar dubultā ģipškartona apšuvumu un minerālvates pildījumu, kas uzlabo skaņas izolāciju starp dzīvokļiem.",
		note: "Risinājums paredzēts mierīgākai un privātākai dzīvošanai."
	},
	{
		title: "Dzīvokļu starpsienas",
		body: "Dubultā ģipškartona konstrukcijas ar minerālvates pildījumu vai mūra sienas ar ģipškartona apšuvumu.",
		note: "Starpsienas veidotas, lai nodrošinātu labu skaņas izolāciju un komfortu ikdienā."
	},
	{
		title: "Logi",
		body: "Augstas kvalitātes PVC logi ar trīskāršo stiklojumu un zemu U vērtību 1,1 nodrošina siltuma un skaņas izolāciju, kā arī plašu dienasgaismu.",
		note: "Plašāks dienasgaismas apjoms un labāka siltumnoturība vienā risinājumā."
	},
	{
		title: "Ieejas durvis",
		body: "Alumīnija konstrukcijas ar attālinātas atvēršanas funkciju ērtai un drošai piekļuvei ēkai.",
		note: "Ērta piekļuve ēkai ikdienas lietošanai un apmeklētāju uzņemšanai."
	},
];

const utilitySections = isEnglish ? [
	{
		id: "water-and-sewerage",
		number: "01",
		title: "Water and sewerage",
		lead: "Central municipal networks with individual consumption metering for every apartment.",
		items: [
			"The building is connected to the municipal water and sewerage networks.",
			"Each apartment has hot and cold water supplied from the main network.",
			"Individual hot and cold water meters are installed in every apartment."
		]
	},
	{
		id: "heating",
		number: "02",
		title: "Heating",
		lead: "Municipal district heating combined with individually adjustable underfloor heating.",
		items: [
			"The building has its own heat substation.",
			"The temperature can be adjusted separately in every room.",
			"Heating consumption is metered for the building and for each apartment.",
			"Common areas are equipped with hydronic underfloor heating."
		]
	},
	{
		id: "electricity",
		number: "03",
		title: "Electricity",
		lead: "Complete internal electrical installations for lighting and household appliances.",
		items: [
			"Electrical distribution and internal wiring are installed.",
			"Light switches, sockets, lighting points and appliance connections are provided.",
			"Each apartment has an individual electricity meter."
		]
	},
	{
		id: "ventilation",
		number: "04",
		title: "Ventilation",
		lead: "Individual mechanical ventilation with heat recovery supplies fresh air without opening windows.",
		items: [
			"Every apartment has its own ventilation unit.",
			"Mechanical ventilation serves living rooms, bedrooms, bathrooms and WCs.",
			"The kitchen has a dedicated ventilation duct leading to the roof."
		]
	},
	{
		id: "telecommunications",
		number: "05",
		title: "Telecommunications",
		lead: "Modern data infrastructure for work, leisure and connected devices.",
		items: [
			"A Balticom fibre-optic internet connection is installed.",
			"Every room includes a data socket for connecting equipment."
		]
	},
] : [
	{
		id: "udens-un-kanalizacija",
		number: "01",
		title: "Ūdensvads un kanalizācija",
		lead: "Centralizēti pilsētas tīkli ar individuālu patēriņa uzskaiti katram dzīvoklim.",
		items: [
			"Ēkai ir pieslēgums centralizētajai pilsētas ūdensapgādei un kanalizācijai.",
			"Katram dzīvoklim izbūvēta aukstā un karstā ūdens padeve no maģistrālā tīkla.",
			"Aukstā un karstā ūdens patēriņa skaitītāji uzstādīti katram dzīvoklim.",
		],
	},
	{
		id: "apkure",
		number: "02",
		title: "Apkure",
		lead: "Centralizēta pilsētas siltumapgāde apvienota ar individuāli regulējamu zemgrīdas apkuri.",
		items: [
			"Ēkai ir savs siltummezgls.",
			"Siltuma režīmu iespējams regulēt katrai telpai atsevišķi.",
			"Apkures patēriņš tiek uzskaitīts visai mājai un katram dzīvoklim atsevišķi.",
			"Koplietošanas telpās ir izbūvēta ūdens cauruļvadu zemgrīdas apkures sistēma.",
		],
	},
	{
		id: "elektroapgade",
		number: "03",
		title: "Elektroapgāde",
		lead: "Dzīvokļiem sagatavoti pilni iekšējie elektrotīkli ikdienas apgaismojumam un sadzīves tehnikai.",
		items: [
			"Izbūvēta elektrības sadale un iekšējie elektrotīkli.",
			"Ierīkoti gaismas slēdži, rozetes, gaismekļu un elektroierīču pieslēguma punkti.",
			"Katram dzīvoklim ir individuāls elektrības patēriņa skaitītājs.",
		],
	},
	{
		id: "ventilacija",
		number: "04",
		title: "Ventilācija",
		lead: "Individuāla mehāniskā ventilācija ar siltuma atgūšanu nodrošina svaigu gaisu bez logu atvēršanas.",
		items: [
			"Ventilācijas iekārta ir individuāla katram dzīvoklim.",
			"Piespiedu ventilācija nodrošināta dzīvojamajās telpās, guļamistabās, vannas istabās un sanitārajos mezglos.",
			"Virtuvē izbūvēts ventilācijas gaisa vads ar izvadu uz ēkas jumtu.",
		],
	},
	{
		id: "telekomunikacijas",
		number: "05",
		title: "Telekomunikācijas",
		lead: "Mūsdienīga datu infrastruktūra darbam, atpūtai un viedierīču lietošanai.",
		items: [
			"Izbūvēts SIA Balticom optiskā interneta pieslēgums.",
			"Katrā istabā izbūvētas datortīklu rozetes iekārtu pieslēgšanai.",
		],
	},
];

const comfortGroups = isEnglish ? [
	{
		title: "Safety",
		items: [
			"Video surveillance around the site, entrances and stairwells.",
			"Access-control system with electronic keys.",
			"An autonomous smoke detector in every apartment."
		]
	},
	{
		title: "EV charging",
		items: [
			"Electric-vehicle charging points can be installed in the parking area.",
			"The required EV charging infrastructure has been prepared."
		]
	},
	{
		title: "Comfort",
		items: [
			"Accessible entry for people with reduced mobility.",
			"Parking spaces on land belonging to the building.",
			"Paved courtyard, bicycle parking and landscaped green space."
		]
	},
] : [
	{
		title: "Drošība",
		items: [
			"Videonovērošana teritorijā, pie ieejas durvīm un kāpņu telpās.",
			"Piekļuves kontroles sistēma ar čipatslēgām.",
			"Autonoms dūmu detektors katrā dzīvoklī.",
		],
	},
	{
		title: "Elektrouzlāde",
		items: [
			"Stāvvietās iespējams uzstādīt elektroauto uzlādes iekārtas.",
			"Elektroauto uzlādei sagatavota nepieciešamā infrastruktūra.",
		],
	},
	{
		title: "Komforts",
		items: [
			"Piekļuve cilvēkiem ar īpašām vajadzībām.",
			"Stāvvietas uz ēkai piederošās zemes.",
			"Bruģēts pagalms, velosipēdu novietne un zaļā zona.",
		],
	},
];
---

<Layout
	title={isEnglish ? messages.pages.aboutBuilding : pageTitle}
	description={pageDescription}
	canonicalPath={isEnglish ? "/en/about-the-building" : "/par-eku"}
	ogImageUrl={homeHeroImage}
	ogImageAlt={isEnglish ? "AmberHome building at Talsu Street 3A" : "AmberHome ēka Talsu ielā 3A"}
	overlayHeader
	footerTone="light"
	locale={locale}
>
	<main class="building-guide-page">
		<section
			class="building-guide-hero"
			style={`--building-guide-hero-image: url("${homeHeroImage}"); --building-guide-mobile-hero-image: url("${homeMobileHeroImage}");`}
		>
			<div class="building-guide-shell building-guide-hero__layout">
				<div class="building-guide-hero__content">
					<p class="building-guide-eyebrow fade-in text-xs font-bold uppercase tracking-widest">
						{isEnglish ? "About the building" : "Par ēku"}
					</p>
					<h1
						class="building-guide-hero__title fade-in text-5xl font-semibold leading-none tracking-tight sm:text-6xl xl:text-7xl"
						data-reveal-delay="50"
					>
						{isEnglish ? "AmberHome, Talsu Street 3A" : "AmberHome Talsu Ielā 3A"}
					</h1>
					<div class="building-guide-copy building-guide-hero__lead fade-in text-base leading-relaxed" data-reveal-delay="100">
						<p>
							{isEnglish ? "Carefully designed construction, individually adjustable systems and a fully finished environment for comfortable everyday living." : "Pārdomātas konstrukcijas, individuāli regulējamas sistēmas un pilnībā pabeigta vide ērtai ikdienai."}
						</p>
					</div>
				</div>

				<nav class="building-guide-hero__nav fade-in" data-reveal-delay="140" aria-label={isEnglish ? "About the building sections" : "Par ēku sadaļas"}>
					<p class="building-guide-hero__nav-label text-xs font-bold uppercase tracking-widest">{isEnglish ? "Sections" : "Sadaļas"}</p>
					<ul class="building-guide-hero__nav-list" role="list">
						{sectionNav.map((item, index) => (
							<li>
								<a href={item.href} class="text-sm leading-relaxed">
									<span class="building-guide-number building-guide-hero__nav-index text-xs font-bold uppercase tracking-widest">
										{String(index + 1).padStart(2, "0")}
									</span>
									<span>{item.label}</span>
									<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
										<path
											d="M1.75 8h9.5"
											fill="none"
											stroke="currentColor"
											stroke-width="1.25"
											stroke-linecap="square"
										></path>
										<path
											d="M7.75 3.75 12 8l-4.25 4.25"
											fill="none"
											stroke="currentColor"
											stroke-width="1.25"
											stroke-linecap="square"
											stroke-linejoin="miter"
										></path>
									</svg>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</section>

		<section class="building-guide-split building-guide-split--light" id="overview">
			<div class="building-guide-shell building-guide-split__layout">
				<div class="building-guide-split__media fade-in">
					<figure class="building-guide-split__frame gold-frame">
						<img
							src="/images/interior-kitchen-dining.jpeg"
							alt={isEnglish ? "Bright AmberHome kitchen and living area" : "AmberHome dzīvokļa gaišā virtuve un dzīvojamā zona"}
							loading="lazy"
							decoding="async"
						/>
					</figure>
				</div>

				<div class="building-guide-split__content fade-in" data-reveal-delay="80">
					<p class="building-guide-eyebrow text-xs font-bold uppercase tracking-widest">{isEnglish ? "AmberHome, Talsu Street 3A" : "AmberHome Talsu iela 3A"}</p>
					<h2 class="building-guide-section-title mb-6 text-4xl font-semibold leading-none tracking-tight sm:mb-8 sm:text-5xl lg:text-6xl">
						{isEnglish ? "A home designed for sustainable everyday living." : "Mājoklis, kas veidots ilgtspējīgai ikdienai."}
					</h2>
					<div class="building-guide-copy mt-6 text-base leading-relaxed sm:mt-8">
						<p>
							{isEnglish ? "The three, four and five-room layouts are designed so everyone can find an apartment suited to their needs." : "Gan 3, gan 4 un 5 istabu plānojumi veidoti tā, lai ikviens varētu atrast savām vajadzībām piemērotu dzīvokli."}
						</p>
						<p>
							{isEnglish ? "The building combines thermal performance, sound insulation, individual utility metering and fresh air in every apartment." : "Ēkas risinājumi apvieno siltumnoturību, skaņas izolāciju, individuālu patēriņa uzskaiti un svaigu gaisu katrā dzīvoklī."}
						</p>
					</div>

					<div class="building-guide-specs building-guide-specs--light">
						{overviewSpecs.map((item) => (
							<div class="building-guide-specs__row">
								<p class="text-sm leading-relaxed">{item.label}</p>
								<p class="text-base leading-relaxed">{item.value}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="building-guide-process" id="construction">
			<div class="building-guide-shell building-guide-process__layout">
				<div class="building-guide-process__intro">
					<div class="building-guide-process__intro-inner fade-in">
						<p class="building-guide-eyebrow text-xs font-bold uppercase tracking-widest">{isEnglish ? "Construction" : "Konstrukcijas"}</p>
						<h2 class="building-guide-section-title text-4xl font-semibold leading-none tracking-tight sm:text-5xl lg:text-6xl">
							{isEnglish ? "Considered from the foundations to the roof." : "Pārdomāts no pamatiem līdz jumtam."}
						</h2>
						<div class="building-guide-copy text-base leading-relaxed">
							<p>{isEnglish ? "Durable materials and carefully selected insulation provide comfort throughout the year." : "Ilgmūžīgi materiāli un rūpīgi izvēlēti siltinājuma risinājumi nodrošina komfortu visos gadalaikos."}</p>
						</div>
					</div>
				</div>

				<div class="building-guide-process__list">
					{constructionItems.map((item, index) => (
						<article class="building-guide-step fade-in" data-reveal-delay={80 + index * 55}>
							<div class="building-guide-step__meta">
								<p class="building-guide-number building-guide-step__number text-xs font-bold uppercase tracking-widest">
									{String(index + 1).padStart(2, "0")}
								</p>
								<div class="building-guide-step__content">
									<h3 class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{item.title}</h3>
									<div class="building-guide-copy text-base leading-relaxed">
										<p>{item.body}</p>
									</div>
									<p class="building-guide-step__note text-sm leading-relaxed">{item.note}</p>
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="building-guide-split building-guide-split--light" id="systems">
			<div class="building-guide-shell">
				<div class="building-guide-split__content building-guide-split__content--wide fade-in">
					<p class="building-guide-eyebrow text-xs font-bold uppercase tracking-widest">{isEnglish ? "Utilities" : "Inženiertīkli"}</p>
					<h2 class="building-guide-section-title mb-6 text-4xl font-semibold leading-none tracking-tight sm:mb-8 sm:text-5xl lg:text-6xl">
						{isEnglish ? "Systems designed around your comfort." : "Sistēmas, kas strādā Tavam komfortam."}
					</h2>
					<div class="building-guide-copy mt-6 text-base leading-relaxed sm:mt-8">
						<p>
							{isEnglish ? "Each apartment has individually metered and adjustable systems for convenient everyday use." : "Katrs dzīvoklis aprīkots ar individuāli uzskaitāmām un regulējamām sistēmām ērtai ikdienas lietošanai."}
						</p>
					</div>

					<div class="building-guide-specs building-guide-specs--light">
						{utilitySections.map((section) => (
							<div class="building-guide-specs__row" id={section.id}>
								<p class="text-sm leading-relaxed">
									<span class="building-guide-number building-guide-specs__number">{section.number}</span>
									{section.title}
								</p>
								<div class="building-guide-specs__details">
									<p class="text-base leading-relaxed">{section.lead}</p>
									<ul role="list">
										{section.items.map((item) => <li>{item}</li>)}
									</ul>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="building-guide-faq" id="comfort">
			<div class="building-guide-shell">
				<div class="building-guide-faq__intro">
					<div class="fade-in">
						<p class="building-guide-eyebrow text-xs font-bold uppercase tracking-widest">{isEnglish ? "Safety and comfort" : "Drošība un komforts"}</p>
						<h2 class="building-guide-section-title text-4xl font-semibold leading-none tracking-tight sm:text-5xl lg:text-6xl">
							{isEnglish ? "A well-kept setting for comfortable living." : "Sakārtota vide mājīgai ikdienai."}
						</h2>
					</div>

					<div class="building-guide-copy fade-in text-base leading-relaxed" data-reveal-delay="70">
						<p>{isEnglish ? "From secure access to EV charging and a landscaped courtyard." : "No drošas piekļuves līdz elektroauto uzlādei un labiekārtotam pagalmam."}</p>
					</div>
				</div>

				<div class="building-guide-faq__list">
					{comfortGroups.map((group, index) => (
						<details class="building-guide-faq__item fade-in" data-reveal-delay={110 + index * 55}>
							<summary class="text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
								<span>
									<span class="building-guide-number building-guide-faq__number">{String(index + 1).padStart(2, "0")}</span>
									{group.title}
								</span>
								<span class="building-guide-faq__icon" aria-hidden="true"></span>
							</summary>
