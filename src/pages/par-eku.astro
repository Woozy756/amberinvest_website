									{group.items.map((item) => <li>{item}</li>)}
								</ul>
							</div>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="contact-section" aria-labelledby="contact-section-title" id="consultation">
			<div class="contact-section__container">
				<div class="contact-section__layout">
					<div class="contact-section__content">
						<p class="contact-section__eyebrow fade-in">{isEnglish ? "Get in touch" : "Piesakieties"}</p>
						<h2 id="contact-section-title" class="contact-section__title fade-in" data-reveal-delay="70">
							{isEnglish ? "Leave your contact details" : "Atstāj savus kontaktus"}
						</h2>
						<div class="contact-section__lead fade-in" data-reveal-delay="130">
							<p>{isEnglish ? "Leave your contact details and we will get in touch to arrange a viewing at a convenient time." : "Atstāj savu kontaktinformāciju, un mēs sazināsimies, lai vienotos par apskati Tev ērtā laikā."}</p>
						</div>

						<ul class="contact-section__benefits" role="list">
							<li class="contact-section__benefit fade-in" data-reveal-delay="190">
								<span class="contact-section__check" aria-hidden="true">
