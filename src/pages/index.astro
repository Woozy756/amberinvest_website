---
import HeroAvailability from "../components/home/HeroAvailability.astro";
import ProjectHighlights from "../components/home/ProjectHighlights.astro";
import EditorialGallery from "../components/home/EditorialGallery.astro";
import ProjectLocation from "../components/home/ProjectLocation.astro";
import ContactSection from "../components/home/ContactSection.astro";
import Layout from '../layouts/Layout.astro';
import { getMessages, type Locale } from "../i18n/translations";
import { loadHomepage } from "../sanity/homepage";
import { getAllProperties, type Property } from "../sanity/properties";

const locale = (Astro.props.locale ?? "lv") as Locale;
const isEnglish = locale === "en";
const messages = getMessages(locale);
const featuredPropertySlugs = [
	"talsu-3a-dzivoklis-nr4",
	"talsu-3a-dzivoklis-nr10",
	"talsu-3a-dzivoklis-nr6"
];
const [homepage, allProperties] = await Promise.all([loadHomepage(), getAllProperties()]);
const featuredProperties = featuredPropertySlugs
	.map((slug) => allProperties.find((property) => property.slug === slug))
	.filter((property): property is Property => Boolean(property));
---

<Layout
	title={isEnglish ? messages.home.title : homepage?.seo?.metaTitle || messages.home.title}
	description={isEnglish ? messages.home.heroLead : homepage?.seo?.metaDescription || homepage?.hero.heroLead || messages.home.heroLead}
	canonicalPath={isEnglish ? "/en" : "/"}
	ogImageUrl={homepage?.seo?.ogImage?.src || homepage?.hero.heroBackgroundImage?.asset?.url}
	ogImageAlt={isEnglish ? "AmberHome apartment building at Talsu Street 3A" : homepage?.seo?.ogImage?.alt || homepage?.hero.heroBackgroundImage?.alt || messages.home.heroTitle}
	noIndex={homepage?.seo?.noIndex}
	overlayHeader={true}
	footerTone="light"
	locale={locale}
>
		<main>
			<HeroAvailability content={homepage?.hero} locale={locale} />
			<ProjectHighlights locale={locale} content={homepage?.highlights} featuredProperties={featuredProperties} />
			<EditorialGallery content={homepage?.editorial} locale={locale} />
			<ProjectLocation locale={locale} />
		<ContactSection content={homepage?.contact} locale={locale} />
	</main>
</Layout>
