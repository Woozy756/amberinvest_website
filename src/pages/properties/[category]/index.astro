---
import PropertiesCatalogView from "../../../components/properties/PropertiesCatalogView.astro";
import {
	getPropertyCategoryHref,
	getPropertiesByCategory,
	getPropertyCategories,
	type PropertyCategory
} from "../../../sanity/properties";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
	const categories = await getPropertyCategories();

	return categories.map((category) => ({
		params: { category: category.slug },
		props: { category }
	}));
}

interface Props {
	category: PropertyCategory;
}

const locale = "lv";
const { category } = Astro.props as Props;

const [properties, categories] = await Promise.all([
	getPropertiesByCategory(category.slug),
	getPropertyCategories()
]);
---

<Layout
	title={category.seo?.metaTitle || `Amberinvest | ${category.label}`}
	description={category.seo?.metaDescription || category.description}
	canonicalPath={getPropertyCategoryHref(category)}
	ogImageUrl={category.seo?.ogImage?.src}
	ogImageAlt={category.seo?.ogImage?.alt}
	noIndex={category.seo?.noIndex}
	locale={locale}
>
	<PropertiesCatalogView
		title={category.label}
		lead={category.description}
		properties={properties}
		categories={categories}
		activeCategory={category.slug}
	/>
</Layout>
