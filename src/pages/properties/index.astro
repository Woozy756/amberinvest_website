---
import PropertiesCatalogView from "../../components/properties/PropertiesCatalogView.astro";
import { getAllProperties, getPropertyCategories } from "../../sanity/properties";
import Layout from "../../layouts/Layout.astro";

const locale = "lv";
const [properties, categories] = await Promise.all([getAllProperties(), getPropertyCategories()]);
---

<Layout
	title="Amberinvest | Dzīvokļi"
	description='Apskati dzīvokļus no "AmberHome" projekta un atrodi savām vajadzībām piemērotāko mājokli.'
	canonicalPath="/properties"
	locale={locale}
>
	<PropertiesCatalogView
		title="Visi dzīvokļi"
		lead='Apskati dzīvokļus no "AmberHome" projekta un atrodi savām vajadzībām piemērotāko mājokli.'
		properties={properties}
		categories={categories}
		activeCategory="all"
	/>
</Layout>
