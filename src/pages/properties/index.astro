---
import PropertiesCatalogView from "../../components/properties/PropertiesCatalogView.astro";
import { getAllProperties, getPropertyCategories } from "../../sanity/properties";
import Layout from "../../layouts/Layout.astro";

const locale = "lv";
const [properties, categories] = await Promise.all([getAllProperties(), getPropertyCategories()]);
const catalogLead = "Apskati pieejamos dzīvokļus Talsu ielā 3A un atrodi mājokli, kas atbilst Tavām ikdienas vajadzībām un budžetam.";
---

<Layout
	title="Amberinvest | Dzīvokļi"
	description={catalogLead}
	canonicalPath="/properties"
	footerTone="dark"
	locale={locale}
>
	<PropertiesCatalogView
		title="Visi dzīvokļi"
		lead={catalogLead}
		properties={properties}
		categories={categories}
		activeCategory="all"
	/>
</Layout>
