---
import { getMessages, type Locale } from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import { loadAboutPage } from "../sanity/aboutPage";

const locale = (Astro.props.locale ?? "lv") as Locale;
const isEnglish = locale === "en";
const messages = getMessages(locale);
const content = await loadAboutPage();
if (!content) {
	throw new Error("About Us Page content is missing in Sanity.");
}

const aboutCopy = isEnglish ? {
	introEyebrow: "About us",
	introTitle: "SIA REO is a trusted partner on your journey to a new home in Ventspils.",
	introParagraphs: [
		"The AmberHome project at Talsu Street 3A is designed for people who want a clear and secure path to owning an apartment. We help you compare layouts, understand prices, view apartments and make an informed decision without unnecessary pressure.",
		"We stay by your side throughout the process, from the first conversation and viewing to reservation, financing and completion of the purchase. Every step is explained clearly, so you always know what is happening now and what comes next.",
		"Honest communication, transparent terms and a positive buying experience matter to us. We listen to every client individually and help find the solution that truly fits."
	],
	valuesTitle: "The values that guide the way we work with you.",
	values: [
		"Clear and honest communication",
		"An individual approach to every buyer",
		"Quality homes for everyday living",
		"A secure and understandable purchase process"
	]
} : {
	introEyebrow: "Par mums",
	introTitle: "SIA REO ir uzticams partneris Jūsu jaunajām mājām Ventspilī.",
	introParagraphs: [
		"AmberHome projekts Talsu ielā 3A ir radīts cilvēkiem, kuri vēlas saprotamu un drošu ceļu līdz savam dzīvoklim. Mēs palīdzam Jums izvērtēt plānojumus, saprast cenas, apskatīt dzīvokļus un pieņemt lēmumu bez liekas steigas.",
		"Mūsu uzdevums ir būt blakus visā procesā: no pirmās sarunas un apskates līdz rezervācijai, finansējuma jautājumiem un darījuma noslēgšanai. Mēs skaidri izstāstām katru soli, lai Jūs zinātu, kas notiek tagad un kas sekos tālāk.",
		"Mums ir svarīga godīga komunikācija, pārskatāmi nosacījumi un sajūta, ka mājokļa izvēle ir patīkams, nevis sarežģīts process. Tāpēc katru klientu uzklausām individuāli un palīdzam atrast risinājumu, kas der tieši Jums."
	],
	valuesTitle: "Mūsu pamata vērtības, uz kurām balstām sadarbību ar Jums.",
	values: [
		"Saprotama un godīga komunikācija",
		"Individuāla pieeja katram pircējam",
		"Kvalitatīvi mājokļi Jūsu ikdienas dzīvei",
		"Drošs un saprotams mājokļa iegādes process"
	]
};
---

<Layout
	title={isEnglish ? messages.pages.aboutUs : content.seo?.metaTitle || content.title || messages.pages.aboutUs}
	description={isEnglish ? aboutCopy.introParagraphs[0] : content.seo?.metaDescription || aboutCopy.introParagraphs[0]}
	canonicalPath={isEnglish ? "/en/about-us" : "/par-mums"}
	ogImageUrl={content.seo?.ogImage?.src}
	ogImageAlt={isEnglish ? "About AmberHome" : content.seo?.ogImage?.alt}
	noIndex={content.seo?.noIndex}
	footerTone="light"
	locale={locale}
>
	<main class="about-page">
		<section class="about-section about-section--intro">
			<div class="about-shell">
				<div class="about-header fade-in">
					<p class="text-xs font-bold uppercase tracking-[0.22em] text-[var(--accent-primary)]">{aboutCopy.introEyebrow}</p>
					<h1 class="text-4xl font-semibold leading-tight tracking-tight text-[var(--bg-primary)] sm:text-5xl lg:text-6xl">
						{aboutCopy.introTitle}
					</h1>
				</div>

				<div class="about-copy fade-in" data-reveal-delay="80">
					{aboutCopy.introParagraphs.map((paragraph) => (
						<p class="text-base leading-relaxed text-[rgba(15,17,21,0.78)] sm:text-lg">{paragraph}</p>
					))}
				</div>
			</div>
		</section>

		<section class="about-section about-section--values">
			<div class="about-shell">
				<div class="about-section-head fade-in">
					<h2 class="text-3xl font-semibold leading-tight tracking-tight text-[var(--bg-primary)] sm:text-4xl lg:text-5xl">
						{aboutCopy.valuesTitle}
					</h2>
				</div>

				<ul class="about-values-list" role="list">
					{
						aboutCopy.values.map((value, index) => (
							<li class="about-value fade-in" data-reveal-delay={String(70 + index * 45)}>
								<span class="text-xl font-semibold leading-tight tracking-tight text-[var(--bg-primary)] sm:text-2xl">
									{value}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>

	</main>
</Layout>

<style>
	.about-page {
		background: #f7f4ee;
		color: var(--bg-primary);
	}

	.about-shell {
		width: min(100%, var(--page-max-width));
		margin: 0 auto;
		padding: 0 var(--page-gutter);
	}

	.about-section {
		padding: var(--section-space) 0;
		background: #f7f4ee;
	}

	.about-section--intro {
		padding-top: calc(var(--header-height, 5.25rem) + var(--section-space-compact));
		padding-bottom: var(--section-space-compact);
	}

	.about-section--values {
		padding-top: 0;
	}

	.about-header {
		display: grid;
		gap: 1rem;
		max-width: 56rem;
	}

	.about-header h1,
	.about-section-head h2 {
		font-family: var(--font-heading);
		margin: 0;
		text-wrap: balance;
	}

	.about-copy {
		margin-top: clamp(1.5rem, 3vw, 2.25rem);
		display: grid;
		gap: var(--copy-stack-gap);
		max-width: 60rem;
		color: rgba(15, 17, 21, 0.68);
		line-height: var(--copy-line-height);
	}

	.about-copy p {
		margin: 0;
	}

	.about-section-head {
		display: grid;
		gap: 0.9rem;
		max-width: 48rem;
	}

	.about-values-list {
		list-style: none;
		margin: clamp(1.8rem, 4vw, 2.5rem) 0 0;
		padding: 0;
		border-top: 1px solid rgba(35, 38, 43, 0.14);
	}

	.about-value {
		padding: 1.2rem 0;
		border-bottom: 1px solid rgba(35, 38, 43, 0.14);
		line-height: 1.5;
	}

</style>
