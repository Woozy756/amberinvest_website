---
import Layout from '../layouts/Layout.astro';
import ContactForm from "../components/home/ContactForm.jsx";
import { loadContactPage } from "../sanity/contactPage";

const locale = "lv";
const content = await loadContactPage();

if (!content) {
	throw new Error("Contact Page content is missing in Sanity.");
}

const pageCopy = {
	title: "Kontakti",
	formEyebrow: "Piesakieties",
	formTitle: "Atstāj savus kontaktus",
	formLead: "Atstāj savu kontaktinformāciju, un mēs sazināsimies, lai vienotos par apskati Tev ērtā laikā.",
	formCardTitle: "Atstāj savus kontaktus",
	formCardIntro: "",
	defaultInformation: "Vēlos pieteikties dzīvokļa apskatei.",
	submitLabel: "Pieteikties apskatei"
};
---

<Layout
	title={content.seo?.metaTitle || pageCopy.title}
	description={content.seo?.metaDescription || pageCopy.formLead}
	canonicalPath="/contact"
	ogImageUrl={content.seo?.ogImage?.src}
	ogImageAlt={content.seo?.ogImage?.alt}
	noIndex={content.seo?.noIndex}
	footerTone="light"
	locale={locale}
>
	<main class="contact-page">
		<section class="contact-section contact-section--light contact-section--consultation contact-section--first" id="contact-form">
			<div class="contact-shell">
				<div class="contact-consultation">
					<div class="contact-consultation__copy">
						<p class="fade-in text-xs font-bold uppercase tracking-[0.22em] text-[var(--accent-primary)]">
							{pageCopy.formEyebrow}
						</p>
						<h2
							class="fade-in text-3xl font-semibold leading-tight tracking-tight text-[var(--bg-primary)] sm:text-4xl lg:text-5xl"
							data-reveal-delay="70"
						>
							{pageCopy.formTitle}
						</h2>
						<p
							class="fade-in text-base leading-relaxed text-[rgba(15,17,21,0.74)] sm:text-lg"
							data-reveal-delay="140"
						>
							{pageCopy.formLead}
						</p>
					</div>

					<div class="contact-consultation__form fade-in" data-reveal-delay="180">
						<div class="contact-consultation__card contact-form-card">
							<ContactForm
								client:idle
								title={pageCopy.formCardTitle}
								intro={pageCopy.formCardIntro}
								defaultInformation={pageCopy.defaultInformation}
								submitLabel={pageCopy.submitLabel}
							/>
						</div>
					</div>
				</div>

			</div>
		</section>
	</main>
</Layout>

<style>
	.contact-page {
		background: #f7f4ee;
		color: var(--bg-primary);
	}

	.contact-shell {
		width: min(100%, 1280px);
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 4vw, 3rem);
	}

	.contact-section {
		padding: clamp(4.5rem, 8vw, 7rem) 0;
	}

	.contact-section--light {
		background: #f7f4ee;
	}

	.contact-section--first {
		padding-top: calc(var(--header-height, 5.25rem) + clamp(2.5rem, 5vw, 4rem));
	}

	.contact-consultation {
		display: grid;
		gap: clamp(1.8rem, 4vw, 3rem);
	}

	.contact-consultation__copy {
		display: grid;
		gap: 1rem;
	}

	.contact-consultation__copy h2 {
		font-family: var(--font-heading);
		margin: 0;
		max-width: 14ch;
		text-wrap: balance;
	}

	.contact-consultation__copy p {
		margin: 0;
		max-width: 40rem;
	}

	.contact-section--consultation {
		padding-top: 0;
	}

	.contact-consultation {
		grid-template-columns: minmax(0, 0.72fr) minmax(20rem, 1fr);
		align-items: start;
	}

	@media (max-width: 1080px) {
		.contact-consultation {
			grid-template-columns: 1fr;
		}

		.contact-consultation__copy h2 {
			max-width: 16ch;
		}
	}
</style>
